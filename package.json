{
  "name": "logomedo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "LogoMedo — slikovni materijali za logopede, katalog slika po glasovima",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler deploy",
    "types": "wrangler types",
    "check": "astro check",
    "test": "node --import ./src/lib/test/registracija.ts --test 'src/**/*.test.ts'",
    "db:migrate": "CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler d1 migrations apply logomedo --remote",
    "db:migrate:local": "wrangler d1 migrations apply logomedo --local",
    "seed": "node scripts/seed-katalog.ts ../preuzimanje/data/catalog.csv > seed/katalog.sql",
    "seed:local": "wrangler d1 execute logomedo --local --file seed/katalog.sql",
    "build:staging": "sh scripts/staging-build.sh",
    "deploy:staging": "npm run build:staging && CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler deploy --config dist-staging/server/wrangler.json",
    "db:migrate:staging": "CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4 wrangler d1 migrations apply logomedo-staging --remote --config wrangler.jsonc --env staging",
    "landing:snimke": "node scripts/landing-snimke.ts",
    "emails": "tsx --tsconfig emails/tsconfig.json scripts/emails-export.tsx",
    "emails:dev": "email dev --dir emails --port 3030"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/server": "^14.0.3",
    "astro": "^7.4.4",
    "jose": "^6.2.14",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@react-email/components": "^1.0.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "playwright-core": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.16",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  }
}
