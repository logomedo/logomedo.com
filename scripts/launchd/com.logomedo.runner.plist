<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runner slika (produkcija) kao LaunchAgent. Instalacija: scripts/launchd/instaliraj.sh -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.logomedo.runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__KORIJEN__/scripts/runner.sh</string>
    <string>--prod</string>
  </array>
  <key>WorkingDirectory</key><string>__KORIJEN__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Pad (npr. agy nije prijavljen) ne smije vrtjeti petlju: najviše jedno pokretanje u minuti. -->
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/logomedo-runner.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/logomedo-runner.log</string>
</dict>
</plist>
