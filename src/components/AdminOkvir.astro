---
// Okvir admina: bočna traka po području (lib/admin/navigacija.ts: Sadržaj ili Uprava, docs/uprava/plan.md) i glavni dio.
// Bez sesije baca (500) umjesto da prikaže stranicu, osim na prijavi (`javno`):
// druga obrana ako middleware neku admin putanju ne prepozna.
import Tema from "./Tema.astro";
import Marka from "./Marka.astro";
import Ikona from "./Ikona.astro";
import type { ComponentProps } from "astro/types";
import { env } from "cloudflare:workers";
import { smijeNa } from "../lib/admin/rute";
import { TRAKE, type Aktivno, type Brojac, type Podrucje, type Stavka, type Traka } from "../lib/admin/navigacija";
import { pregledFiltar } from "../lib/admin/vlasnistvo";
import { ZATRAZIO_SLIKE, ZATRAZIO_ZVUKA } from "../lib/zatrazio";
import { brojNovih } from "../lib/admin/zahtjevi";
import { brojNeprocitanih } from "../lib/poruke";
import { kvotaIzAdrese, porukaZaKorisnika, preostalo, type StanjeKvote, type VrstaKvote } from "../lib/kvota";

interface Props { naslov: string; javno?: boolean; aktivno?: Aktivno; puno?: boolean; podrucje?: Podrucje }
const { naslov, javno = false, aktivno, puno = false, podrucje = "sadrzaj" } = Astro.props;
const admin = Astro.locals.admin;
if (!admin && !javno) throw new Error("Admin stranica bez sesije");
/** Odbijen zahtjev zbog AI kvote (middleware, lib/kvota.ts: 303 natrag s `?kvota=<vrsta>`): tekst se gradi ovdje, ne čita iz adrese. */
const kvotaUAdresi = admin ? kvotaIzAdrese(Astro.url.searchParams) : null;
const kvota = admin && kvotaUAdresi ? await porukaZaKorisnika(admin.email, kvotaUAdresi) : null;

let brojevi = { kandidata: 0, uRedu: 0, gresaka: 0, zvukova: 0 };
if (admin && podrucje === "sadrzaj") {
  // Za pregled (Slike, Izgovor) logoped broji samo ono što je sam poslao, kao na tim stranicama.
  const vidi = pregledFiltar(admin);
  brojevi = (await env.DB.prepare(
    `SELECT (SELECT COUNT(*) FROM slike s WHERE s.status = 'kandidat' AND (?1 IS NULL OR ${ZATRAZIO_SLIKE} = ?1)
         AND (?2 = 0 OR s.predlozio IS NULL)) AS kandidata,
       (SELECT COUNT(*) FROM generiranja WHERE status IN ('ceka','radi')) AS uRedu,
       (SELECT COUNT(*) FROM generiranja WHERE status = 'greska') AS gresaka,
       (SELECT COUNT(DISTINCT z.kljuc) FROM zvukovi z WHERE z.status = 'kandidat' AND (?1 IS NULL OR ${ZATRAZIO_ZVUKA} = ?1)) AS zvukova`,
  ).bind(vidi, admin.uloga === "superadmin" ? 0 : 1).first<typeof brojevi>()) ?? brojevi;
}
// Novi zahtjevi za pristup (/pristup) i nepročitane poruke (inbox): samo superadmin; u Sadržaju zbroj na gumbu „Uprava”.
const zahtjeva = admin?.uloga === "superadmin" ? await brojNovih() : 0;
const neprocitanih = admin?.uloga === "superadmin" ? await brojNeprocitanih() : 0;
// Logoped vidi koliko mu je AI kredita ostalo (lib/kvota.ts); superadmin je bez limita, pa ništa.
const kvotaStanje: Record<VrstaKvote, StanjeKvote> | null =
  admin?.uloga === "logoped" && admin.korisnikId !== null ? await preostalo(admin.korisnikId) : null;

const BROJ: Record<Brojac, number> = {
  kandidata: brojevi.kandidata, zvukova: brojevi.zvukova, red: brojevi.uRedu + brojevi.gresaka,
  zahtjeva, poruka: neprocitanih, uprava: zahtjeva + neprocitanih,
};
type Prikaz = { kod: string; href: string; tekst: string; ikona: ComponentProps<typeof Ikona>["ime"]; broj: number; greska?: boolean };
const prikazi = (s: Stavka): Prikaz => ({
  kod: s.kod, href: s.href, ikona: s.ikona as Prikaz["ikona"], broj: s.brojac ? BROJ[s.brojac] : 0,
  tekst: s.kod === "red" && brojevi.gresaka ? "Red (greške)" : s.tekst,
  greska: s.kod === "red" && brojevi.gresaka > 0,
});
// Stavke koje uloga ne smije se ne prikazuju (server ih ionako odbija, lib/admin/rute.ts).
const vidljivo = (s: Stavka) => !!admin && smijeNa(admin.uloga, s.href);
const traka: Traka = TRAKE[podrucje];
const skupine = traka.skupine.map((g) => ({ ...g, stavke: g.stavke.filter(vidljivo).map(prikazi) })).filter((g) => g.stavke.length);
const alati = traka.alati.filter(vidljivo).map(prikazi);
const dno = traka.dno.filter(vidljivo).map(prikazi);
const uprava = podrucje === "uprava";
const pocetna = uprava ? "/admin/uprava" : "/admin";
const oznaka = uprava ? "uprava" : "admin";
---
<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{naslov} · LogoMedo admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Tema />
    <script is:inline>
      // Sklopljena bočna traka (samo širi ekrani): izbor u localStorage, postavlja se prije crtanja da ne trepne.
      try { if (localStorage.getItem("logomedo-traka") === "uska") document.documentElement.dataset.traka = "uska"; } catch {}
    </script>
  </head>
  <body class:list={{ "s-trakom": !!admin, uprava }}>
    {admin && (
      <header class="mob-vrh">
        <button type="button" class="ikona-gumb hamburger" aria-label="Otvori izbornik" aria-controls="traka" aria-expanded="false">
          <Ikona ime="izbornik" />
          {[...skupine.flatMap((g) => g.stavke), ...alati, ...dno].some((s) => s.broj > 0) && <span class="hamburger-tocka"></span>}
        </button>
        <Marka href={pocetna} dodatak={oznaka} />
        {uprava ? <span></span> : <button type="button" class="ikona-gumb mob-trazi" aria-label="Traži riječ"><Ikona ime="trazi" /></button>}
      </header>
      <div class="zastor" aria-hidden="true"></div>
    )}
    {admin && (
      <aside class="traka" id="traka">
        <div class="vrh">
          <Marka href={pocetna} dodatak={oznaka} />
          <button type="button" class="ikona-gumb sklopi" aria-label="Sklopi / proširi izbornik" title="Sklopi / proširi izbornik  [" aria-expanded="true"><Ikona ime="traka" /></button>
          <button type="button" class="ikona-gumb zatvori" aria-label="Zatvori izbornik"><Ikona ime="x" /></button>
        </div>
        {!uprava && (
          <>
        <button type="button" class="ikona-gumb trazi-gumb" aria-label="Traži riječ" title="Traži riječ  /"><Ikona ime="trazi" /></button>
        <div class="trazilica" role="search">
          <input type="search" id="trazi" placeholder="Traži riječ…  /" autocomplete="off" spellcheck="false"
            aria-label="Traži riječ u katalogu" aria-controls="trazi-rezultati" aria-expanded="false" />
          <ul id="trazi-rezultati" role="listbox" hidden></ul>
        </div>
          </>
        )}
        <nav aria-label="Izbornik">
          {uprava && (
            <a href="/admin/uprava" class:list={["stavka", "pregled-uprave", { aktivno: aktivno === "pregled-uprave" }]} aria-current={aktivno === "pregled-uprave" ? "page" : undefined} title="Pregled">
              <Ikona ime="ploca" /><span>Pregled</span>
            </a>
          )}
          {skupine.map((g) => (
            <section class="skupina" aria-label={g.naslov}>
              <h2 class="skupina-naslov"><span style={`background:${g.boja}`}></span>{g.naslov}</h2>
              {g.stavke.map((s) => (
                <a href={s.href} class:list={["stavka", { aktivno: aktivno === s.kod }]} aria-current={aktivno === s.kod ? "page" : undefined} title={s.tekst}>
                  <Ikona ime={s.ikona} />
                  <span>{s.tekst}</span>
                  {s.broj > 0 && <span class="broj">{s.broj}</span>}
                </a>
              ))}
            </section>
          ))}
          {alati.length > 0 && (
            <section class="skupina alati-skupina" aria-label="Alati">
              <h2 class="skupina-naslov">Alati</h2>
              {alati.map((s) => (
                <a href={s.href} class:list={["stavka", { aktivno: aktivno === s.kod }]} aria-current={aktivno === s.kod ? "page" : undefined} title={s.tekst}>
                  <Ikona ime={s.ikona} />
                  <span>{s.tekst}</span>
                  {s.broj > 0 && <span class:list={["broj", { greska: s.greska }]}>{s.broj}</span>}
                </a>
              ))}
            </section>
          )}
          <section class="skupina sustav" aria-label={uprava ? "Natrag i postavke" : "Uprava i postavke"}>
            {dno.map((s) => (
              <a href={s.href} class:list={["stavka", { aktivno: aktivno === s.kod, prijelaz: s.kod === "uprava" || s.kod === "sadrzaj" }]} aria-current={aktivno === s.kod ? "page" : undefined} title={s.tekst}>
                <Ikona ime={s.ikona} />
                <span>{s.tekst}</span>
                {s.broj > 0 && <span class="broj">{s.broj}</span>}
                {s.kod === "uprava" && <span class="strelica"><Ikona ime="naprijed" velicina={16} /></span>}
              </a>
            ))}
          </section>
        </nav>
        {kvotaStanje && (
          <div class="kvota-stanje" title="AI krediti: preostalo od tjednog limita (zadnjih 7 dana)">
            <span class="kvota-naslov">Preostalo (7 dana)</span>
            {([["slike", "Slike", "pregled"], ["zvukovi", "Izgovori", "zvuk"]] as const).map(([v, tekst, ikona]) => (
              <span class:list={["kvota-red", { nula: kvotaStanje[v].preostalo === 0 }]} data-vrsta={v}
                aria-label={`${tekst}: ostalo ${kvotaStanje[v].preostalo} od ${kvotaStanje[v].limit}`}>
                <Ikona ime={ikona} velicina={16} />
                <span class="kvota-tekst">{tekst}</span>
                <b>{kvotaStanje[v].preostalo}/{kvotaStanje[v].limit}</b>
              </span>
            ))}
          </div>
        )}
        <div class="dno">
          <div class="tko" title={`${admin.email} (${admin.uloga})`}>
            <span class="avatar">{admin.email[0].toUpperCase()}</span>
            <span class="tko-tekst">
              <span class="email">{admin.email}</span>
              <span class="uloga">{admin.uloga}</span>
            </span>
          </div>
          <div class="alati">
            <button type="button" class="ikona-gumb prekidac-teme" aria-label="Svijetlo / tamno" title="Svijetlo / tamno">
              <span class="samo-dan"><Ikona ime="mjesec" /></span><span class="samo-noc"><Ikona ime="sunce" /></span>
            </button>
            <form method="post" action="/admin/logout"><button class="ikona-gumb" type="submit" aria-label="Odjava" title="Odjava"><Ikona ime="odjava" /></button></form>
          </div>
        </div>
      </aside>
    )}
    <main class:list={["sadrzaj", { puno }]}>
      {kvota && <p class="kvota-poruka" role="alert">{kvota}</p>}
      <slot />
    </main>
    <script>
      // Uređaji (docs/uredaji.md): kad drugi uređaj preuzme račun, fetch ovdje dobiva 409 `x-uredaj: previse`.
      // Osvježavanje stranice pokaže „Nastavi ovdje” umjesto tihe greške u pozadinskom osvježavanju.
      {
        const izvorni = window.fetch.bind(window);
        let javljeno = false;
        window.fetch = async (...a: Parameters<typeof fetch>) => {
          const r = await izvorni(...a);
          if (r.status === 409 && r.headers.get("x-uredaj") === "previse" && !javljeno) {
            javljeno = true;
            location.reload();
          }
          return r;
        };
      }
    </script>
    <script>
      // Tražilica riječi: indeks se dohvati jednom (na prvi fokus), filtrira se lokalno.
      // Bez dijakritika (c = č/ć, dj = đ), prvo riječi koje počinju upitom.
      const ulaz = document.querySelector<HTMLInputElement>("#trazi");
      const lista = document.querySelector<HTMLUListElement>("#trazi-rezultati");
      if (ulaz && lista) {
        type R = { r: string; s: string; o: number; k: number; n?: string };
        const norm = (t: string) => t.toLocaleLowerCase("hr").replace(/đ/g, "dj").normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
        let indeks: R[] | null = null;
        let ucitava: Promise<void> | null = null;
        let odabran = 0;
        const ucitaj = () => (ucitava ??= fetch("/admin/api/trazi").then((r) => r.json() as Promise<R[]>).then((d) => {
          indeks = d.map((x) => ({ ...x, n: norm(x.r) }));
          if (ulaz.value) prikazi();
        }).catch(() => { ucitava = null; }));
        const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
        const prikazi = () => {
          const q = norm(ulaz.value);
          if (!q || !indeks) { lista.hidden = true; ulaz.setAttribute("aria-expanded", "false"); return; }
          const pocinje = indeks.filter((x) => x.n!.startsWith(q));
          const sadrzi = indeks.filter((x) => !x.n!.startsWith(q) && x.n!.includes(q));
          const nadeno = [...pocinje, ...sadrzi].slice(0, 12);
          odabran = 0;
          lista.innerHTML = nadeno.length
            ? nadeno.map((x, i) => `<li role="option" aria-selected="${i === 0}"><a href="/admin/rijec/${x.s}">
                <span class="tocka ${x.o ? "da" : x.k ? "kand" : ""}" title="${x.o ? "odobrena slika" : x.k ? x.k + " kandidata" : "nema slike"}"></span>
                <span>${esc(x.r)}</span></a></li>`).join("")
            : `<li role="option" aria-selected="true"><a href="/admin/nova-rijec?rijec=${encodeURIComponent(ulaz.value.trim())}" class="dodaj">
                <span class="tocka"></span><span>+ Dodaj „${esc(ulaz.value.trim())}”</span></a></li>`;
          lista.hidden = false;
          ulaz.setAttribute("aria-expanded", "true");
        };
        const oznaci = (i: number) => {
          const st = [...lista.querySelectorAll("li[role=option]")];
          if (!st.length) return;
          odabran = (i + st.length) % st.length;
          st.forEach((li, j) => li.setAttribute("aria-selected", String(j === odabran)));
          st[odabran].scrollIntoView({ block: "nearest" });
        };
        ulaz.addEventListener("focus", () => { ucitaj(); if (ulaz.value) prikazi(); });
        ulaz.addEventListener("input", () => { ucitaj(); prikazi(); });
        ulaz.addEventListener("keydown", (e) => {
          if (e.key === "ArrowDown") { e.preventDefault(); oznaci(odabran + 1); }
          else if (e.key === "ArrowUp") { e.preventDefault(); oznaci(odabran - 1); }
          else if (e.key === "Enter") {
            const a = lista.querySelectorAll<HTMLAnchorElement>("li[role=option] a")[odabran];
            if (a) { e.preventDefault(); location.href = a.href; }
          } else if (e.key === "Escape") { ulaz.value = ""; prikazi(); ulaz.blur(); }
        });
        ulaz.addEventListener("blur", () => setTimeout(() => { if (document.activeElement !== ulaz) lista.hidden = true; }, 150));
        document.addEventListener("keydown", (e) => {
          const t = e.target as HTMLElement;
          if (e.metaKey || e.ctrlKey || e.altKey || ["INPUT", "TEXTAREA", "SELECT"].includes(t.tagName) || t.isContentEditable) return;
          if (e.key === "/") { e.preventDefault(); postaviTraku(false); ulaz.focus(); ulaz.select(); }
          else if (e.key === "[") { e.preventDefault(); postaviTraku(!uska()); }
        });
        document.querySelector<HTMLButtonElement>(".trazi-gumb")?.addEventListener("click", () => { postaviTraku(false); ulaz.focus(); });
      }

      function uska() { return document.documentElement.dataset.traka === "uska"; }
      function postaviTraku(sklopi: boolean) {
        const h = document.documentElement;
        if (sklopi) h.dataset.traka = "uska"; else delete h.dataset.traka;
        try { localStorage.setItem("logomedo-traka", sklopi ? "uska" : "siroka"); } catch {}
        document.querySelector(".sklopi")?.setAttribute("aria-expanded", String(!sklopi));
      }
      const sklopiGumb = document.querySelector<HTMLButtonElement>(".sklopi");
      if (sklopiGumb) {
        sklopiGumb.setAttribute("aria-expanded", String(!uska()));
        sklopiGumb.addEventListener("click", () => postaviTraku(!uska()));
      }

      // Mobitel: bočna traka je ladica slijeva (hamburger u gornjoj traci), zastor i Esc je zatvaraju.
      const hamburger = document.querySelector<HTMLButtonElement>(".hamburger");
      function ladica(otvori: boolean) {
        const h = document.documentElement;
        if (otvori) h.dataset.izbornik = "otvoren"; else delete h.dataset.izbornik;
        hamburger?.setAttribute("aria-expanded", String(otvori));
        if (otvori) document.querySelector<HTMLElement>(".traka .stavka.aktivno")?.scrollIntoView({ block: "center", inline: "nearest" });
      }
      hamburger?.addEventListener("click", () => ladica(true));
      document.querySelector(".zastor")?.addEventListener("click", () => ladica(false));
      document.querySelector(".zatvori")?.addEventListener("click", () => ladica(false));
      document.querySelector(".mob-trazi")?.addEventListener("click", () => { ladica(true); document.querySelector<HTMLInputElement>("#trazi")?.focus({ preventScroll: true }); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && document.documentElement.dataset.izbornik) ladica(false); });
      matchMedia("(min-width: 861px)").addEventListener("change", (e) => { if (e.matches) ladica(false); });
      addEventListener("pageshow", () => ladica(false));

      for (const b of document.querySelectorAll<HTMLButtonElement>(".prekidac-teme")) {
        b.onclick = () => {
          const h = document.documentElement;
          const tamno = h.dataset.tema ? h.dataset.tema === "tamna" : matchMedia("(prefers-color-scheme: dark)").matches;
          h.dataset.tema = tamno ? "svijetla" : "tamna";
          try { localStorage.setItem("logomedo-tema", h.dataset.tema); } catch {}
        };
      }
    </script>
    <style is:global>
      body.s-trakom { display: grid; grid-template-columns: 236px 1fr; min-height: 100vh; }
      .traka { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 22px; padding: 22px 14px 16px;
        border-right: 1px solid var(--rub); background: var(--povrsina); }
      .traka .vrh { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 0 0 0 8px; }
      .traka .vrh .marka { min-width: 0; gap: 8px; }
      .traka .vrh .dodatak { display: none; } /* uloga piše dolje */
      .traka .vrh .sklopi { flex: none; }
      .traka .trazi-gumb { display: none; }
      .trazilica { position: relative; padding: 0 2px; }
      .trazilica input { width: 100%; font: inherit; font-size: .88rem; padding: 8px 11px; border: 1px solid var(--rub-jak); border-radius: 10px;
        background: var(--povrsina); color: var(--tinta); }
      .trazilica input:focus { outline: none; border-color: var(--med); box-shadow: 0 0 0 3px var(--med-blago); }
      #trazi-rezultati { position: absolute; z-index: 30; left: 2px; right: 2px; top: calc(100% + 4px); margin: 0; padding: 4px; list-style: none;
        max-height: 60vh; overflow-y: auto; background: var(--povrsina); border: 1px solid var(--rub-jak); border-radius: 12px; box-shadow: var(--sjena-2); }
      #trazi-rezultati a { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border-radius: 8px; text-decoration: none; color: var(--tinta);
        text-transform: uppercase; letter-spacing: .04em; font-weight: 650; font-size: .84rem; }
      #trazi-rezultati li[aria-selected=true] a, #trazi-rezultati a:hover { background: var(--med-blago); color: var(--med-tamno); }
      #trazi-rezultati a.dodaj { text-transform: none; letter-spacing: 0; color: var(--med-tamno); }
      #trazi-rezultati .nista { padding: 8px 10px; color: var(--blijedo); font-size: .84rem; }
      .tocka { flex: none; width: 8px; height: 8px; border-radius: 999px; background: var(--rub-jak); }
      .tocka.da { background: var(--uspjeh); } .tocka.kand { background: var(--med); }
      .traka nav { flex: 1; display: flex; flex-direction: column; gap: 10px; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
        scrollbar-width: thin; scrollbar-color: var(--rub-jak) transparent; margin: 0 -6px; padding: 0 6px 2px; }
      .traka nav > * { flex: none; }
      .skupina { display: flex; flex-direction: column; gap: 2px; padding: 6px 6px 6px; border-radius: 14px; background: var(--povrsina-2); border: 1px solid var(--rub); }
      .skupina-naslov { display: flex; align-items: center; gap: 8px; margin: 0; padding: 4px 8px 5px; font-size: .68rem; font-weight: 700;
        letter-spacing: .08em; text-transform: uppercase; color: var(--blijedo); }
      .skupina-naslov span { width: 8px; height: 8px; border-radius: 3px; }
      .skupina.sustav { margin-top: auto; background: none; border: 0; padding: 0; }
      .skupina.sustav .stavka { padding: 7px 10px; font-size: .9rem; }
      .stavka { display: flex; align-items: center; gap: 11px; padding: 9px 10px; border-radius: 10px; text-decoration: none;
        color: var(--blijedo); font-weight: 550; transition: background .15s, color .15s; }
      .stavka:hover { background: var(--povrsina); color: var(--tinta); }
      .stavka.aktivno { background: var(--povrsina); color: var(--med-tamno); font-weight: 650; box-shadow: var(--sjena-1), inset 3px 0 0 var(--med); }
      .skupina.sustav .stavka:hover, .skupina.sustav .stavka.aktivno { background: var(--povrsina-2); }
      /* Alati (Red, Prompt, Aktivnost) bez okvira skupine; prijelaz Sadržaj ↔ Uprava odvojen crtom iznad postavki. */
      .skupina.alati-skupina { background: none; border: 0; padding: 0 0 0; }
      .skupina.sustav .stavka.prijelaz { border: 1px solid var(--rub); background: var(--povrsina-2); margin-bottom: 4px; }
      .skupina.sustav .stavka.prijelaz:hover { border-color: var(--rub-jak); }
      .stavka .strelica { margin-left: auto; display: inline-flex; color: var(--blijedo); }
      .stavka .broj + .strelica { margin-left: 4px; }
      /* Uprava: drugi naglasak (plavi umjesto meda), da se odmah vidi gdje si. */
      body.uprava .traka { background: linear-gradient(var(--info-blago), var(--povrsina) 220px); }
      body.uprava .traka .stavka.aktivno { color: var(--info); box-shadow: var(--sjena-1), inset 3px 0 0 var(--info); }
      body.uprava .traka .marka .dodatak { color: var(--info); border-color: var(--info); }
      .stavka.pregled-uprave { margin-bottom: 2px; }
      body.uprava .traka .vrh .dodatak { display: inline; color: var(--info); border-color: var(--info); }
      .stavka .broj { margin-left: auto; min-width: 22px; padding: 0 7px; border-radius: 999px; background: var(--med); color: var(--med-tekst);
        font-size: .72rem; font-weight: 700; line-height: 20px; text-align: center; font-variant-numeric: tabular-nums; }
      .stavka .broj.greska { background: var(--greska); color: #fff; }
      .traka .dno { margin-top: auto; display: flex; align-items: center; gap: 8px; padding: 12px 6px 0; border-top: 1px solid var(--rub); }
      .tko { display: flex; align-items: center; gap: 9px; min-width: 0; flex: 1; }
      .avatar { flex: none; width: 30px; height: 30px; border-radius: 999px; display: grid; place-items: center; font-weight: 700; font-size: .8rem;
        background: var(--povrsina-2); color: var(--blijedo); border: 1px solid var(--rub); }
      .tko-tekst { display: flex; flex-direction: column; min-width: 0; }
      .email { font-size: .8rem; color: var(--blijedo); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .uloga { font-size: .7rem; color: var(--blijedo); text-transform: uppercase; letter-spacing: .08em; font-weight: 650; }
      .alati { display: flex; gap: 2px; }
      .alati form { margin: 0; }
      .ikona-gumb { width: 32px; height: 32px; display: inline-grid; place-items: center; border: 0; border-radius: 8px; background: none;
        color: var(--blijedo); cursor: pointer; }
      .ikona-gumb:hover { background: var(--povrsina-2); color: var(--tinta); }
      .sadrzaj { padding: 40px clamp(20px, 4vw, 56px) 80px; max-width: 1360px; width: 100%; }
      .kvota-poruka { margin: 0 0 16px; padding: 10px 14px; border-radius: 10px; background: var(--greska-blago); color: var(--greska); font-weight: 600; }
      .sadrzaj.puno { max-width: none; padding: 0; }
      .kvota-stanje { display: flex; flex-direction: column; gap: 2px; padding: 0 10px; font-size: .82rem; color: var(--blijedo); }
      .kvota-naslov { font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 2px; }
      .kvota-red { display: flex; align-items: center; gap: 8px; }
      .kvota-red b { margin-left: auto; color: var(--tinta); font-variant-numeric: tabular-nums; }
      .kvota-red.nula b { color: var(--greska); }

      /* Sklopljena traka: samo ikone, tekst u title. */
      @media (min-width: 861px) {
        html[data-traka=uska] body.s-trakom { grid-template-columns: 68px 1fr; }
        html[data-traka=uska] .traka { padding: 18px 8px 14px; gap: 14px; align-items: stretch; }
        html[data-traka=uska] .traka .vrh { flex-direction: column; gap: 10px; padding: 0; }
        html[data-traka=uska] .traka .vrh .ime, html[data-traka=uska] .traka .vrh .dodatak { display: none; }
        html[data-traka=uska] .trazilica { display: none; }
        html[data-traka=uska] .traka .trazi-gumb { display: inline-grid; align-self: center; }
        html[data-traka=uska] .skupina { padding: 4px; gap: 2px; }
        html[data-traka=uska] .skupina-naslov { display: none; }
        html[data-traka=uska] .stavka { position: relative; justify-content: center; padding: 9px 0; }
        html[data-traka=uska] .skupina.sustav .stavka { padding: 7px 0; }
        html[data-traka=uska] .stavka > span:not(.broj) { display: none; }
        html[data-traka=uska] .stavka .broj { position: absolute; top: 1px; right: 1px; min-width: 16px; padding: 0 4px; line-height: 16px; font-size: .62rem; }
        html[data-traka=uska] .kvota-stanje { padding: 0; align-items: center; font-size: .72rem; }
        html[data-traka=uska] .kvota-naslov, html[data-traka=uska] .kvota-tekst { display: none; }
        html[data-traka=uska] .kvota-red { gap: 3px; }
        html[data-traka=uska] .traka .dno { flex-direction: column; padding: 10px 0 0; }
        html[data-traka=uska] .tko { flex: none; }
        html[data-traka=uska] .tko-tekst { display: none; }
        html[data-traka=uska] .alati { flex-direction: column; }
      }

      /* Mobitel: gornja traka s hamburgerom, bočna traka kao ladica slijeva (izgled kao na desktopu, nav se scrolla). */
      .mob-vrh, .zastor, .traka .zatvori { display: none; }
      @media (max-width: 860px) {
        body.s-trakom { display: block; }
        .mob-vrh { display: flex; position: sticky; top: 0; z-index: 20; align-items: center; gap: 8px; padding: 8px 10px;
          padding-top: max(8px, env(safe-area-inset-top)); background: var(--povrsina); border-bottom: 1px solid var(--rub); }
        .mob-vrh .marka { flex: 1; min-width: 0; gap: 8px; }
        .mob-vrh .ikona-gumb { width: 40px; height: 40px; position: relative; color: var(--tinta); }
        .hamburger-tocka { position: absolute; top: 8px; right: 7px; width: 8px; height: 8px; border-radius: 999px; background: var(--med); }
        .sklopi, .trazi-gumb { display: none !important; }
        .traka .zatvori { display: inline-grid; flex: none; }
        .traka { position: fixed; z-index: 40; top: 0; left: 0; bottom: 0; height: 100dvh; gap: 18px;
          /* Bez vw: Chrome na Androidu zna izračunati 86vw kao ~0 (otvaranje tipkovnice, tab vraćen iz pozadine) pa ostane traka
             široka samo koliko padding. Fiksna širina s donjom granicom. */
          width: 300px; min-width: 260px; max-width: calc(100% - 48px); box-sizing: border-box;
          padding: max(16px, env(safe-area-inset-top)) 14px max(14px, env(safe-area-inset-bottom));
          transform: translateX(-102%); transition: transform .22s ease, visibility 0s .22s; box-shadow: var(--sjena-2); visibility: hidden; }
        html[data-izbornik=otvoren] .traka { transform: none; visibility: visible; transition-delay: 0s; }
        .zastor { display: block; position: fixed; inset: 0; z-index: 35; background: rgb(0 0 0 / .4); opacity: 0; pointer-events: none; transition: opacity .2s; }
        html[data-izbornik=otvoren] .zastor { opacity: 1; pointer-events: auto; }
        html[data-izbornik=otvoren] body { overflow: hidden; }
        .traka nav .stavka { padding: 11px 10px; }
        .sadrzaj { padding: 24px 16px 64px; }
      }
      @media (max-width: 860px) and (prefers-reduced-motion: reduce) { .traka, .zastor { transition: none; } }

      /* Zajednički elementi admina */
      .naslov { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; }
      .naslov h1 { margin: 0; font-family: var(--font-slova); font-weight: 600; font-size: clamp(1.9rem, 3vw, 2.5rem); letter-spacing: -.02em;
        line-height: 1.1; font-variation-settings: "SOFT" 50, "opsz" 96; }
      .podnaslov { margin: 6px 0 0; color: var(--blijedo); }
      .mrvice { display: inline-flex; align-items: center; gap: 4px; margin-bottom: 14px; color: var(--blijedo); text-decoration: none; font-size: .88rem; font-weight: 550; }
      .mrvice:hover { color: var(--tinta); }
      .gumb { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 0 16px; border-radius: 10px;
        border: 1px solid var(--rub-jak); background: var(--povrsina); color: var(--tinta); font: inherit; font-weight: 600; font-size: .92rem;
        cursor: pointer; text-decoration: none; box-shadow: var(--sjena-1); transition: transform .1s, box-shadow .15s, background .15s; white-space: nowrap; }
      .gumb:hover { box-shadow: var(--sjena-2); }
      .gumb:active { transform: translateY(1px); }
      .gumb.glavni { background: var(--med); border-color: var(--med); color: var(--med-tekst); }
      .gumb.tihi { background: none; box-shadow: none; border-color: transparent; color: var(--blijedo); }
      .gumb.tihi:hover { background: var(--povrsina-2); color: var(--tinta); }
      .gumb.mali { min-height: 32px; padding: 0 11px; font-size: .84rem; border-radius: 8px; }
      .gumb.opasno { color: var(--greska); }
      .gumb:disabled { opacity: .5; cursor: default; }
      .ploha { background: var(--povrsina); border: 1px solid var(--rub); border-radius: 16px; box-shadow: var(--sjena-1); }
      .oznaka { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; font-size: .72rem; font-weight: 650;
        background: var(--povrsina-2); color: var(--blijedo); white-space: nowrap; }
      .oznaka.uspjeh { background: var(--uspjeh-blago); color: var(--uspjeh); }
      .oznaka.med { background: var(--med-blago); color: var(--med-tamno); }
      .oznaka.info { background: var(--info-blago); color: var(--info); }
      .oznaka.greska { background: var(--greska-blago); color: var(--greska); }
      .obavijest { display: flex; gap: 10px; align-items: center; padding: 12px 16px; margin-bottom: 20px; border-radius: 12px;
        background: var(--med-blago); color: var(--med-tamno); font-weight: 550; }
      input[type=text], input[type=email], textarea { width: 100%; font: inherit; padding: 9px 12px; border: 1px solid var(--rub-jak); border-radius: 10px;
        background: var(--povrsina); color: var(--tinta); }
      input[type=text]:focus, input[type=email]:focus, textarea:focus { outline: none; border-color: var(--med); box-shadow: 0 0 0 3px var(--med-blago); }
      label { display: block; font-size: .8rem; font-weight: 650; color: var(--blijedo); margin: 0 0 6px; }
      .prazno { padding: 56px 24px; text-align: center; color: var(--blijedo); }
      .prazno h2 { margin: 0 0 6px; color: var(--tinta); font-family: var(--font-slova); font-weight: 600; }
      table { border-collapse: collapse; width: 100%; font-size: .9rem; }
      th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid var(--rub); vertical-align: middle; }
      th { color: var(--blijedo); font-weight: 600; font-size: .74rem; text-transform: uppercase; letter-spacing: .05em; }
      tr:last-child td { border-bottom: 0; }
      .mono { font-family: ui-monospace, "SF Mono", monospace; font-size: .82rem; }
      .blijedo { color: var(--blijedo); }
      .rijec-tekst { text-transform: uppercase; letter-spacing: .04em; font-weight: 700; }

    </style>
  </body>
</html>
