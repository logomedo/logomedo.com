---
// Snimka zaslona (V-…, sadrzaj.md odjeljak 4) u blagom „prozoru”. Na mobitelu (≤ 719 px) <source> daje uspravnu
// snimku 390×844 @2x gdje postoji, uska i centrirana. Tamna varijanta (V-6, V-15): obje slike u HTML-u, CSS
// prikaže onu koja odgovara temi, jer <picture media> ne prati ručni prekidač (data-tema). Skrivena lazy slika
// se ne preuzima. U heroju je svijetla bez lazy (iznad pregiba). `samoMobitel` (V-21): samo uspravna slika, uvijek uska.
import { SNIMKA_DESKTOP, SNIMKA_MOBITEL, SNIMKE, type Snimka, type SnimkaId, snimkaDatoteke } from "./konstante";

interface Props { v: SnimkaId; hero?: boolean; class?: string }
const { v, hero = false, class: klasa } = Astro.props;
const s: Snimka = SNIMKE[v];
const varijante = snimkaDatoteke(v);
---
<figure class:list={["snimka", { "ima-mobitel": s.mobitel, uspravna: s.samoMobitel }, klasa]}>
  {!s.samoMobitel && <span class="traka" aria-hidden="true"><i></i><i></i><i></i></span>}
  {varijante.map((d) => {
    const odmah = hero && !d.tamna;
    if (!d.desktop) return (
      <img src={d.mobitel} width={SNIMKA_MOBITEL.sirina} height={SNIMKA_MOBITEL.visina} alt={s.alt}
        loading={odmah ? undefined : "lazy"} decoding={odmah ? undefined : "async"} fetchpriority={odmah ? "high" : undefined} />
    );
    return (
      <picture class:list={[{ "samo-svijetla": s.tamna && !d.tamna, "samo-tamna": d.tamna }]}>
        {d.mobitel && <source media="(max-width: 719px)" srcset={d.mobitel} width={SNIMKA_MOBITEL.sirina} height={SNIMKA_MOBITEL.visina} />}
        <img src={d.desktop} width={SNIMKA_DESKTOP.sirina} height={SNIMKA_DESKTOP.visina} alt={s.alt}
          loading={odmah ? undefined : "lazy"} decoding={odmah ? undefined : "async"} fetchpriority={odmah ? "high" : undefined} />
      </picture>
    );
  })}
</figure>
<style>
  .snimka { margin: 0; overflow: hidden; border-radius: 14px; border: 1px solid var(--rub-jak); background: var(--povrsina); box-shadow: var(--sjena-2); }
  .traka { display: flex; gap: 6px; align-items: center; height: 22px; padding: 0 10px; background: var(--povrsina-2); border-bottom: 1px solid var(--rub); }
  .traka i { width: 8px; height: 8px; border-radius: 50%; background: var(--rub-jak); }
  picture, img { display: block; }
  img { width: 100%; height: auto; }
  .samo-tamna { display: none; }
  :global(:root[data-tema="tamna"]) .samo-tamna { display: block; }
  :global(:root[data-tema="tamna"]) .samo-svijetla { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-tema="svijetla"])) .samo-tamna { display: block; }
    :global(:root:not([data-tema="svijetla"])) .samo-svijetla { display: none; }
  }
  .uspravna { width: 100%; max-width: 300px; margin-inline: auto; border-radius: 26px; border-width: 4px; }
  @media (max-width: 719px) {
    .uspravna { max-width: 280px; }
    .ima-mobitel { width: 100%; max-width: 280px; margin-inline: auto; border-radius: 26px; border-width: 4px; }
    .ima-mobitel .traka { display: none; }
  }
</style>
