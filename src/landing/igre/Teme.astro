---
// G-3 Teme. Vizual V-21 (Proljeće na mobitelu, samo uspravna snimka); Božić je hero (V-20).
import Sekcija from "../Sekcija.astro";
import Snimka from "../Snimka.astro";

const TEME = [
  { naslov: "Božić", tekst: "Zimsko selo u sumrak, snijeg i bor. Svaki riješen zadatak pali lampicu." },
  { naslov: "Proljeće", tekst: "Sunčana livada i stablo jabuke. Svaki riješen zadatak pocrveni jednu jabuku." },
];
---
<Sekcija id="teme" naslov="Dvije teme" obrnuto>
  <ul class="teme">
    {TEME.map((t) => <li><strong>{t.naslov}</strong><span>{t.tekst}</span></li>)}
  </ul>
  <p>Igra radi uspravno i vodoravno, na tabletu i na mobitelu.</p>
  <Snimka v={21} slot="vizual" />
</Sekcija>
<style>
  .teme { margin: 0 0 18px; gap: 12px; }
  .teme li { padding: 18px 20px; border: 1px solid var(--rub); border-radius: 16px; background: var(--povrsina); display: grid; gap: 4px; }
  .teme li::before { display: none; }
</style>
