---
// N-4 Glasovi: pločice su tekst (ne linkovi: katalog je iza prijave). Uz R, S, Ž, L male ilustracije V-1 (256 px,
// dekorativno, alt="").
import { BROJKE, ILUSTRACIJE_V1, SAMOGLASNICI, SUGLASNICI } from "../konstante";

const slika = new Map<string, string>(ILUSTRACIJE_V1.map((s) => [s.glas, s.ime]));
---
<section class="sekcija" aria-labelledby="glasovi">
  <div class="omot">
    <h2 class="landing-h2" id="glasovi">{BROJKE.glasova} glasova, svaki na početku, u sredini i na kraju</h2>
    <p class="uvodni">Katalog ima {SUGLASNICI.length} suglasnika i {SAMOGLASNICI.length} samoglasnika. LJ, NJ i DŽ su jedan glas, kao u govoru.
      Za R postoje i skupine (KR-, BR-) i slogotvorno R.</p>
    <div class="plocice">
      <ul aria-label="Suglasnici">
        {SUGLASNICI.map((g) => {
          const ime = slika.get(g);
          return (
            <li class:list={[{ sa: ime }]}>
              {ime && <img src={`/landing/${ime}-256.webp`} width="256" height="256" alt="" loading="lazy" decoding="async" />}
              <span>{g}</span>
            </li>
          );
        })}
      </ul>
      <ul aria-label="Samoglasnici">
        {SAMOGLASNICI.map((g) => <li><span>{g}</span></li>)}
      </ul>
    </div>
    <p class="sitno">Riječi možete složiti i po mjestu tvorbe, načinu tvorbe ili zvučnosti.</p>
  </div>
</section>
<style>
  .plocice { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 28px 0 22px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  ul:first-child { max-width: 760px; }
  li { min-width: 54px; height: 54px; padding: 0 8px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: 14px;
    background: var(--povrsina); border: 1px solid var(--rub); box-shadow: var(--sjena-1); font-family: var(--font-slova); font-size: 1.45rem;
    font-weight: 600; }
  li.sa { padding: 0 12px 0 4px; border-color: var(--med); background: var(--med-blago); }
  li img { width: 44px; height: 44px; border-radius: 10px; background: var(--papir-slike); }
  ul[aria-label="Samoglasnici"] li { color: var(--med-tamno); }
  .sitno { font-size: 1rem; }
  @media (max-width: 719px) {
    li { min-width: 48px; height: 48px; font-size: 1.25rem; }
    li img { width: 38px; height: 38px; }
  }
</style>
