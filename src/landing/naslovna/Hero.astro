---
// N-1 Hero (sadrzaj.md 3.1). Vizual V-1: četiri ilustracije, 512 px, prva bez lazy (iznad pregiba).
// Odluka 802: u svakoj kartici su slike istog slova jedna na drugoj; /landing/hero.js ih izmjenjuje na prelazak mišem,
// na dodir i polako sama (ne uz prefers-reduced-motion). Bez JS-a vidi se samo prva.
import Cta from "../Cta.astro";
import { ALT_V1, H1_VARIJANTE, ILUSTRACIJE_V1, PRISTUP } from "../konstante";
---
<section class="sekcija hero" aria-labelledby="naslov">
  <div class="omot mreza">
    <div class="tekst">
      <p class="oznaka">Probno razdoblje · samo uz pozivnicu</p>
      <h1 class="landing-h1" id="naslov" data-varijante={JSON.stringify(H1_VARIJANTE)}>{H1_VARIJANTE[0].prvi} <em>{H1_VARIJANTE[0].drugi}</em></h1>
      <script src="/landing/naslov.js" type="text/javascript"></script>
      <p class="podnaslov">LogoMedo — pametan alat za izradu dječjih radnih materijala i igara</p>
      <p class="uvodni">Sve što trebate za rad i učenje s djecom, na jednom mjestu. Odaberite slike, stvorite radni listić za ispis
        ili pokrenite igru na tabletu — u samo nekoliko klikova.</p>
      <Cta gumbi={["prijava", "pristup"]} />
      <p class="sitno">Za prijavu vam treba pozivnica. Nemate je? <a href={PRISTUP}>Zatražite pristup.</a></p>
    </div>
    <div class="slike" role="img" aria-label={ALT_V1}>
      {ILUSTRACIJE_V1.map((s, k) => (
        <div class="kartica kartica-slike" data-hero-kartica>
          {[s.ime, ...s.ostale].map((ime, i) => (
            <img class:list={{ aktivna: i === 0 }} src={`/landing/${ime}-512.webp`} srcset={`/landing/${ime}-256.webp 256w, /landing/${ime}-512.webp 512w`}
              sizes="(max-width: 719px) 42vw, 240px" width="512" height="512" alt="" decoding="async"
              loading={i === 0 ? undefined : "lazy"} fetchpriority={i === 0 && k === 0 ? "high" : undefined} />
          ))}
          <span class="slovo" aria-hidden="true">{s.glas}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<script src="/landing/hero.js" defer></script>
<style>
  .hero { padding: 72px 0 80px; }
  .mreza { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .tekst { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .oznaka { margin: 0; display: inline-block; padding: 5px 12px; border-radius: 999px; background: var(--med-blago); color: var(--med-tamno);
    font-size: .85rem; font-weight: 600; }
  /* Dulji h1 (odluka 807): manji nego na podstranicama, da na desktopu stane u tri reda. */
  h1 { font-size: clamp(2.1rem, 5.2vw, 3.5rem); }
  .podnaslov { margin: 0 0 -10px; font-size: 1.2rem; font-weight: 600; color: var(--tinta); line-height: 1.4; }
  .slike { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .slike .kartica:nth-child(2), .slike .kartica:nth-child(4) { transform: translateY(18px); }
  /* Slike su jedna na drugoj (ista ćelija mreže); vidi se samo .aktivna. */
  .kartica { position: relative; display: grid; overflow: hidden; cursor: pointer; }
  .kartica img { grid-area: 1 / 1; display: block; width: 100%; height: auto; opacity: 0; transform: scale(.9) rotate(-4deg);
    transition: opacity .45s ease, transform .55s cubic-bezier(.34, 1.56, .64, 1); }
  .kartica img.aktivna { opacity: 1; transform: none; }
  .slovo { position: absolute; top: 10px; left: 10px; min-width: 34px; height: 34px; padding: 0 8px; display: grid; place-items: center;
    border-radius: 999px; background: var(--med-blago); color: var(--med-tamno); font-weight: 700; font-size: 1rem; line-height: 1; }
  @media (prefers-reduced-motion: reduce) {
    .kartica img { transition: opacity .2s linear; transform: none; }
  }
  @media (max-width: 879px) {
    .mreza { grid-template-columns: 1fr; gap: 40px; }
    .slike { max-width: 440px; }
  }
  @media (max-width: 719px) {
    .hero { padding: 40px 0 56px; }
    .slike { gap: 12px; }
  }
</style>
