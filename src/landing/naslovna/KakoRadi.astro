---
// N-3 Kako radi (odluka 809): četiri koraka kao kartice, odmah ispod hera, da se u par sekundi vidi da je LogoMedo alat
// za izradu (ne baza gotovih PDF-ova) i da daje papir i ekran. Svaki korak vodi na svoju podstranicu.
// Tvrdnje su s inventure (docs/landing/research/2026-11-19-inventura.md): vrste I-ZAD, okviri I-OKV, igra I-BIL-2.
import { BROJKE } from "../konstante";

const koraci = [
  {
    naslov: "Odaberite vrstu zadatka",
    tekst: `Izaberite jednu od ${BROJKE.vrstaZadataka} vrsta zadataka: od klasičnog niza slika, brojanja slogova i rime do izbacivanja uljeza, razvrstavanja ili scene.`,
    link: { href: "/radni-listici", tekst: "Vrste zadataka" },
  },
  {
    naslov: "Odaberite slike i posložite ih",
    tekst: "Ilustracije u boji ili bojanke birate po glasu i poziciji u riječi, a raspored, broj stupaca i redova prilagodite onako kako vam treba.",
    link: { href: "/katalog", tekst: "Katalog slika" },
  },
  {
    naslov: "Uredite i ukrasite",
    tekst: "Dodajte ukrasni okvir s mašnom i zimskim ukrasima i preuzmite gotov A4 PDF, spreman za ispis.",
    link: { href: "/radni-listici", tekst: "Radni listići" },
  },
  {
    naslov: "Isti zadatak i kao igra",
    tekst: "Uz listić za papir, zadatke složite u bilježnicu i djetetu pošaljite link. Rješava ih na tabletu, laptopu ili mobitelu, bez instalacije i prijave.",
    link: { href: "/igre", tekst: "Igre" },
  },
];
---
<section class="sekcija" aria-labelledby="kako">
  <div class="omot">
    <h2 class="landing-h2" id="kako">Kako nastaje radni listić</h2>
    <p class="uvodni">Od prazne stranice do listića za ispis i igre na ekranu, u četiri koraka.</p>
    <ol class="koraci">
      {koraci.map((k, i) => (
        <li>
          <span class="broj" aria-hidden="true">{i + 1}</span>
          <h3>{k.naslov}</h3>
          <p>{k.tekst}</p>
          <a href={k.link.href}>{k.link.tekst} <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .uvodni { margin: 0; }
  .koraci { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  li { position: relative; display: flex; flex-direction: column; gap: 10px; padding: 22px 22px 14px; border-radius: 18px;
    background: var(--povrsina); border: 1px solid var(--rub); box-shadow: var(--sjena-1); }
  /* Spojnica između kartica na desktopu: tijek se čita slijeva nadesno. */
  li:not(:last-child)::after { content: ""; position: absolute; top: 43px; right: -19px; width: 20px; height: 2px; background: var(--med); opacity: .5; }
  .broj { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 14px; background: var(--med-blago); color: var(--med-tamno);
    font-family: var(--font-slova); font-weight: 700; font-size: 1.3rem; }
  h3 { margin: 4px 0 0; font-family: var(--font-slova); font-weight: 600; font-size: 1.2rem; line-height: 1.25; color: var(--tinta); }
  p { margin: 0; flex: 1; color: var(--blijedo); font-size: 1rem; line-height: 1.55; }
  a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--med-tamno); font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
  @media (max-width: 1023px) {
    .koraci { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    li::after { display: none; }
  }
  @media (max-width: 599px) {
    .koraci { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
