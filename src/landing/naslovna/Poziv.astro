import Poziv from "../Poziv.astro";
import { KONTAKT } from "../konstante";
---
<Poziv id="probno" gumbi={["pristup", "prijava"]}>
  <Fragment slot="naslov">LogoMedo je u probnom razdoblju</Fragment>
  Gradimo ga zajedno s logopedima i pristup je zasad samo uz pozivnicu.{KONTAKT && " Ako želite isprobati katalog, listiće i igre u svom radu, javite nam se."}
</Poziv>
