---
// O-3 Probno razdoblje. Bez cijene i bez „besplatno” (odluka 204). „Javite se” je link na obrazac /pristup (S7).
import Sekcija from "../Sekcija.astro";
import Cta from "../Cta.astro";
import { PRISTUP } from "../konstante";
---
<Sekcija id="probno" naslov="Probno razdoblje">
  <p>LogoMedo je u probnom razdoblju (alfi). Logopedi ulaze uz osobnu pozivnicu i prijavljuju se bez lozinke: otiskom prsta, licem ili
    PIN-om uređaja. Svaki logoped vidi zajednički katalog, a svoje zadatke i bilježnice samo on.</p>
  <p>Što nam logopedi kažu, ide ravno u sljedeću verziju. Ako želite sudjelovati, <a href={PRISTUP}>javite se kroz obrazac</a>.</p>
  <Cta gumbi={["pristup"]} />
</Sekcija>
