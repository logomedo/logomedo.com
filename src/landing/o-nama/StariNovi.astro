---
// O-2 Stari i novi LogoMedo. Godina i „zbirka bojanki” nisu u inventuri (odluka 211; S6 ih je potvrdio iz izvoza, landing odluka 601): bez GODINA_PRVOG ostaje samo rečenica o
// preuzetom katalogu, a naslov ne spominje bojanke (landing odluka 504).
import Sekcija from "../Sekcija.astro";
import { GODINA_PRVOG } from "../konstante";
---
<Sekcija id="stari-novi" naslov={GODINA_PRVOG ? "Od bojanki do igre" : "Stari i novi LogoMedo"}>
  {GODINA_PRVOG && <p>Prvi LogoMedo {GODINA_PRVOG}. bio je zbirka bojanki po glasovima od kojih logoped složi radni listić i ispiše ga.</p>}
  <p>Novi LogoMedo preuzeo je stari katalog, s istim razvrstavanjem po početku, sredini i kraju riječi, i nadogradio ga: više od dvjesto
    novih riječi, slike u boji, deset novih vrsta zadataka i igru za dijete.</p>
</Sekcija>
