---
// P-3 Igra za dijete (inventura I-BIL-2, I-BIL-4, I-ZAD-16; /b/<slug> je noindex i nema popisa).
import Sekcija from "../Sekcija.astro";
---
<Sekcija id="igra" naslov="Igra za dijete">
  <ul>
    <li>Igra ne traži ime, prijavu ni račun.</li>
    <li>Ništa o djetetu i njegovim odgovorima ne sprema se i ne šalje.</li>
    <li>Stranica igre nije u tražilicama i ne postoji popis bilježnica; do nje se dolazi samo linkom.</li>
  </ul>
  <p class="savjet"><strong>Savjet logopedu:</strong> u naslov bilježnice ili zadatka ne upisujte puno ime djeteta, jer naslov vidi svatko
    tko ima link.</p>
</Sekcija>
<style>
  .savjet { margin-top: 20px !important; padding: 16px 20px; border-radius: 14px; background: var(--med-blago); border: 1px solid var(--rub); }
</style>
