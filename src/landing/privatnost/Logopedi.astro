---
// P-4 Logopedi s računom. Svaka stavka prema shemi i kodu (landing odluka 505): korisnici (email, ime, uloga),
// admin_passkeys (javni ključ, naziv), admin_sessions (12 h, 2 h neaktivnosti, user_agent), aktivnost (povijest),
// app_sesije (uredaj, 30 / 7 dana; landing odluka 603), kvota (7 dana), PDF u pregledniku (src/lib/pdf/preglednik.ts). Bez brojeva limita (odluka 204).
import Sekcija from "../Sekcija.astro";
---
<Sekcija id="logopedi" naslov="Što spremamo za korisnike s računom">
  <ul>
    <li><strong>Račun:</strong> e-mail na koji je stigla pozivnica, ime i prezime ako ih upišete, i uloga.</li>
    <li><strong>Prijava:</strong> passkey (otisak prsta, lice ili PIN uređaja), bez lozinke. Spremamo samo javni dio ključa i naziv koji
      mu date.</li>
    <li><strong>Sesija:</strong> prijava traje najviše 12 sati, a nakon 2 sata neaktivnosti se zatvara. Uz nju pamtimo i preglednik s kojeg
      ste se prijavili.</li>
    <li><strong>Aplikacija za mobitel i tablet:</strong> ako se prijavite u aplikaciju LogoMedo, pamtimo i naziv uređaja. Ta prijava
      vrijedi 30 dana, a zatvara se nakon 7 dana nekorištenja.</li>
    <li><strong>Vaš rad:</strong> zadaci, bilježnice i slike koje učitate ili zatražite, s poviješću izmjena.</li>
    <li><strong>Limit:</strong> koliko ste novih slika i izgovora zatražili u zadnjih 7 dana.</li>
    <li>Vaše zadatke i bilježnice drugi korisnici ne vide.</li>
    <li>PDF zadatka nastaje u vašem pregledniku i ne šalje se dalje.</li>
  </ul>
  <p class="ne"><strong>Što ne spremamo:</strong> podatke o djeci. LogoMedo nema popis djece ni njihovih rezultata.</p>
</Sekcija>
