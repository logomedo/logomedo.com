---
// R-5 Okviri. Vizual V-18 (samo desktop).
import Sekcija from "../Sekcija.astro";
import Snimka from "../Snimka.astro";
---
<Sekcija id="okviri" naslov="Ukrasni okviri" obrnuto>
  <p>Listiću dodajte okvir: rub s kockicama ili prugama, mašnu na vrhu i ukrase u kutovima, poput medvjedića ili snjegovića. Možete odabrati i
    jedan od gotovih okvira. Boje su svijetle, a uzorak počinje 5 mm od ruba papira, pa okvir ne troši puno tinte i kućni ga pisač ispiše
    cijelog.</p>
  <p class="sitno">Okviri su za papir; u igri ih nema. Zasad su ukrasi zimski.</p>
  <Snimka v={18} slot="vizual" />
</Sekcija>
