---
// Prijava mobilne aplikacije (docs/app-api.md). Aplikacija ovo otvara u Custom Tabu s PKCE
// izazovom; middleware je već tražio admin sesiju (Access ili passkey). Potvrda je izričita:
// tek klik izdaje jednokratni kod i vraća ga na shemu aplikacije.
import AdminOkvir from "../../../components/AdminOkvir.astro";
import Marka from "../../../components/Marka.astro";
import { ispravanIzazov, oznakaUredaja } from "../../../lib/app/pkce";

if (!Astro.locals.admin) return new Response(null, { status: 401 });
const izazov = Astro.url.searchParams.get("izazov") ?? "";
const uredaj = oznakaUredaja(Astro.url.searchParams.get("uredaj"));
const ispravno = ispravanIzazov(izazov) && Astro.url.searchParams.get("metoda") === "S256";
---
<AdminOkvir naslov="Prijava u aplikaciju" javno>
  <div class="prijava">
    <div class="ploha okvir">
      <Marka href="/admin" dodatak="admin" />
      <h1>Prijava u aplikaciju</h1>
      {ispravno ? (
        <>
          <p>Aplikacija LogoMedo{uredaj && <> na uređaju <b>{uredaj}</b></>} traži pristup kao <b>{Astro.locals.admin.email}</b>.</p>
          <p class="blijedo sitno">Potvrdi samo ako si upravo sam pokrenuo prijavu u aplikaciji.</p>
          <button id="potvrdi" class="gumb glavni puno" type="button" data-izazov={izazov} data-uredaj={uredaj ?? ""}>Potvrdi prijavu</button>
          <a id="otvori" class="gumb puno" hidden>Otvori aplikaciju</a>
          <p id="msg" hidden></p>
        </>
      ) : <p id="msg">Neispravan zahtjev za prijavu. Pokreni prijavu ponovno iz aplikacije.</p>}
    </div>
  </div>
</AdminOkvir>
<script>
  const gumb = document.querySelector<HTMLButtonElement>("#potvrdi");
  const otvori = document.querySelector<HTMLAnchorElement>("#otvori")!;
  const msg = document.querySelector<HTMLElement>("#msg")!;
  gumb?.addEventListener("click", async () => {
    gumb.disabled = true;
    const r = await fetch("/admin/api/app-kod", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ izazov: gumb.dataset.izazov, uredaj: gumb.dataset.uredaj }),
    }).catch(() => null);
    const d = r?.ok ? ((await r.json()) as { povratak: string }) : null;
    if (!d) { msg.textContent = "Prijava nije uspjela. Pokušaj ponovno iz aplikacije."; msg.hidden = false; return; }
    // Unutar aktivacije klika (kraće od 5 s), pa Chrome pušta prelazak na shemu aplikacije.
    otvori.href = d.povratak;
    otvori.hidden = false;
    gumb.hidden = true;
    location.assign(d.povratak);
  });
</script>
<style>
  .prijava { min-height: calc(100vh - 120px); display: grid; place-items: center; }
  .okvir { width: min(420px, 100%); padding: 32px; display: flex; flex-direction: column; gap: 10px; box-shadow: var(--sjena-2); }
  h1 { margin: 18px 0 0; font-family: var(--font-slova); font-weight: 600; font-size: 1.6rem; }
  p { margin: 0 0 8px; }
  .puno { width: 100%; min-height: 46px; }
  #msg { color: var(--greska); }
  .sitno { font-size: .8rem; }
</style>
