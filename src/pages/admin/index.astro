---
import { smijeNa } from "../../lib/admin/rute";
import AdminOkvir from "../../components/AdminOkvir.astro";
import Ikona from "../../components/Ikona.astro";
import KatalogKartice from "../../components/KatalogKartice.astro";
import { jePodjela, PODJELA_ZADANO, PODJELE, poPodjeli, type Podjela } from "../../lib/podjele-glasova";
import { glasovi, stilIzUrla, zapamtiStil, stiloviAktivni, ukupno, ukupnoSvihStilova } from "../../lib/katalog";

const s = await stilIzUrla(Astro.url);
zapamtiStil(Astro.cookies, s.kod);
const [lista, u, svi, stilovi] = await Promise.all([glasovi(s.id), ukupno(s.id), ukupnoSvihStilova(), stiloviAktivni()]);
const uzStil = (href: string) => (s.kod === "bojanka" ? href : `${href}?stil=${s.kod}`);
// Ispod brojke: koliko je u svim stilovima, ako se razlikuje (bočna traka broji sve stilove).
const sviNapomena = (ovaj: number, sviBroj: number) => (sviBroj !== ovaj ? `${sviBroj} u svim stilovima` : "");
// Mape glasova po podjeli (mjesto tvorbe, način, zvučnost); izbor se pamti u kolačiću, zadano mjesto tvorbe.
const KOLACIC_PODJELE = "katalog_podjela";
const izUrla = Astro.url.searchParams.get("podjela");
const podjela: Podjela = jePodjela(izUrla) ? izUrla : jePodjela(Astro.cookies.get(KOLACIC_PODJELE)?.value) ? Astro.cookies.get(KOLACIC_PODJELE)!.value as Podjela : PODJELA_ZADANO;
if (jePodjela(izUrla)) Astro.cookies.set(KOLACIC_PODJELE, podjela, { path: "/admin", maxAge: 60 * 60 * 24 * 365, sameSite: "lax", secure: true, httpOnly: true });
const skupine = poPodjeli(lista, podjela);
const naPodjelu = (p: Podjela) => { const q = new URLSearchParams({ ...(s.kod !== "bojanka" ? { stil: s.kod } : {}), podjela: p }); return `/admin?${q}`; };
const posto = (a: number, b: number) => (b ? Math.round((a / b) * 100) : 0);
const O = 2 * Math.PI * 26;
---
<AdminOkvir naslov="Katalog" aktivno="katalog">
  <div class="naslov">
    <div>
      <KatalogKartice aktivno="rijeci" />
      <h1>Katalog slika</h1>
      <p class="podnaslov">{u.rijeci} riječi · model <span class="mono">{s.model}</span></p>
      <nav class="stilovi-prekidac" aria-label="Stil">
        {stilovi.map((x) => <a href={x.kod === "bojanka" ? "/admin" : `/admin?stil=${x.kod}`} class:list={{ aktivno: x.kod === s.kod }} aria-current={x.kod === s.kod ? "page" : undefined}>{x.naziv}</a>)}
      </nav>
    </div>
    <div class="gumbi">
      <a class="gumb" href="/admin/nova-rijec"><Ikona ime="plus" /> Nova riječ</a>
      {smijeNa(Astro.locals.admin!.uloga, "/admin/novi-glas") && <a class="gumb" href="/admin/novi-glas"><Ikona ime="plus" /> Novi glas</a>}
      {u.kandidata > 0 && <a class="gumb glavni" href="/admin/pregled"><Ikona ime="pregled" /> Pregledaj {u.kandidata} kandidata</a>}
    </div>
  </div>

  {Astro.url.searchParams.get("obrisano") && <div class="obavijest"><Ikona ime="kvacica" /> Riječ {Astro.url.searchParams.get("obrisano")!.toLocaleUpperCase("hr")} je obrisana. Vratiti se može u Aktivnosti.</div>}
  <section class="brojke">
    <div class="ploha brojka">
      <span class="vrijednost">{u.odobreno}<small>/{u.rijeci}</small></span>
      <span class="opis">odobrenih slika</span>
      <div class="traka-napretka"><i style={`width:${posto(u.odobreno, u.rijeci)}%`}></i></div>
    </div>
    <div class="ploha brojka"><span class="vrijednost">{u.kandidata}</span><span class="opis">kandidata čeka pregled</span><span class="svi">{sviNapomena(u.kandidata, svi.kandidata)}</span></div>
    <div class="ploha brojka"><span class="vrijednost">{u.uRedu}</span><span class="opis">u redu za generiranje</span><span class="svi">{sviNapomena(u.uRedu, svi.uRedu)}</span></div>
    <div class="ploha brojka" class:list={{ upozorenje: u.gresaka > 0 }}><span class="vrijednost">{u.gresaka}</span><span class="opis">neuspjelih generiranja</span><span class="svi">{sviNapomena(u.gresaka, svi.gresaka)}</span></div>
  </section>

  <nav class="podjela-prekidac" aria-label="Složi glasove po">
    <span class="blijedo">Složi po:</span>
    {(Object.keys(PODJELE) as Podjela[]).map((p) => <a href={naPodjelu(p)} class:list={{ aktivno: p === podjela }} aria-current={p === podjela ? "true" : undefined}>{PODJELE[p].naziv}</a>)}
  </nav>

  {skupine.map(({ skupina: sk, glasovi: gs }) => (
    <section class="skupina">
      <h2>{sk.naziv}{sk.opis && <span class="opis-skupine"> · {sk.opis}</span>}</h2>
      <div class="glasovi">
        {gs.map((g) => (
          <a class="ploha glas" href={uzStil(`/admin/glas/${g.slug}`)}>
            <svg class="prsten" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="26" class="podloga" />
              <circle cx="32" cy="32" r="26" class="kandidati" stroke-dasharray={`${(O * (g.odobreno + g.kandidata)) / Math.max(g.rijeci, 1)} ${O}`} />
              <circle cx="32" cy="32" r="26" class="odobreno" stroke-dasharray={`${(O * g.odobreno) / Math.max(g.rijeci, 1)} ${O}`} />
            </svg>
            <span class="slovo">{g.oznaka}</span>
            <span class="podaci">
              <b>{g.odobreno}/{g.rijeci}</b> odobreno
              <span class="sitno">
                {g.kandidata > 0 && <span class="oznaka med">{g.kandidata} za pregled</span>}
                {g.uRedu > 0 && <span class="oznaka info">{g.uRedu} u redu</span>}
                {!g.kandidata && !g.uRedu && g.odobreno < g.rijeci && <span class="oznaka">{g.rijeci - g.odobreno} bez slike</span>}
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}
</AdminOkvir>

<style>
  .stilovi-prekidac { display: inline-flex; gap: 2px; margin-top: 12px; padding: 3px; border-radius: 10px; background: var(--povrsina-2); }
  .stilovi-prekidac a { padding: 5px 14px; border-radius: 8px; text-decoration: none; color: var(--blijedo); font-weight: 600; font-size: .86rem; }
  .stilovi-prekidac a.aktivno { background: var(--povrsina); color: var(--tinta); box-shadow: var(--sjena-1); }
  .svi { color: var(--vrlo-blijedo); font-size: .76rem; }
  .gumbi { display: flex; gap: 10px; flex-wrap: wrap; }
  .brojke { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 40px; }
  .brojka { padding: 18px 20px; display: flex; flex-direction: column; gap: 2px; }
  .vrijednost { font-family: var(--font-slova); font-size: 2.1rem; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .vrijednost small { font-size: 1rem; color: var(--vrlo-blijedo); font-weight: 500; }
  .opis { color: var(--blijedo); font-size: .86rem; }
  .brojka.upozorenje .vrijednost { color: var(--greska); }
  .traka-napretka { margin-top: 10px; height: 6px; border-radius: 999px; background: var(--povrsina-2); overflow: hidden; }
  .traka-napretka i { display: block; height: 100%; background: var(--med); border-radius: inherit; }

  .podjela-prekidac { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: -16px 0 26px; font-size: .86rem; }
  .podjela-prekidac a { padding: 5px 12px; border-radius: 999px; border: 1px solid var(--rub); text-decoration: none; color: var(--blijedo); font-weight: 600; }
  .podjela-prekidac a.aktivno { background: var(--tinta); border-color: var(--tinta); color: var(--povrsina); }
  .opis-skupine { text-transform: none; letter-spacing: 0; font-weight: 500; color: var(--vrlo-blijedo); }
  .skupina { margin-bottom: 34px; }
  .skupina h2 { margin: 0 0 12px; font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; color: var(--blijedo); font-weight: 650; }
  .glasovi { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .glas { position: relative; display: flex; align-items: center; gap: 18px; padding: 18px 20px; text-decoration: none;
    transition: transform .18s cubic-bezier(.2,.8,.2,1), box-shadow .18s, border-color .18s; }
  .glas:hover { transform: translateY(-2px); box-shadow: var(--sjena-2); border-color: var(--rub-jak); }
  .prsten { position: absolute; left: 14px; top: 50%; translate: 0 -50%; width: 92px; height: 92px; rotate: -90deg; }
  .prsten circle { fill: none; stroke-width: 3.5; stroke-linecap: round; }
  .prsten .podloga { stroke: var(--povrsina-2); }
  .prsten .kandidati { stroke: var(--med-blago); }
  .prsten .odobreno { stroke: var(--med); }
  .slovo { flex: none; width: 80px; height: 80px; display: grid; place-items: center; position: relative;
    font-family: var(--font-slova); font-size: 2.7rem; font-weight: 600; font-variation-settings: "SOFT" 100, "opsz" 144; line-height: 1; }
  .podaci { display: flex; flex-direction: column; gap: 6px; color: var(--blijedo); font-size: .86rem; padding-left: 8px; }
  .podaci b { color: var(--tinta); font-variant-numeric: tabular-nums; }
  .sitno { display: flex; gap: 4px; flex-wrap: wrap; }
</style>
