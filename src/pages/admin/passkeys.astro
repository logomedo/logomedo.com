---
import AdminOkvir from "../../components/AdminOkvir.astro";
import Ikona from "../../components/Ikona.astro";
import { kad } from "../../lib/katalog";
import { mojiKljucevi, obrisiKljuc } from "../../lib/admin/passkey";

if (!Astro.locals.admin) return new Response(null, { status: 401 });
const { email, createdAt } = Astro.locals.admin;
if (Astro.request.method === "POST") {
  const forma = await Astro.request.formData();
  await obrisiKljuc(String(forma.get("id")), email);
  return Astro.redirect("/admin/passkeys", 303);
}
const kljucevi = await mojiKljucevi(email);
// Passkey radi samo na domeni na kojoj je upisan (rpID). Staging je kopija produkcijske baze, pa
// ključeve s logomedo.com samo pokazuje, odvojeno i s napomenom.
const domena = Astro.url.hostname;
const ovdje = kljucevi.filter((k) => k.rp_id === domena);
const drugdje = kljucevi.filter((k) => k.rp_id !== domena);
// Isto pravilo kao registerRefusal: svaka prijava mlađa od 10 min (kod, passkey ili pozivnica).
const svjeza = Date.now() - Date.parse(createdAt) < 10 * 60_000;
---
<AdminOkvir naslov="Ključevi" aktivno="kljucevi">
  <div class="naslov"><div><h1>Ključevi</h1><p class="podnaslov">Passkeyi za <b>{email}</b></p></div></div>
  <div class="raspored">
    <div class="ploha">
      {ovdje.length ? (
        <table>
          <thead><tr><th>Oznaka</th><th>Dodan</th><th>Zadnje korišten</th><th></th></tr></thead>
          <tbody>
            {ovdje.map((k) => (
              <tr>
                <td><b>{k.label}</b></td><td class="blijedo">{kad(k.created_at)}</td><td class="blijedo">{kad(k.last_used_at)}</td>
                <td><form method="post"><input type="hidden" name="id" value={k.id} /><button class="gumb mali tihi opasno" type="submit">Obriši</button></form></td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : <div class="prazno"><h2>Još nema ključeva{drugdje.length ? ` za ${domena}` : ""}</h2><p>Dodaj passkey da sljedeći put uđeš bez koda na e-mail.</p></div>}
      {drugdje.length > 0 && (
        <div id="druga-domena" class="druga">
          <h2>Ključevi za drugu domenu</h2>
          <p class="blijedo sitno">Passkey radi samo na domeni na kojoj je dodan, pa ovdje (<b>{domena}</b>) ovi ne otvaraju prijavu.
            {domena !== "logomedo.com" && " Ova baza je kopija produkcijske, zato su na popisu."}</p>
          <table>
            <thead><tr><th>Oznaka</th><th>Domena</th><th>Zadnje korišten</th></tr></thead>
            <tbody>
              {drugdje.map((k) => (
                <tr class="blijedo"><td>{k.label}</td><td>{k.rp_id}</td><td>{kad(k.last_used_at)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
    <form id="passkey-register" class="ploha dodaj">
      <h2>Dodaj passkey</h2>
      <p class="blijedo sitno">{svjeza ? "Prijava je svježa, možeš dodati ključ." : "Dodavanje traži prijavu mlađu od 10 minuta: odjavi se i prijavi ponovno."}</p>
      <input type="text" name="label" placeholder="Oznaka, npr. MacBook" maxlength="80" />
      <button class="gumb glavni" type="submit"><Ikona ime="kljuc" /> Dodaj</button>
      <p id="msg" hidden></p>
    </form>
  </div>
</AdminOkvir>
<script>import "../../lib/admin/klijent";</script>
<style>
  .raspored { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }
  @media (max-width: 900px) { .raspored { grid-template-columns: 1fr; } }
  .dodaj { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .dodaj h2 { margin: 0; font-family: var(--font-slova); font-weight: 600; }
  .sitno { font-size: .82rem; margin: 0; }
  form { margin: 0; }
  #msg { color: var(--greska); }
  .druga { padding: 16px 0 0; border-top: 1px solid var(--rub); margin-top: 8px; }
  .druga h2 { margin: 0 16px 4px; font-size: 1rem; font-family: var(--font-slova); font-weight: 600; }
  .druga p { margin: 0 16px 10px; }
</style>
