---
// Razgovor (docs/inbox/, S3): nit kronološki, privitci iz R2, odgovor s brzim odgovorima. Samo superadmin.
// Tekst je zadani prikaz; izvorni HTML ide u `iframe sandbox` (srcdoc, bez skripti; CSP stranice vrijedi i u
// njemu, pa se vanjske slike ne učitavaju). Otvaranje razgovora označava dolazne poruke pročitanima.
import AdminOkvir from "../../../components/AdminOkvir.astro";
import Ikona from "../../../components/Ikona.astro";
import { kad } from "../../../lib/katalog";
import { smije } from "../../../lib/admin/ovlasti";
import {
  brziOdgovori, htmlZaPrikaz, nit, oznaciProcitano, postaviStatus, putanjaPrivitka, razdvojiAdresu, razdvojiCitat, type StatusRazgovora,
} from "../../../lib/poruke";
import { posaljiOdgovor } from "../../../lib/email";

const s = Astro.locals.admin;
if (!s || !smije(s.uloga, "korisnici")) return new Response("Zabranjeno", { status: 403 });
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return new Response("Nema razgovora", { status: 404 });

let greska: string | null = null;
let nacrt = "";
const ok = Astro.url.searchParams.get("ok");
const poruka = ok === "poslano" ? "Odgovor je poslan." : ok === "status" ? "Status je promijenjen." : null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const akcija = String(f.get("akcija") ?? "");
  if (akcija === "odgovor") {
    nacrt = String(f.get("tekst") ?? "");
    if (nacrt.length > 20000) greska = "Odgovor je predug (najviše 20 000 znakova).";
    else {
      const r = await posaljiOdgovor({ razgovorId: id, tekst: nacrt, poslao: s.email });
      if (r.ok) return Astro.redirect(`/admin/poruke/${id}?ok=poslano#odgovor`, 303);
      if (r.razlog === "nema_razgovora") return new Response("Nema razgovora", { status: 404 });
      greska = r.razlog === "nema_kljuca" ? "Slanje e-pošte ovdje nije uključeno (nema RESEND_API_KEY). Ništa nije poslano ni upisano."
        : r.razlog === "prazno" ? "Odgovor je prazan."
        : "Slanje nije uspjelo, ništa nije upisano. Pokušaj ponovno za minutu.";
      if (r.razlog === "greska") console.error("odgovor nije poslan", r.detalj);
    }
  } else if (akcija === "status") {
    const st = String(f.get("status") ?? "") as StatusRazgovora;
    if (!["otvoren", "zatvoren"].includes(st)) greska = "Nepoznat status.";
    else if (await postaviStatus(id, st)) return Astro.redirect(`/admin/poruke/${id}?ok=status`, 303);
    else return new Response("Nema razgovora", { status: 404 });
  } else greska = "Nepoznata radnja.";
  if (greska) Astro.response.status = 400;
}

const t = await nit(id);
if (!t) return new Response("Nema razgovora", { status: 404 });
const { razgovor: r } = t;
if (r.neprocitano > 0) await oznaciProcitano(id);
const brzi = await brziOdgovori();

const poruke = t.poruke.map((m) => {
  const { tekst: cist, citat } = razdvojiCitat(m.text);
  const prikaz = m.html ? htmlZaPrikaz(m.html, m.privitci) : null;
  return { ...m, novo: m.smjer === "ulaz" && !m.procitano_at, cist, citat, prikaz, posiljatelj: razdvojiAdresu(m.od) };
});
const zadnja = poruke.at(-1)?.id;
const STATUS: Record<StatusRazgovora, string> = { otvoren: "otvoren", zatvoren: "zatvoren", nerasporedjen: "neraspoređen" };
const velicina = (b: number | null) => b == null ? "" : b < 1024 * 1024 ? `${Math.max(1, Math.round(b / 1024))} kB` : `${(b / 1024 / 1024).toFixed(1)} MB`;
---
<AdminOkvir naslov={r.predmet ?? "Razgovor"} aktivno="poruke">
  <p class="natrag"><a href="/admin/poruke"><Ikona ime="natrag" /> Sve poruke</a></p>
  <div class="naslov">
    <div class="sugovornik">
      <h1>{r.predmet ?? "(bez predmeta)"}</h1>
      <p class="podnaslov"><b>{r.ime ?? r.email}</b>{r.ime && <> · {r.email}</>}
        <span class:list={["status", r.status]}>{STATUS[r.status]}</span></p>
    </div>
    <form method="post" class="status-obrazac">
      <input type="hidden" name="akcija" value="status" />
      {r.status === "zatvoren"
        ? <button class="gumb mali" name="status" value="otvoren" type="submit">Otvori ponovno</button>
        : <button class="gumb mali" name="status" value="zatvoren" type="submit"><Ikona ime="kvacica" /> Zatvori</button>}
      {r.status === "nerasporedjen" && <button class="gumb mali" name="status" value="otvoren" type="submit">Razvrstaj kao otvoren</button>}
    </form>
  </div>

  {poruka && <p class="obavijest ok" role="status">{poruka}</p>}

  <ol class="nit" id="nit">
    {poruke.map((m) => (
      <li class:list={["poruka", m.smjer, { novo: m.novo }]} id={`poruka-${m.id}`} data-zadnja={m.id === zadnja ? "1" : undefined}>
        <header>
          <span class="od">{m.smjer === "izlaz" ? (m.poslao ? `LogoMedo (${m.poslao})` : "LogoMedo (automatski)") : (m.posiljatelj.ime ?? m.posiljatelj.email)}</span>
          {m.novo && <span class="oznaka-novo">novo</span>}
          <time class="kad" datetime={m.created_at}>{kad(m.created_at)}</time>
        </header>
        {m.smjer === "ulaz" && m.posiljatelj.ime && <p class="adresa">{m.posiljatelj.email}</p>}
        {m.predmet && m.predmet !== r.predmet && <p class="predmet-poruke">{m.predmet}</p>}
        {m.tijelo_fali ? <p class="blijedo">Tijelo poruke nije dohvaćeno.</p> : m.cist
          ? <div class="tekst">{m.cist}</div>
          : !m.prikaz && <p class="blijedo">(prazna poruka)</p>}
        {m.citat && (
          <details class="citat"><summary>Citirani tekst</summary><div class="tekst">{m.citat}</div></details>
        )}
        {m.prikaz && (
          <details class="html" open={!m.cist}>
            <summary>Izvorni izgled (HTML)</summary>
            <iframe class="html-okvir" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"
              title={`Izvorni izgled poruke ${m.id}`} srcdoc={m.prikaz.html} loading="lazy"></iframe>
            <p class="blijedo sitno">Vanjske slike se ne učitavaju.</p>
          </details>
        )}
        {m.privitci.length > 0 && (
          <ul class="privitci">
            {m.privitci.map((p) => (
              <li>
                {p.r2_kljuc
                  ? <a href={putanjaPrivitka(p.id)} download={p.ime}><Ikona ime="slika" /> {p.ime}</a>
                  : <span class="blijedo"><Ikona ime="upozorenje" /> {p.ime}</span>}
                <span class="blijedo sitno"> {[velicina(p.velicina), m.prikaz?.ugradeni.includes(p.id) ? "u tekstu" : null, p.napomena].filter(Boolean).join(" · ")}</span>
              </li>
            ))}
          </ul>
        )}
        {m.napomena && <p class="blijedo sitno">{m.napomena}</p>}
      </li>
    ))}
  </ol>

  <section class="ploha odgovor" id="odgovor" aria-labelledby="odgovor-naslov">
    <h2 id="odgovor-naslov">Odgovor za {r.ime ?? r.email}</h2>
    {greska && <p class="obavijest greska" role="alert" id="greska">{greska}</p>}
    <form method="post" id="odgovor-obrazac">
      <input type="hidden" name="akcija" value="odgovor" />
      {brzi.length > 0 && (
        <div class="brzi-red">
          <label for="brzi-izbor">Brzi odgovor</label>
          <select id="brzi-izbor">
            <option value="">Umetni…</option>
            {brzi.map((b) => <option value={b.kratica} data-tekst={b.tekst}>/{b.kratica} · {b.naslov}</option>)}
          </select>
        </div>
      )}
      <textarea id="odgovor-tekst" name="tekst" rows="8" maxlength="20000" required
        aria-describedby="odgovor-pomoc" placeholder="Pozdrav,…">{nacrt}</textarea>
      <p class="blijedo sitno" id="odgovor-pomoc">
        {brzi.length > 0 ? <>Upiši <code>/kratica</code> pa Tab za brzi odgovor. </> : null}
        Šalje se s bok@logomedo.com, s kratkim citatom zadnje poruke; odgovor stiže natrag ovamo.{" "}
        <a href="/admin/poruke/brzi">Uredi brze odgovore</a>
      </p>
      <div class="akcije">
        <button class="gumb glavni" type="submit"><Ikona ime="pismo" /> Pošalji</button>
      </div>
    </form>
  </section>
</AdminOkvir>
<script>
  import { umetniKraticu, umetniNaKursor } from "../../../lib/poruke-klijent";

  const polje = document.getElementById("odgovor-tekst") as HTMLTextAreaElement | null;
  const izbor = document.getElementById("brzi-izbor") as HTMLSelectElement | null;
  const kratice = new Map<string, string>();
  for (const o of Array.from(izbor?.options ?? [])) if (o.value) kratice.set(o.value, o.dataset.tekst ?? "");

  const postavi = (u: { vrijednost: string; kursor: number }) => {
    if (!polje) return;
    polje.value = u.vrijednost;
    polje.setSelectionRange(u.kursor, u.kursor);
    polje.focus();
  };
  polje?.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || e.shiftKey || e.altKey || e.ctrlKey || e.metaKey || polje.selectionStart !== polje.selectionEnd) return;
    const u = umetniKraticu(polje.value, polje.selectionStart, kratice);
    if (!u) return;
    e.preventDefault();
    postavi(u);
  });
  izbor?.addEventListener("change", () => {
    const tekst = kratice.get(izbor.value);
    izbor.value = "";
    if (!polje || tekst === undefined) return;
    postavi(umetniNaKursor(polje.value, polje.selectionStart, polje.selectionEnd, tekst));
  });

  // Visina iframea prema sadržaju (sandbox ima allow-same-origin, bez skripti u njemu).
  for (const f of Array.from(document.querySelectorAll<HTMLIFrameElement>("iframe.html-okvir"))) {
    const prilagodi = () => {
      try {
        // documentElement je visok barem kao okvir, pa se mjeri body (i njegove margine).
        const b = f.contentDocument?.body;
        if (!b) return;
        const m = parseFloat(getComputedStyle(b).marginTop) + parseFloat(getComputedStyle(b).marginBottom);
        const h = Math.max(b.scrollHeight, b.offsetHeight) + (m || 0);
        if (h) f.style.height = `${Math.min(Math.max(h + 4, 80), 2000)}px`;
      } catch { /* ostaje zadana visina */ }
    };
    f.addEventListener("load", prilagodi);
    f.closest("details")?.addEventListener("toggle", prilagodi);
  }

  // Bez ?ok i bez greške: skok na zadnju poruku (duge niti).
  if (!location.hash && !document.getElementById("greska")) document.querySelector("[data-zadnja]")?.scrollIntoView({ block: "nearest" });
</script>
<style>
  .natrag { margin: 0 0 8px; font-size: .88rem; }
  .natrag a { display: inline-flex; align-items: center; gap: 4px; color: var(--blijedo); text-decoration: none; }
  .natrag :global(svg) { width: 16px; height: 16px; }
  .naslov { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .sugovornik { min-width: 0; }
  .sugovornik h1 { overflow-wrap: anywhere; }
  .podnaslov { overflow-wrap: anywhere; }
  .status-obrazac { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; }
  .status { margin-left: 8px; font-size: .75rem; font-weight: 600; padding: 1px 8px; border-radius: 999px; background: var(--povrsina-2); color: var(--blijedo); }
  .status.otvoren { background: var(--uspjeh-blago); color: var(--uspjeh); }
  .status.nerasporedjen { background: var(--med-blago); color: var(--med-tamno); }
  .obavijest { margin: 12px 0 0; font-weight: 600; font-size: .9rem; }
  .obavijest.ok { color: var(--uspjeh); }
  .obavijest.greska { color: var(--greska); margin: 0 0 10px; }
  .sitno { font-size: .8rem; margin: 4px 0 0; }
  .nit { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .poruka { background: var(--povrsina); border: 1px solid var(--rub); border-radius: 14px; padding: 14px 18px; min-width: 0; max-width: 780px; box-sizing: border-box; }
  .poruka.izlaz { align-self: flex-end; width: min(100%, 780px); background: var(--povrsina-2); }
  .poruka.ulaz { width: min(100%, 780px); }
  .poruka.novo { border-color: var(--med); }
  .poruka header { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .od { font-weight: 650; overflow-wrap: anywhere; }
  .oznaka-novo { font-size: .72rem; font-weight: 700; color: var(--med-tamno); background: var(--med-blago); border-radius: 999px; padding: 1px 7px; }
  .kad { margin-left: auto; font-size: .8rem; color: var(--blijedo); }
  .adresa, .predmet-poruke { margin: 2px 0 0; font-size: .82rem; color: var(--blijedo); overflow-wrap: anywhere; }
  .tekst { white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 10px; line-height: 1.5; }
  details { margin-top: 10px; }
  summary { cursor: pointer; font-size: .85rem; color: var(--blijedo); }
  .citat .tekst { color: var(--blijedo); font-size: .9rem; border-left: 3px solid var(--rub); padding-left: 10px; }
  .html-okvir { display: block; width: 100%; height: 360px; margin-top: 8px; border: 1px solid var(--rub); border-radius: 10px; background: #fff; }
  .privitci { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: .9rem; }
  .privitci a, .privitci span:first-child { display: inline-flex; align-items: center; gap: 6px; overflow-wrap: anywhere; }
  .privitci :global(svg) { width: 16px; height: 16px; flex-shrink: 0; }
  .odgovor { margin-top: 20px; padding: 18px 20px; max-width: 780px; box-sizing: border-box; }
  .odgovor h2 { margin: 0 0 10px; font-family: var(--font-slova); font-weight: 600; font-size: 1.1rem; overflow-wrap: anywhere; }
  .brzi-red { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .brzi-red label { font-size: .88rem; font-weight: 600; }
  .brzi-red select { min-width: 0; max-width: 100%; }
  textarea { width: 100%; box-sizing: border-box; font: inherit; resize: vertical; min-height: 140px; }
  .akcije { margin-top: 10px; display: flex; justify-content: flex-end; }
  form { margin: 0; }
</style>
