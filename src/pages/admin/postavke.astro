---
// Postavke korisnika (migracija 0029). Stranica sama obrađuje POST (kao /admin/zvukovi).
import AdminOkvir from "../../components/AdminOkvir.astro";
import { logopedskiMod, postaviLogopedskiMod } from "../../lib/zadaci/baza";
import { IME_MAX, profil, spremiProfil } from "../../lib/admin/profil";
import { kad } from "../../lib/katalog";
import { limitZa, mojiUredaji, odjaviUredaj, provedba } from "../../lib/admin/uredaji";

const s = Astro.locals.admin!;
const email = s.email;
const superadmin = s.uloga === "superadmin";
let spremljeno: "mod" | "profil" | "uredaj" | null = Astro.url.searchParams.get("ok") === "profil" ? "profil" : null;
let greska: string | null = null;
let unos: { ime: string; email: string } | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  if (f.get("akcija") === "odjavi_uredaj") {
    await odjaviUredaj(email, Number(f.get("id")), null, Astro.request);
    spremljeno = "uredaj";
  } else if (f.get("akcija") === "profil") {
    const r = await spremiProfil(s, { ime: f.get("ime"), email: superadmin ? null : f.get("email") });
    // Nova stranica nakon spremanja: zaglavlje i sesija već čitaju novi e-mail.
    if (r.ok) return Astro.redirect("/admin/postavke?ok=profil", 303);
    else {
      greska = r.greska;
      unos = { ime: String(f.get("ime") ?? ""), email: String(f.get("email") ?? email) };
      Astro.response.status = 400;
    }
  } else {
    await postaviLogopedskiMod(email, f.get("logopedski_mod") === "1");
    spremljeno = "mod";
  }
}
const mod = await logopedskiMod(email);
const p = unos ?? await profil(email);
const uredaji = await mojiUredaji(email, Astro.request);
const limitUredaja = limitZa(s.uloga, null, provedba());
const mjesto = (u: { grad: string | null; mreza: string | null }) => [u.grad, u.mreza].filter(Boolean).join(" · ") || "nepoznato mjesto";
---
<AdminOkvir naslov="Postavke" aktivno="postavke">
  <div class="naslov">
    <div>
      <h1>Postavke</h1>
      <p class="podnaslov">Vrijede samo za tvoj račun.</p>
    </div>
  </div>

  <form method="post" class="ploha postavke" id="profil">
    <input type="hidden" name="akcija" value="profil" />
    <h2>Profil</h2>
    <div class="polja">
      <div>
        <label for="profil-ime">Ime i prezime</label>
        <input id="profil-ime" type="text" name="ime" value={p.ime} maxlength={IME_MAX} autocomplete="name" placeholder="npr. Ana Horvat" />
      </div>
      <div>
        <label for="profil-email">E-mail</label>
        <input id="profil-email" type="email" name="email" value={p.email} required maxlength="254" autocomplete="email"
          readonly={superadmin} />
      </div>
    </div>
    <p class="opis">{superadmin
      ? "Superadminov e-mail je u postavkama poslužitelja (ADMIN_EMAILS) i ovdje se ne mijenja."
      : "E-mail je i korisničko ime za prijavu. Passkeyi, zadaci i sve što si napravio ostaju tvoji i nakon promjene."}</p>
    <div class="dno">
      {greska && <span class="greska" role="alert">{greska}</span>}
      {spremljeno === "profil" && <span class="spremljeno" role="status">Spremljeno.</span>}
      <button class="gumb glavni mali" type="submit">Spremi</button>
    </div>
  </form>

  <form method="post" class="ploha postavke">
    <input type="hidden" name="akcija" value="mod" />
    <label class="prekidac">
      <input type="checkbox" name="logopedski_mod" value="1" checked={mod} />
      <span class="klizac" aria-hidden="true"></span>
      <span>
        <b>Logopedski mod</b>
        <span class="opis">Na <a href="/admin/predlosci">Novi zadatak</a> nudi „Po glasovima…”: radni listić, prebrajanje, rimu i prvi glas
          složene od riječi s glasom koji dijete vježba (pozicija u riječi, glasovi koje treba izbjeći). Bez njega se predlošci slažu iz cijelog kataloga.</span>
      </span>
    </label>
    <div class="dno">
      {spremljeno === "mod" && <span class="spremljeno" role="status">Spremljeno.</span>}
      <button class="gumb glavni mali" type="submit">Spremi</button>
    </div>
  </form>

  <section class="ploha postavke" id="uredaji">
    <h2>Uređaji</h2>
    <p class="opis">Preglednici u kojima je LogoMedo otvoren zadnjih 90 dana. Tabovi i prozori istog preglednika su jedan uređaj.
      {limitUredaja !== null && <> Istovremeno smiješ raditi na {limitUredaja === 1 ? "jednom uređaju" : `${limitUredaja} uređaja`}; na sljedećem ćeš moći jedan od njih odjaviti i nastaviti.</>}
      {" "}Uređaj koji ne prepoznaješ odjavi i javi nam na <a href="mailto:bok@logomedo.com">bok@logomedo.com</a>.</p>
    <ul class="uredaji">
      {uredaji.map((u) => (
        <li data-uredaj={u.id}>
          <div>
            <b>{u.naziv}</b>
            {u.ovaj && <span class="oznaka uspjeh">ovaj uređaj</span>}
            {!u.ovaj && u.aktivan && <span class="oznaka med">sada u upotrebi</span>}
            <span class="opis">{mjesto(u)} · zadnje {kad(u.zadnji_put)}{u.odjavljen_at && ` · odjavljen ${kad(u.odjavljen_at)}`}</span>
          </div>
          {!u.ovaj && !u.odjavljen_at && (
            <form method="post">
              <input type="hidden" name="akcija" value="odjavi_uredaj" /><input type="hidden" name="id" value={u.id} />
              <button class="gumb mali tihi" type="submit">Odjavi</button>
            </form>
          )}
        </li>
      ))}
    </ul>
    {spremljeno === "uredaj" && <div class="dno"><span class="spremljeno" role="status">Uređaj odjavljen.</span></div>}
  </section>
</AdminOkvir>

<style>
  .uredaji { list-style: none; margin: 0; padding: 0; }
  .uredaji li { display: flex; gap: 12px; align-items: center; justify-content: space-between; padding: 10px 0; }
  .uredaji li + li { border-top: 1px solid var(--rub); }
  .uredaji .oznaka { margin-left: 8px; }
  .uredaji form { margin: 0; }
  .postavke h2 { margin: 0; font-family: var(--font-slova); font-weight: 600; font-size: 1.15rem; }
  .polja { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 640px) { .polja { grid-template-columns: 1fr; } }
  .polja input[readonly] { background: var(--povrsina-2); color: var(--blijedo); cursor: not-allowed; }
  .postavke > .opis { margin: -4px 0 0; }
  .greska { color: var(--greska); font-weight: 600; font-size: .88rem; margin-right: auto; }
  .postavke { margin-top: 24px; max-width: 640px; padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  .prekidac { display: flex; gap: 14px; align-items: flex-start; cursor: pointer; margin: 0; }
  .prekidac input { position: absolute; opacity: 0; pointer-events: none; }
  .klizac { flex: none; position: relative; width: 42px; height: 24px; margin-top: 2px; border-radius: 12px; background: var(--rub-jak); transition: background .15s; }
  .klizac::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: var(--povrsina); transition: transform .15s; }
  .prekidac input:checked + .klizac { background: var(--med); }
  .prekidac input:checked + .klizac::after { transform: translateX(18px); }
  .prekidac input:focus-visible + .klizac { outline: 2px solid var(--med); outline-offset: 2px; }
  .opis { display: block; margin-top: 4px; color: var(--blijedo); font-size: .88rem; line-height: 1.45; }
  .dno { display: flex; justify-content: flex-end; align-items: center; gap: 12px; }
  .spremljeno { color: var(--uspjeh); font-weight: 600; font-size: .88rem; }
</style>
