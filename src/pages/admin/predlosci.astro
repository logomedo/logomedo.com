---
import AdminOkvir from "../../components/AdminOkvir.astro";
import { nazivPodrucja, podrucja as svaPodrucja, zaListic } from "../../lib/zadaci/baza";
import { BROJEVI_LISTICA, ZADANO_SLIKA } from "../../lib/zadaci/listic-glas";
import { ABECEDA, VRSTE, type Vrsta } from "../../lib/zadaci/vrste";

const [podrucja, listic] = await Promise.all([svaPodrucja(), zaListic()]);
// Isključuju se suglasnici (po fonemima, pa „bez L” ne dira LJ).
const suglasnici = ABECEDA.filter((g) => !"AEIOU".includes(g));
const listicJson = JSON.stringify(listic.rijeci).replace(/</g, "\\u003c");
const prazno = Astro.url.searchParams.has("prazno");
const pozicije = [["", "Bilo gdje u riječi"], ["inicijalna", "Inicijalna (početak)"], ["medijalna", "Medijalna (sredina)"], ["finalna", "Finalna (kraj)"], ["skupina", "Skupine"]];
const listovi = podrucja.filter((p) => p.roditelj_id !== null);
const zadano: Record<Vrsta, string> = { listic: "listici", odabir: "rima", povezivanje: "rima", uljez: "rima", scena: "situacije", percepcija: "vizualna-percepcija", prvi_glas: "prvi-glas", slogovi: "slogovi" };
const vrste = Object.entries(VRSTE) as [Vrsta, (typeof VRSTE)[Vrsta]][];
// Svaka vrsta ide u svoje podpodručje (ono je samo oznaka; mijenja se u uređivaču), a gumbi su njezine inačice.
const gumbi: Record<Vrsta, { tekst: string; nacin?: string }[]> = {
  listic: [{ tekst: "Iz cijelog kataloga" }],
  slogovi: [{ tekst: "Slogovi u riječi", nacin: "analiza" }, { tekst: "Glasovi u riječi", nacin: "glasovi" }, { tekst: "Dugačke i kratke riječi", nacin: "duljina" }],
  odabir: [{ tekst: "Rima" }], povezivanje: [{ tekst: "Rima" }], uljez: [{ tekst: "Rima" }],
  percepcija: [{ tekst: "Nađi različitu", nacin: "razlicitu" }, { tekst: "Nađi dvije iste", nacin: "par" }],
  prvi_glas: [{ tekst: "Kolo slova" }], scena: [{ tekst: "Nova scena" }],
};
const podrucjeVrste = (kod: Vrsta) => listovi.find((p) => p.slug === zadano[kod]);
// Jedna mreža, redom podpodručja (bez naslova po glavnim područjima); vrste bez podpodručja na kraju.
const poRedu = [...listovi.flatMap((l) => vrste.filter(([kod]) => podrucjeVrste(kod)?.id === l.id)), ...vrste.filter(([kod]) => !podrucjeVrste(kod))];
const listicPodrucje = podrucjeVrste("listic")?.id ?? "";

// Mala shema rasporeda svake vrste (kvadratići = slike).
const shema: Record<Vrsta, string> = {
  odabir: `<rect x="34" y="4" width="20" height="20" rx="4" class="s-jaka"/><rect x="6" y="34" width="20" height="20" rx="4"/><rect x="34" y="34" width="20" height="20" rx="4" class="s-med"/><rect x="62" y="34" width="20" height="20" rx="4"/>`,
  povezivanje: `<rect x="8" y="4" width="16" height="16" rx="3"/><rect x="8" y="23" width="16" height="16" rx="3"/><rect x="8" y="42" width="16" height="16" rx="3"/><rect x="64" y="4" width="16" height="16" rx="3"/><rect x="64" y="23" width="16" height="16" rx="3"/><rect x="64" y="42" width="16" height="16" rx="3"/><path d="M26 12 62 31M26 31 62 50M26 50 62 12" class="s-crta"/>`,
  uljez: `<rect x="4" y="20" width="17" height="17" rx="3"/><rect x="25" y="20" width="17" height="17" rx="3"/><rect x="46" y="20" width="17" height="17" rx="3" class="s-med"/><rect x="67" y="20" width="17" height="17" rx="3"/><path d="M48 22l13 13M61 22 48 35" class="s-crta"/>`,
  scena: `<rect x="4" y="2" width="80" height="54" rx="4"/><rect x="24" y="6" width="40" height="8" rx="2" class="s-jaka"/><rect x="8" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="23" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="38" y="40" width="12" height="12" rx="2"/><rect x="53" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="68" y="40" width="12" height="12" rx="2"/>`,
  percepcija: `<rect x="4" y="20" width="17" height="17" rx="3"/><rect x="25" y="20" width="17" height="17" rx="3"/><rect x="46" y="20" width="17" height="17" rx="3" class="s-med"/><rect x="67" y="20" width="17" height="17" rx="3"/><path d="M9 33l6-9 4 9zM30 33l6-9 4 9zM50 24h10l-5 9zM72 33l6-9 4 9z" class="s-crta"/>`,
  prvi_glas: `<circle cx="22" cy="29" r="20"/><path d="M22 9v40M2 29h40M8 15l28 28M36 15 8 43" class="s-crta"/><circle cx="22" cy="29" r="5" class="s-med"/><path d="M22 5l-3-5h6z" class="s-jaka"/><rect x="50" y="8" width="10" height="10" rx="2" class="s-med"/><rect x="63" y="8" width="10" height="10" rx="2"/><rect x="76" y="8" width="10" height="10" rx="2"/><rect x="50" y="24" width="10" height="10" rx="2"/><rect x="63" y="24" width="10" height="10" rx="2" class="s-med"/><rect x="76" y="24" width="10" height="10" rx="2"/><rect x="50" y="40" width="10" height="10" rx="2"/><rect x="63" y="40" width="10" height="10" rx="2"/><rect x="76" y="40" width="10" height="10" rx="2" class="s-med"/>`,
  slogovi: `<rect x="6" y="4" width="18" height="18" rx="3" class="s-med"/><rect x="35" y="4" width="18" height="18" rx="3"/><rect x="64" y="4" width="18" height="18" rx="3" class="s-med"/><circle cx="10" cy="30" r="3" class="s-jaka"/><circle cx="18" cy="30" r="3"/><circle cx="39" cy="30" r="3" class="s-jaka"/><circle cx="47" cy="30" r="3" class="s-jaka"/><circle cx="68" cy="30" r="3" class="s-jaka"/><circle cx="76" cy="30" r="3"/><path d="M8 46h40M8 53h14" class="s-crta"/>`,
  listic: `<rect x="8" y="4" width="20" height="16" rx="3"/><rect x="34" y="4" width="20" height="16" rx="3"/><rect x="60" y="4" width="20" height="16" rx="3"/><rect x="8" y="26" width="20" height="16" rx="3"/><rect x="34" y="26" width="20" height="16" rx="3"/><rect x="60" y="26" width="20" height="16" rx="3"/><path d="M10 48h16M36 48h16M62 48h16" class="s-crta"/>`,
};
---
<AdminOkvir naslov="Predlošci zadataka" aktivno="predlosci">
  <div class="naslov">
    <div>
      <h1>Predlošci zadataka</h1>
      <p class="podnaslov">Svaki gumb odmah složi zadatak iz kataloga, a onda ga urediš (i područje). Napravljeni su pod <a href="/admin/zadaci">Gotovi zadaci</a>.</p>
    </div>
  </div>

  {prazno && <p class="ploha upozorenje">Za te glasove katalog nema nijednu riječ sa slikom.</p>}

      <div class="vrste">
        {poRedu.map(([kod, v]) => (
          <form class="ploha vrsta" method="post" action="/admin/api/zadatak">
            <input type="hidden" name="vrsta" value={kod} />
            <input type="hidden" name="podrucje" value={podrucjeVrste(kod)?.id ?? ""} />
            <svg class="shema" viewBox="0 0 88 58" aria-hidden="true" set:html={shema[kod]} />
            <div>
              <b>{v.naziv}</b>
              <p>{v.opis}</p>
            </div>
            <div class="gumbi">
              {gumbi[kod].map((g) => <button class="gumb glavni mali" type="submit" name={g.nacin ? "nacin" : undefined} value={g.nacin}>{g.tekst}</button>)}
              {kod === "listic" && <button class="gumb mali" type="button" data-otvori="listic-dijalog">Po glasovima…</button>}
            </div>
          </form>
        ))}
      </div>

  <dialog id="listic-dijalog" class="dijalog">
    <form class="listic" method="post" action="/admin/api/zadatak">
      <input type="hidden" name="vrsta" value="listic" />
      <input type="hidden" name="podrucje" value={listicPodrucje} />
      <h2>Radni listić po glasovima</h2>
      <div class="glas">
        <fieldset>
          <legend>Riječ ima glas <span class="blijedo">(jedan ili više; bez odabira slike iz cijelog kataloga)</span></legend>
          <div class="cipovi">
            {listic.glasovi.map((g) => <label class="cip"><input type="checkbox" name="glas" value={g.id} /><span>{g.oznaka}</span></label>)}
          </div>
        </fieldset>
        <label class="pozicija">Pozicija
          <select name="pozicija" disabled>{pozicije.map(([k, n]) => <option value={k}>{n}</option>)}</select>
        </label>
        <fieldset>
          <legend>Bez glasova <span class="blijedo">(nijedna riječ ih nema nigdje)</span></legend>
          <div class="cipovi">
            {suglasnici.map((g) => <label class="cip bez"><input type="checkbox" name="bez" value={g} /><span>{g}</span></label>)}
          </div>
        </fieldset>
        <label class="pozicija">Broj slika
          <select name="broj">
            {BROJEVI_LISTICA.map((n) => <option value={n} selected={n === ZADANO_SLIKA}>{n}</option>)}
            <option value="sve">Sve koje odgovaraju</option>
          </select>
        </label>
        <p class="ishod" aria-live="polite"></p>
        <script type="application/json" id="listic-rijeci" set:html={listicJson}></script>
      </div>
      <div class="gumbi desno">
        <button class="gumb mali" type="button" data-zatvori>Odustani</button>
        <button class="gumb glavni mali" type="submit">Napravi</button>
      </div>
    </form>
  </dialog>
</AdminOkvir>

<script>
  // Listić po glasovima: pozicija vrijedi uz odabrane glasove; ispod piše koliko će slika biti (isto pravilo kao poslužitelj).
  import { brojSlika, naslovListica, odgovara, type RijecGlasova } from "../../lib/zadaci/listic-glas";
  import { MAX_KARTICA_LISTICA } from "../../lib/zadaci/vrste";
  const dijalog = document.getElementById("listic-dijalog") as HTMLDialogElement | null;
  document.querySelectorAll<HTMLButtonElement>("[data-otvori]").forEach((b) => b.addEventListener("click", () => dijalog?.showModal()));
  dijalog?.querySelector("[data-zatvori]")?.addEventListener("click", () => dijalog.close());
  // Klik na zatamnjenu pozadinu zatvara.
  dijalog?.addEventListener("click", (e) => { if (e.target === dijalog) dijalog.close(); });
  const forma = document.querySelector<HTMLFormElement>("form.listic");
  const podaci = document.getElementById("listic-rijeci");
  if (forma && podaci) {
    const rijeci: RijecGlasova[] = JSON.parse(podaci.textContent ?? "[]");
    const poz = forma.querySelector("select[name=pozicija]") as unknown as HTMLSelectElement;
    const ishod = forma.querySelector(".ishod") as HTMLElement;
    const gumb = forma.querySelector("button[type=submit]") as HTMLButtonElement;
    const odabrani = (ime: string) => [...forma.querySelectorAll<HTMLInputElement>(`input[name=${ime}]:checked`)];
    const osvjezi = () => {
      const g = odabrani("glas"), bez = odabrani("bez").map((x) => x.value);
      poz.disabled = !g.length;
      const f = { glasovi: g.map((x) => Number(x.value)), pozicija: g.length ? poz.value : "", bez };
      const zeli = brojSlika((forma.querySelector("select[name=broj]") as unknown as HTMLSelectElement).value, MAX_KARTICA_LISTICA);
      const n = !g.length && !bez.length ? rijeci.length : rijeci.filter((r) => odgovara(r, f)).length;
      const naslov = naslovListica(g.map((x) => x.nextElementSibling!.textContent!), f.pozicija, bez);
      const sto = !g.length && !bez.length ? "Iz cijelog kataloga" : `„${naslov}”`;
      ishod.textContent = !n ? "Nijedna riječ sa slikom ne odgovara."
        : n > zeli ? `${sto}: ${zeli} nasumičnih od ${n} slika.`
        : `${sto}: ${n === 1 ? "1 slika" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? `sve ${n} slike` : `svih ${n} slika`}, abecedno.`;
      gumb.disabled = !n;
    };
    forma.addEventListener("change", osvjezi);
    osvjezi();
  }
</script>

<style>
  .gumbi { margin-top: auto; display: flex; flex-wrap: wrap; gap: 8px; }
  .gumbi.desno { justify-content: flex-end; margin-top: 18px; }
  .dijalog { width: min(620px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 22px; border: 1px solid var(--rub); border-radius: 16px;
    background: var(--povrsina); color: var(--tinta); }
  .dijalog::backdrop { background: rgb(0 0 0 / .45); }
  .dijalog h2 { margin: 0 0 16px; font-size: 1.1rem; }
  .glas { display: flex; flex-direction: column; gap: 12px; }
  .glas fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  .glas legend { padding: 0; margin-bottom: 6px; font-size: .8rem; font-weight: 650; color: var(--tinta); }
  .glas legend .blijedo { font-weight: 500; }
  .cipovi { display: flex; flex-wrap: wrap; gap: 6px; }
  .cip { margin: 0; cursor: pointer; }
  .cip input { position: absolute; opacity: 0; pointer-events: none; }
  .cip span { display: inline-grid; place-items: center; min-width: 38px; height: 34px; padding: 0 9px; border: 1px solid var(--rub-jak); border-radius: 9px;
    background: var(--povrsina); color: var(--tinta); font-weight: 700; font-size: .92rem; }
  .cip:hover span { border-color: var(--med); }
  .cip input:focus-visible + span { outline: 2px solid var(--med); outline-offset: 2px; }
  .cip input:checked + span { background: var(--med); border-color: var(--med); color: var(--med-tekst); }
  .cip.bez input:checked + span { background: var(--greska-blago); border-color: var(--greska); color: var(--greska); text-decoration: line-through; }
  .pozicija { display: flex; align-items: center; gap: 10px; margin: 0; color: var(--tinta); }
  .pozicija select { flex: 0 1 260px; height: 34px; }
  .pozicija select:disabled { opacity: .5; }
  .ishod { margin: 0 !important; color: var(--tinta) !important; font-weight: 600; }
  .upozorenje { margin: 18px 0 0; padding: 12px 16px; border-color: var(--med); }
  .vrste { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .vrsta { margin: 0; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .vrsta p { margin: 4px 0 0; color: var(--blijedo); font-size: .86rem; }
  .shema { width: 100%; height: 74px; padding: 8px; border-radius: 10px; background: var(--povrsina-2); }
  .shema :global(rect) { fill: var(--povrsina); stroke: var(--rub-jak); stroke-width: 1.4; }
  .shema :global(.s-jaka) { fill: var(--med-blago); stroke: var(--med); }
  .shema :global(.s-med) { stroke: var(--med); stroke-width: 2.2; }
  .shema :global(.s-crta) { fill: none; stroke: var(--med); stroke-width: 1.6; stroke-linecap: round; }
  select { flex: 1; height: 34px; min-width: 0; font: inherit; font-size: .84rem; padding: 0 8px; border: 1px solid var(--rub-jak); border-radius: 8px; background: var(--povrsina); color: var(--tinta); }
</style>
