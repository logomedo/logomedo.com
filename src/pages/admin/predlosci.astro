---
import AdminOkvir from "../../components/AdminOkvir.astro";
import { logopedskiMod, podrucja as svaPodrucja, zaListic } from "../../lib/zadaci/baza";
import { BROJEVI_LISTICA, jePoGlasovima, ZADANO_SLIKA } from "../../lib/zadaci/listic-glas";
import { ODNOSI, ODNOSI_POPIS, odnosiZa, type Odnos } from "../../lib/zadaci/odnosi";
import { ABECEDA, BROJ_STAVKI, PRAVILA_RAZVRSTAVANJA, VRSTE, type PraviloRazvrstavanja, type Vrsta } from "../../lib/zadaci/vrste";

const [podrucja, listic, mod] = await Promise.all([svaPodrucja(), zaListic(), logopedskiMod(Astro.locals.admin!.email)]);
// Isključuju se suglasnici (po fonemima, pa „bez L” ne dira LJ).
const suglasnici = ABECEDA.filter((g) => !"AEIOU".includes(g));
const listicJson = JSON.stringify(listic.rijeci).replace(/</g, "\\u003c");
const prazno = Astro.url.searchParams.has("prazno");
const pozicije = [["", "Bilo gdje u riječi"], ["inicijalna", "Inicijalna (početak)"], ["medijalna", "Medijalna (sredina)"], ["finalna", "Finalna (kraj)"], ["skupina", "Skupine"]];
const listovi = podrucja.filter((p) => p.roditelj_id !== null);
const zadano: Record<Vrsta, string> = { listic: "listici", odabir: "rima", povezivanje: "rima", uljez: "rima", scena: "situacije", percepcija: "vizualna-percepcija", prvi_glas: "prvi-glas", slogovi: "slogovi", razvrstavanje: "razvrstavanje", koje_slovo: "glas-slovo", pozicija_glasa: "pozicija-glasa" };
// Vrsta u izradi (editor, ispis i igra još nisu gotovi) se ne nudi.
const U_IZRADI: Vrsta[] = [];
const vrste = (Object.entries(VRSTE) as [Vrsta, (typeof VRSTE)[Vrsta]][]).filter(([kod]) => !U_IZRADI.includes(kod));
// Svaka vrsta ide u svoje podpodručje (ono je samo oznaka; mijenja se u uređivaču), a gumbi su njezine inačice.
const gumbi: Record<Vrsta, { tekst: string; nacin?: string }[]> = {
  listic: [{ tekst: "Iz cijelog kataloga" }],
  slogovi: [{ tekst: "Slogovi u riječi", nacin: "analiza" }, { tekst: "Glasovi u riječi", nacin: "glasovi" }, { tekst: "Dugačke i kratke riječi", nacin: "duljina" }],
  // Uparivanje, povezivanje i uljez: jedan gumb po odnosu (rima, isti prvi glas…).
  ...Object.fromEntries((["odabir", "povezivanje", "uljez"] as const).map((v) => [v, odnosiZa(v).map((o) => ({ tekst: ODNOSI[o].naziv, nacin: o }))])) as Record<"odabir" | "povezivanje" | "uljez", { tekst: string; nacin: string }[]>,
  percepcija: [{ tekst: "Nađi različitu", nacin: "razlicitu" }, { tekst: "Nađi dvije iste", nacin: "par" }],
  prvi_glas: [{ tekst: "Kolo slova" }], scena: [{ tekst: "Nova scena" }],
  razvrstavanje: (Object.keys(PRAVILA_RAZVRSTAVANJA) as PraviloRazvrstavanja[]).map((nacin) => ({ tekst: PRAVILA_RAZVRSTAVANJA[nacin].naziv, nacin })),
  koje_slovo: [{ tekst: "Nasumični glasovi" }], pozicija_glasa: [{ tekst: "Nasumičan glas" }],
};
const podrucjeVrste = (kod: Vrsta) => listovi.find((p) => p.slug === zadano[kod]);
// Odnos ima svoje podpodručje (rima u „Prepoznavanje rime”, prvi glas u „Prvi glas u riječi”…); bez para ostaje prazno.
const podrucjeOdnosa: Record<Odnos, string | null> = { rima: "rima", pocetni_glas: "prvi-glas", pocetni_slog: "slogovi", zavrsni_glas: null, ista_rijec: null };
const idPodrucjaOdnosa = (o: string) => String(listovi.find((p) => p.slug === podrucjeOdnosa[o as Odnos])?.id ?? "");
// Jedna mreža, redom podpodručja (bez naslova po glavnim područjima); vrste bez podpodručja na kraju.
const poRedu = [...listovi.flatMap((l) => vrste.filter(([kod]) => podrucjeVrste(kod)?.id === l.id)), ...vrste.filter(([kod]) => !podrucjeVrste(kod))];
// Naslov dijaloga „Po glasovima…” za svaku vrstu.
const naslovDijaloga: Record<string, string> = {
  listic: "Radni listić po glasovima", slogovi: "Prebrajanje po glasovima", odabir: "Uparivanje po glasovima",
  povezivanje: "Povezivanje po glasovima", uljez: "Izbaci uljeza po glasovima", prvi_glas: "Prvi glas: kolo staje na odabranim glasovima",
};

// Mala shema rasporeda svake vrste (kvadratići = slike).
const shema: Record<Vrsta, string> = {
  koje_slovo: `<path d="M8 10h4l5-4v14l-5-4H8z" class="s-jaka"/><path d="M21 9a5 5 0 0 1 0 8" class="s-crta"/><text x="36" y="20" class="s-slovo">S</text><text x="62" y="16" class="s-slovo" transform="rotate(14 62 16)">Š</text><text x="14" y="44" class="s-slovo" transform="rotate(-12 14 44)">Z</text><text x="44" y="50" class="s-slovo s-med">C</text><text x="72" y="44" class="s-slovo" transform="rotate(10 72 44)">Č</text><circle cx="40" cy="44" r="10" class="s-crta"/>`,
  pozicija_glasa: `<rect x="29" y="2" width="30" height="30" rx="4"/><circle cx="24" cy="46" r="8" class="s-crta"/><circle cx="44" cy="46" r="8" class="s-jaka"/><circle cx="64" cy="46" r="8" class="s-crta"/>`,
  razvrstavanje: `<rect x="8" y="4" width="14" height="14" rx="3" class="s-med"/><rect x="26" y="4" width="14" height="14" rx="3"/><rect x="44" y="4" width="14" height="14" rx="3" class="s-med"/><rect x="62" y="4" width="14" height="14" rx="3"/><path d="M12 54c-3-10 0-18 6-20h12c6 2 9 10 6 20zM52 54c-3-10 0-18 6-20h12c6 2 9 10 6 20z"/><path d="M15 18l9 18M51 18l-21 18" class="s-crta"/>`,
  odabir: `<rect x="34" y="4" width="20" height="20" rx="4" class="s-jaka"/><rect x="6" y="34" width="20" height="20" rx="4"/><rect x="34" y="34" width="20" height="20" rx="4" class="s-med"/><rect x="62" y="34" width="20" height="20" rx="4"/>`,
  povezivanje: `<rect x="8" y="4" width="16" height="16" rx="3"/><rect x="8" y="23" width="16" height="16" rx="3"/><rect x="8" y="42" width="16" height="16" rx="3"/><rect x="64" y="4" width="16" height="16" rx="3"/><rect x="64" y="23" width="16" height="16" rx="3"/><rect x="64" y="42" width="16" height="16" rx="3"/><path d="M26 12 62 31M26 31 62 50M26 50 62 12" class="s-crta"/>`,
  uljez: `<rect x="4" y="20" width="17" height="17" rx="3"/><rect x="25" y="20" width="17" height="17" rx="3"/><rect x="46" y="20" width="17" height="17" rx="3" class="s-med"/><rect x="67" y="20" width="17" height="17" rx="3"/><path d="M48 22l13 13M61 22 48 35" class="s-crta"/>`,
  scena: `<rect x="4" y="2" width="80" height="54" rx="4"/><rect x="24" y="6" width="40" height="8" rx="2" class="s-jaka"/><rect x="8" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="23" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="38" y="40" width="12" height="12" rx="2"/><rect x="53" y="40" width="12" height="12" rx="2" class="s-med"/><rect x="68" y="40" width="12" height="12" rx="2"/>`,
  percepcija: `<rect x="4" y="20" width="17" height="17" rx="3"/><rect x="25" y="20" width="17" height="17" rx="3"/><rect x="46" y="20" width="17" height="17" rx="3" class="s-med"/><rect x="67" y="20" width="17" height="17" rx="3"/><path d="M9 33l6-9 4 9zM30 33l6-9 4 9zM50 24h10l-5 9zM72 33l6-9 4 9z" class="s-crta"/>`,
  prvi_glas: `<circle cx="22" cy="29" r="20"/><path d="M22 9v40M2 29h40M8 15l28 28M36 15 8 43" class="s-crta"/><circle cx="22" cy="29" r="5" class="s-med"/><path d="M22 5l-3-5h6z" class="s-jaka"/><rect x="50" y="8" width="10" height="10" rx="2" class="s-med"/><rect x="63" y="8" width="10" height="10" rx="2"/><rect x="76" y="8" width="10" height="10" rx="2"/><rect x="50" y="24" width="10" height="10" rx="2"/><rect x="63" y="24" width="10" height="10" rx="2" class="s-med"/><rect x="76" y="24" width="10" height="10" rx="2"/><rect x="50" y="40" width="10" height="10" rx="2"/><rect x="63" y="40" width="10" height="10" rx="2"/><rect x="76" y="40" width="10" height="10" rx="2" class="s-med"/>`,
  slogovi: `<rect x="6" y="4" width="18" height="18" rx="3" class="s-med"/><rect x="35" y="4" width="18" height="18" rx="3"/><rect x="64" y="4" width="18" height="18" rx="3" class="s-med"/><circle cx="10" cy="30" r="3" class="s-jaka"/><circle cx="18" cy="30" r="3"/><circle cx="39" cy="30" r="3" class="s-jaka"/><circle cx="47" cy="30" r="3" class="s-jaka"/><circle cx="68" cy="30" r="3" class="s-jaka"/><circle cx="76" cy="30" r="3"/><path d="M8 46h40M8 53h14" class="s-crta"/>`,
  listic: `<rect x="8" y="4" width="20" height="16" rx="3"/><rect x="34" y="4" width="20" height="16" rx="3"/><rect x="60" y="4" width="20" height="16" rx="3"/><rect x="8" y="26" width="20" height="16" rx="3"/><rect x="34" y="26" width="20" height="16" rx="3"/><rect x="60" y="26" width="20" height="16" rx="3"/><path d="M10 48h16M36 48h16M62 48h16" class="s-crta"/>`,
};
---
<AdminOkvir naslov="Predlošci zadataka" aktivno="predlosci">
  <div class="naslov">
    <div>
      <h1>Predlošci zadataka</h1>
      <p class="podnaslov">Svaki gumb odmah složi zadatak iz kataloga, a onda ga urediš (i područje). Napravljeni su pod <a href="/admin/zadaci">Gotovi zadaci</a>.</p>
    </div>
  </div>

  {prazno && <p class="ploha upozorenje">Za te glasove katalog nema dovoljno riječi sa slikom.</p>}

      <div class="vrste">
        {poRedu.map(([kod, v]) => (
          <form class="ploha vrsta" method="post" action="/admin/api/zadatak">
            <input type="hidden" name="vrsta" value={kod} />
            <input type="hidden" name="podrucje" value={podrucjeVrste(kod)?.id ?? ""} />
            <svg class="shema" viewBox="0 0 88 58" aria-hidden="true" set:html={shema[kod]} />
            <div>
              <b>{v.naziv}</b>
              <p>{v.opis}</p>
            </div>
            {BROJ_STAVKI[kod] && (
              <label class="broj">{BROJ_STAVKI[kod]!.naziv}
                <input type="number" name="stavki" inputmode="numeric" required min={BROJ_STAVKI[kod]!.min} max={BROJ_STAVKI[kod]!.max} value={BROJ_STAVKI[kod]!.zadano} />
                <span class="blijedo">do {BROJ_STAVKI[kod]!.max}</span>
              </label>
            )}
            <div class="gumbi">
              {gumbi[kod].map((g) => mod && VRSTE[kod].odnos
                // Logopedski mod: odnos otvara izbor glasova (bez odabira glasa složi se iz cijelog kataloga).
                ? <button class="gumb glavni mali" type="button" data-po-glasovima={kod} data-odnos={g.nacin} data-naslov={`${v.naziv}: ${g.tekst.toLocaleLowerCase("hr")}`}>{g.tekst}</button>
                : <button class="gumb glavni mali" type="submit" name={g.nacin ? "nacin" : undefined} value={g.nacin}
                  data-podrucje-gumba={VRSTE[kod].odnos && g.nacin ? idPodrucjaOdnosa(g.nacin) : undefined}>{g.tekst}</button>)}
              {mod && jePoGlasovima(kod) && !VRSTE[kod].odnos && <button class="gumb mali" type="button" data-po-glasovima={kod} data-podrucje={podrucjeVrste(kod)?.id ?? ""} data-naslov={naslovDijaloga[kod]}>Po glasovima…</button>}
            </div>
          </form>
        ))}
      </div>

  {mod && <dialog id="glas-dijalog" class="dijalog">
    <form class="listic" method="post" action="/admin/api/zadatak">
      <input type="hidden" name="vrsta" value="listic" />
      <input type="hidden" name="podrucje" value="" />
      <input type="hidden" name="po_glasovima" value="1" />
      <h2>Po glasovima</h2>
      <p class="objasnjenje" data-za="odabir povezivanje uljez">Za svaki odabrani glas jedan red (par): zadana (lijeva) slika ima taj glas, ostale su bilo koje u tom odnosu. Bez odabira glasa: odabrani broj nasumičnih iz cijelog kataloga.</p>
      <p class="objasnjenje" data-za="prvi_glas">Svaki odabrani glas je jedan krug (najviše 6): kolo stane na njemu, a dijete traži slike koje počinju tim glasom.</p>
      <div class="glas">
        <label class="pozicija" data-za="odabir povezivanje uljez">Odnos
          <select name="nacin" data-odnos>{ODNOSI_POPIS.map((o) => <option value={o} data-podrucje={idPodrucjaOdnosa(o)} data-bez-uljeza={o === "ista_rijec" ? "" : undefined}>{ODNOSI[o].naziv}</option>)}</select>
        </label>
        <fieldset>
          <legend><span data-za="listic slogovi odabir povezivanje uljez">Riječ ima glas <span class="blijedo">(jedan ili više; bez odabira iz cijelog kataloga)</span></span><span data-za="prvi_glas">Glasovi na kolu</span></legend>
          <div class="cipovi">
            {listic.glasovi.map((g) => <label class="cip"><input type="checkbox" name="glas" value={g.id} /><span>{g.oznaka}</span></label>)}
          </div>
        </fieldset>
        <label class="pozicija" data-za="listic slogovi odabir povezivanje uljez">Pozicija
          <select name="pozicija" disabled>{pozicije.map(([k, n]) => <option value={k}>{n}</option>)}</select>
        </label>
        <fieldset data-za="listic slogovi odabir povezivanje uljez">
          <legend>Bez glasova <span class="blijedo">(nijedna riječ ih nema nigdje)</span></legend>
          <div class="cipovi">
            {suglasnici.map((g) => <label class="cip bez"><input type="checkbox" name="bez" value={g} /><span>{g}</span></label>)}
          </div>
        </fieldset>
        <label class="pozicija" data-za="slogovi">Način
          <select name="nacin">
            <option value="analiza">Slogovi u riječi</option>
            <option value="glasovi">Glasovi u riječi</option>
            <option value="duljina">Dugačke i kratke riječi</option>
          </select>
        </label>
        <label class="pozicija" data-za="odabir povezivanje uljez slogovi"><span data-broj-naziv>Broj redova</span>
          <input type="number" name="stavki" inputmode="numeric" required min="1" max="30" value="4" />
        </label>
        <label class="pozicija" data-za="listic">Broj slika
          <select name="broj">
            {BROJEVI_LISTICA.map((n) => <option value={n} selected={n === ZADANO_SLIKA}>{n}</option>)}
            <option value="sve">Sve koje odgovaraju</option>
          </select>
        </label>
        <p class="ishod" aria-live="polite"></p>
        <script type="application/json" id="listic-rijeci" set:html={listicJson}></script>
      </div>
      <div class="gumbi desno">
        <button class="gumb mali" type="button" data-zatvori>Odustani</button>
        <button class="gumb glavni mali" type="submit">Napravi</button>
      </div>
    </form>
  </dialog>}
</AdminOkvir>

<script>
  // „Po glasovima…”: isti dijalog za sve predloške koji ga imaju; vidljiva su polja te vrste (`data-za`),
  // a ispod piše koliko će građe biti (isto pravilo kao poslužitelj).
  import { brojSlika, moguce, naslovListica, poPrvomGlasu, rasporedOdnosa, type RijecGlasova, type VrstaPoGlasovima } from "../../lib/zadaci/listic-glas";
  import { brojStavki, MAX_KARTICA_LISTICA } from "../../lib/zadaci/vrste";
  import { ODNOSI, type Odnos } from "../../lib/zadaci/odnosi";
  // Gumb odnosa (Isti prvi glas…) šalje i podpodručje tog odnosa.
  document.querySelectorAll<HTMLButtonElement>("button[data-podrucje-gumba]").forEach((b) => b.addEventListener("click", () => {
    (b.form!.elements.namedItem("podrucje") as HTMLInputElement).value = b.dataset.podrucjeGumba ?? "";
  }));
  const dijalog = document.getElementById("glas-dijalog") as HTMLDialogElement | null;
  const forma = dijalog?.querySelector<HTMLFormElement>("form.listic");
  const podaci = document.getElementById("listic-rijeci");
  if (dijalog && forma && podaci) {
    const rijeci: RijecGlasova[] = JSON.parse(podaci.textContent ?? "[]");
    const polje = (ime: string) => forma.querySelector(`[name=${ime}]`) as unknown as HTMLInputElement | HTMLSelectElement;
    const poz = polje("pozicija") as HTMLSelectElement;
    const ishod = forma.querySelector(".ishod") as HTMLElement;
    const gumb = forma.querySelector("button[type=submit]") as HTMLButtonElement;
    const odabrani = (ime: string) => [...forma.querySelectorAll<HTMLInputElement>(`input[name=${ime}]:checked`)];
    let vrsta: VrstaPoGlasovima = "listic";
    const mnozina = (n: number, jedan: string, dva: string, pet: string) =>
      `${n} ${n % 10 === 1 && n % 100 !== 11 ? jedan : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? dva : pet}`;
    const osvjezi = () => {
      const g = odabrani("glas"), bez = odabrani("bez").map((x) => x.value);
      const oznake = g.map((x) => x.nextElementSibling!.textContent!);
      poz.disabled = !g.length || vrsta === "prvi_glas";
      const f = { glasovi: g.map((x) => Number(x.value)), pozicija: g.length ? poz.value : "", bez };
      const sto = !g.length && !bez.length ? "Iz cijelog kataloga" : `„${naslovListica(oznake, f.pozicija, bez)}”`;
      let tekst = "", moze = true;
      if (vrsta === "prvi_glas") {
        const n = poPrvomGlasu(rijeci, oznake);
        const ima = oznake.filter((o) => n[o] > 0);
        moze = ima.length > 0;
        tekst = !oznake.length ? "Odaberi barem jedan glas." : !moze ? "Nijedna riječ sa slikom ne počinje tim glasovima."
          : `${mnozina(Math.min(ima.length, 6), "krug", "kruga", "krugova")}: ${oznake.map((o) => `${o} ${mnozina(n[o], "slika", "slike", "slika")}`).join(", ")}.`
            + (ima.length > 6 ? " Uzima se prvih 6." : "") + (ima.length < oznake.length ? " Glas bez slika se preskače." : "");
      } else if (vrsta === "listic") {
        const n = moguce("listic", rijeci, f), zeli = brojSlika(polje("broj").value, MAX_KARTICA_LISTICA);
        moze = n > 0;
        tekst = !n ? "Nijedna riječ sa slikom ne odgovara."
          : n > zeli ? `${sto}: ${zeli} nasumičnih od ${n} slika.`
          : `${sto}: ${n === 1 ? "1 slika" : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? `sve ${n} slike` : `svih ${n} slika`}, abecedno.`;
      } else if (vrsta === "slogovi") {
        const n = moguce("slogovi", rijeci, f), zeli = brojStavki("slogovi", polje("stavki").value);
        moze = n >= 2;
        tekst = !n ? "Nijedna riječ sa slikom ne odgovara." : n < 2 ? `${sto}: samo 1 riječ, treba barem 2.`
          : `${sto}: ${mnozina(Math.min(n, zeli), "slika", "slike", "slika")}${n > zeli ? ` nasumično od ${n}` : ""}.`;
      } else {
        const izbor = forma.querySelector("select[data-odnos]") as unknown as HTMLSelectElement;
        const odnos = izbor.value as Odnos;
        polje("podrucje").value = izbor.selectedOptions[0]?.dataset.podrucje ?? "";
        const { redova, mogucih, prazni } = rasporedOdnosa(vrsta, rijeci, f, odnos, brojStavki(vrsta, polje("stavki").value));
        const [jedan, dva, pet] = vrsta === "povezivanje" ? ["par", "para", "parova"] : ["red", "reda", "redova"];
        const skupina = ODNOSI[odnos].skupina, treba = vrsta === "uljez" ? "3 riječi" : "2 riječi";
        const bezGlasa = prazni.map((id) => oznake[g.findIndex((x) => Number(x.value) === id)]);
        moze = redova > 0;
        tekst = !redova ? `${sto}: nema nijedne skupine ${skupina} od ${treba} s tim glasom.`
          : !g.length ? `${sto}: ${mnozina(redova, jedan, dva, pet)}${mogucih > redova ? ` od ${mogucih} mogućih` : ""}.`
          : `${sto}: ${mnozina(redova, jedan, dva, pet)}` + (g.length > 1 && !prazni.length ? (redova === g.length ? ", po jedan za svaki glas" : ", redom po glasovima") : "") + "."
            + (bezGlasa.length ? ` Za ${bezGlasa.join(", ")} nema skupine ${skupina} od ${treba}.` : "")
            + (vrsta === "povezivanje" && g.length > 8 ? " Najviše 8 parova." : "");
      }
      ishod.textContent = tekst;
      gumb.disabled = !moze;
    };
    document.querySelectorAll<HTMLButtonElement>("[data-po-glasovima]").forEach((b) => b.addEventListener("click", () => {
      vrsta = b.dataset.poGlasovima as VrstaPoGlasovima;
      polje("vrsta").value = vrsta;
      polje("podrucje").value = b.dataset.podrucje ?? "";
      forma.querySelector("h2")!.textContent = b.dataset.naslov ?? "Po glasovima";
      // „Riječ i slika” nema uljeza.
      forma.querySelectorAll<HTMLOptionElement>("option[data-bez-uljeza]").forEach((o) => { o.hidden = o.disabled = vrsta === "uljez"; });
      // Broj redova (parova, slika) preuzme s kartice predloška, s njezinim granicama.
      const sKartice = b.form?.querySelector<HTMLInputElement>("input[name=stavki]"), broj = polje("stavki") as HTMLInputElement;
      if (sKartice) {
        broj.min = sKartice.min; broj.max = sKartice.max; broj.value = sKartice.value;
        forma.querySelector("[data-broj-naziv]")!.textContent = sKartice.closest("label")!.firstChild!.textContent!.trim();
      }
      if (b.dataset.odnos) { (forma.querySelector("select[data-odnos]") as unknown as HTMLSelectElement).value = b.dataset.odnos; pozicijaOdnosa(); }
      forma.querySelectorAll<HTMLElement>("[data-za]").forEach((el) => {
        const vidi = el.dataset.za!.split(" ").includes(vrsta);
        el.hidden = !vidi;
        // Skrivena polja se ne šalju (inače bi npr. „bez” s listića ostao u prvom glasu).
        el.querySelectorAll<HTMLInputElement>("input, select").forEach((x) => { if (x.name !== "pozicija") x.disabled = !vidi; });
      });
      osvjezi();
      dijalog.showModal();
    }));
    dijalog.querySelector("[data-zatvori]")?.addEventListener("click", () => dijalog.close());
    // Klik na zatamnjenu pozadinu zatvara.
    dijalog.addEventListener("click", (e) => { if (e.target === dijalog) dijalog.close(); });
    // Odnos određuje gdje glas ima smisla: prvi glas i slog na početku, zadnji glas na kraju, rima bilo gdje.
    // Ide prije osvježavanja forme (događaj s izbornika stigne do forme poslije).
    const POZICIJA_ODNOSA: Record<Odnos, string> = { rima: "", pocetni_glas: "inicijalna", pocetni_slog: "inicijalna", zavrsni_glas: "finalna", ista_rijec: "" };
    function pozicijaOdnosa() {
      const o = (forma!.querySelector("select[data-odnos]") as unknown as HTMLSelectElement).value as Odnos;
      poz.value = POZICIJA_ODNOSA[o] ?? "";
    }
    forma.querySelector("select[data-odnos]")?.addEventListener("change", pozicijaOdnosa);
    forma.addEventListener("change", osvjezi);
    forma.addEventListener("input", (e) => { if ((e.target as HTMLInputElement).name === "stavki") osvjezi(); });
  }
</script>

