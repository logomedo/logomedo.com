---
// Pregled kandidata jedan po jedan, tipkovnicom: A odobri, X odbij (što ne valja + kako treba, Enter),
// P slika je za drugu riječ (premjesti, po potrebi nova riječ),
// D riječ ne postoji (obriši je sa svim slikama), S preskoči, Z poništi zadnju odluku. Odbijena slika šalje novu u red samo ako riječ nema
// odobrenu ni drugog kandidata. Više admina istovremeno: svake 3 s popis se usklađuje s bazom
// (tuđe odluke nestaju, novi kandidati dolaze na kraj), a server pamti samo prvu odluku.
import AdminOkvir from "../../components/AdminOkvir.astro";
import Ikona from "../../components/Ikona.astro";
import { kandidati } from "../../lib/pregled";

const glas = Astro.url.searchParams.get("glas");
const results = await kandidati(glas);
---
<AdminOkvir naslov="Pregled" aktivno="pregled" puno>
  <>
    <div class="pregled" id="pregled" data-kandidati={JSON.stringify(results)} data-glas={glas ?? ""} hidden={!results.length}>
      <div class="pozornica">
        <div class="list"><img id="slika" alt="" /></div>
        <div class="usporedba" id="usporedba" hidden>
          <span>Sadašnja odobrena</span>
          <div class="list mali"><img id="slika-odobrena" alt="" /></div>
        </div>
      </div>
      <aside class="ploca">
        <div class="napredak"><span id="brojac"></span><div class="traka-napretka"><i id="traka"></i></div></div>
        <h1 id="rijec" class="rijec"></h1>
        <p id="pozicije" class="blijedo"></p>
        <p id="opis" class="opis" hidden></p>

        <div class="tipke">
          <button class="gumb glavni veliki" id="odobri"><kbd>A</kbd> Odobri</button>
          <button class="gumb veliki" id="odbij"><kbd>X</kbd> Odbij</button>
          <form class="razlog" id="razlog-okvir" hidden>
            <label>Što ne valja?
              <input type="text" id="razlog" maxlength="300" placeholder="npr. Ovo je mačka, a ne mač" /></label>
            <label>Kako treba biti?
              <input type="text" id="dorada" maxlength="300" placeholder="npr. Strelica pokazuje na rep" /></label>
            <label class="kvacica"><input type="checkbox" id="trajno" /> Zapamti „kako treba” kao opis riječi (za sve buduće slike)</label>
            <label class="kvacica"><input type="checkbox" id="ponovi" checked /> <span id="ponovi-tekst">Generiraj novu</span></label>
            <div class="red-gumba"><button class="gumb glavni" type="submit">Odbij</button>
              <span class="blijedo sitno"><kbd>Tab</kbd> sljedeće polje · <kbd>Enter</kbd> potvrdi · <kbd>Esc</kbd> odustani</span></div>
          </form>
          <button class="gumb veliki" id="premjesti"><kbd>P</kbd> Slika je za drugu riječ</button>
          <form class="razlog" id="premjesti-okvir" hidden>
            <label>Koja je riječ na slici?
              <input type="text" id="cilj" maxlength="40" list="sve-rijeci" autocomplete="off" placeholder="npr. mačić" /></label>
            <datalist id="sve-rijeci"></datalist>
            <p class="sitno" id="cilj-info" hidden></p>
            <label><span id="dorada2-naslov">Kako treba biti za ovu riječ?</span>
              <input type="text" id="dorada2" maxlength="300" placeholder="npr. Mač je oružje (sword), ne mačka" /></label>
            <label class="kvacica"><input type="checkbox" id="trajno2" /> Zapamti kao opis riječi (za sve buduće slike)</label>
            <label class="kvacica"><input type="checkbox" id="ponovi2" checked /> <span id="ponovi2-tekst">Generiraj novu</span></label>
            <div class="red-gumba"><button class="gumb glavni" type="submit">Premjesti</button>
              <span class="blijedo sitno"><kbd>Enter</kbd> potvrdi · <kbd>Esc</kbd> odustani</span></div>
          </form>
          <button class="gumb veliki opasno" id="obrisi"><kbd>D</kbd> Riječ ne postoji, obriši je</button>
          <form class="razlog" id="obrisi-okvir" hidden>
            <p class="sitno" id="obrisi-tekst"></p>
            <div class="red-gumba"><button class="gumb glavni opasno" type="submit">Obriši riječ</button>
              <span class="blijedo sitno"><kbd>Enter</kbd> potvrdi · <kbd>Esc</kbd> odustani</span></div>
          </form>
          <div class="sporedne">
            <button class="gumb tihi" id="preskoci"><kbd>S</kbd> Preskoči</button>
            <button class="gumb tihi" id="ponisti" disabled><kbd>Z</kbd> Poništi</button>
          </div>
        </div>

        <details class="prompt"><summary>Prompt</summary><p id="prompt" class="mono"></p></details>
        <a id="link" class="sitno blijedo" href="#">Otvori riječ →</a>
        <p id="poruka" class="poruka" hidden></p>
      </aside>
    </div>
    <div class="gotovo" id="gotovo" hidden={results.length > 0}>
      <div class="ploha prazno">
        <h2 id="gotovo-naslov">{results.length ? "Sve pregledano" : "Nema kandidata za pregled"}</h2>
        <p>Novi kandidati stižu dok runner radi i pojavljuju se ovdje sami.</p>
        <a class="gumb" href="/admin"><Ikona ime="katalog" /> Katalog</a>
      </div>
    </div>
  </>
</AdminOkvir>

<script>
  type K = { id: number; prompt: string | null; model: string | null; rijec: string; slug: string; opis_za_sliku: string | null; odobrena_id: number | null; pozicije: string };
  type Odluka = { id: number; status: string; pregledao: string | null };
  const el = document.getElementById("pregled")!;
  // `prosli` su već prikazani (odlučeni ili preskočeni) u ovoj kartici; `red` su preostali, red[0] je na ekranu.
  let red: K[] = JSON.parse(el.dataset.kandidati!);
  const glas = el.dataset.glas || "";
  const ja = (document.querySelector(".tko") as HTMLElement | null)?.title ?? "";
  const prosli = new Set<number>();
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const povijest: K[] = [];
  let zauzeto = false;
  let prikazana: number | null = null;

  const tko = (email: string | null) => (email ? email.split("@")[0] : "netko");
  const opisOdluke = (o: { status: string; pregledao: string | null }) =>
    `${o.pregledao === ja ? "Već si" : tko(o.pregledao) + " je već"} ${o.status === "odobrena" ? "odobrio/la" : o.status === "odbijena" ? "odbio/la" : "promijenio/la"} ovu sliku.`;

  function prikazi() {
    const k = red[0];
    el.hidden = !k; $("gotovo").hidden = !!k;
    $<HTMLButtonElement>("ponisti").disabled = !povijest.length;
    if (!k) { prikazana = null; return; }
    if (prikazana === k.id) return;            // ista slika: ne diraj (razlog koji se upisuje ostaje)
    prikazana = k.id;
    $<HTMLImageElement>("slika").src = `/admin/slika/${k.id}`;
    $("usporedba").hidden = !k.odobrena_id;
    if (k.odobrena_id) $<HTMLImageElement>("slika-odobrena").src = `/admin/slika/${k.odobrena_id}`;
    $("rijec").textContent = k.rijec.toLocaleUpperCase("hr");
    $("pozicije").textContent = k.pozicije ?? "";
    $("opis").hidden = !k.opis_za_sliku; $("opis").textContent = k.opis_za_sliku ?? "";
    $("prompt").textContent = k.prompt ?? "";
    $<HTMLAnchorElement>("link").href = `/admin/rijec/${k.slug}?od=/admin/pregled`;
    brojac();
    zatvoriPanele();
    const R = k.rijec.toLocaleUpperCase("hr");
    $("dorada2-naslov").textContent = `Kako treba biti ${R}?`;
    $("ponovi2-tekst").textContent = `Generiraj novu za ${R}`;
    $<HTMLInputElement>("ponovi2").checked = !k.odobrena_id;
    // Riječ s odobrenom slikom: odbijanje suvišnog kandidata ne traži novu sliku.
    $<HTMLInputElement>("ponovi").checked = !k.odobrena_id && red.filter((x) => x.slug === k.slug).length < 2;
    $("ponovi-tekst").textContent = k.odobrena_id ? "Generiraj novu (riječ već ima odobrenu)" : "Generiraj novu";
    if (red[1]) new Image().src = `/admin/slika/${red[1].id}`;
  }
  function brojac() {
    const ukupno = prosli.size + red.length;
    $("brojac").textContent = `${prosli.size + 1} / ${ukupno}`;
    $("traka").style.width = `${ukupno ? (prosli.size / ukupno) * 100 : 0}%`;
  }
  const dalje = () => { const k = red.shift(); if (k) prosli.add(k.id); prikazi(); };

  let porukaTimer = 0;
  const poruka = (t: string, vrsta: "greska" | "info" = "greska") => {
    const p = $("poruka"); p.textContent = t; p.hidden = false; p.dataset.vrsta = vrsta;
    clearTimeout(porukaTimer); porukaTimer = window.setTimeout(() => (p.hidden = true), 5000);
  };

  async function posalji(id: number, tijelo: Record<string, unknown>) {
    const r = await fetch(`/admin/api/slika/${id}`, { method: "POST", credentials: "same-origin",
      headers: { "content-type": "application/json" }, body: JSON.stringify(tijelo) });
    if (r.status === 401) throw new Error("Sesija je istekla, prijavi se ponovno.");
    const j: any = await r.json().catch(() => ({}));
    if (r.status === 409 && j.vec) return { vec: j.vec as Odluka };
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    return { vec: null, generira: !!j.generira };
  }

  const v = (id: string) => $<HTMLInputElement>(id).value;
  const kv = (id: string) => ($<HTMLInputElement>(id).checked ? "1" : "");

  async function odluci(akcija: "odobri" | "odbij") {
    const k = red[0];
    if (zauzeto || !k) return;
    zauzeto = true;
    try {
      const o = await posalji(k.id, akcija === "odbij"
        ? { akcija, razlog: v("razlog"), dorada: v("dorada"), trajno: kv("trajno"), ponovi: kv("ponovi") }
        : { akcija });
      if (o.vec) poruka(opisOdluke(o.vec), "info");
      else {
        if (akcija === "odobri") for (const x of red) if (x.slug === k.slug) x.odobrena_id = k.id;
        if (akcija === "odbij" && kv("trajno") && v("dorada").trim()) for (const x of red) if (x.slug === k.slug) x.opis_za_sliku = v("dorada").trim();
        povijest.push(k);
      }
      dalje();
    } catch (e) { poruka((e as Error).message); }
    zauzeto = false;
  }

  // Premještanje se ne poništava sa Z (nastaje nova slika i možda riječ); vraća se iz Aktivnosti.
  async function premjesti() {
    const k = red[0];
    const cilj = v("cilj").trim();
    if (zauzeto || !k) return;
    if (!cilj) { $("cilj").focus(); return; }
    zauzeto = true;
    try {
      const r = await fetch(`/admin/api/slika/${k.id}/premjesti`, { method: "POST", credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ rijec: cilj, dorada: v("dorada2"), trajno: kv("trajno2"), ponovi: kv("ponovi2") }) });
      if (r.status === 401) throw new Error("Sesija je istekla, prijavi se ponovno.");
      const j: any = await r.json().catch(() => ({}));
      if (j.vec) { poruka(opisOdluke(j.vec), "info"); dalje(); }
      else if (!r.ok) throw new Error(j.greska ?? `HTTP ${r.status}`);
      else {
        const R = String(j.rijec).toLocaleUpperCase("hr");
        poruka(`Slika je sada uz ${R}${j.nova ? " (nova riječ u katalogu)" : ""}, ${j.odobrena ? "odobrena" : "kao kandidat (riječ već ima odobrenu)"}.`
          + (j.generira ? ` Za ${k.rijec.toLocaleUpperCase("hr")} se crta nova.` : ""), "info");
        indeks = null;
        dalje();
      }
    } catch (e) { poruka((e as Error).message); }
    zauzeto = false;
  }

  // Brisanje riječi se ne poništava sa Z (dira sve njene slike i red); vraća se iz Aktivnosti.
  async function obrisi() {
    const k = red[0];
    if (zauzeto || !k) return;
    zauzeto = true;
    try {
      const r = await fetch("/admin/api/rijec/obrisi", { method: "POST", credentials: "same-origin",
        headers: { "content-type": "application/json" }, body: JSON.stringify({ slug: k.slug }) });
      if (r.status === 401) throw new Error("Sesija je istekla, prijavi se ponovno.");
      const j: any = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.greska ?? `HTTP ${r.status}`);
      for (const x of red) if (x.slug === k.slug) prosli.add(x.id);
      red = red.filter((x) => x.slug !== k.slug);
      prikazana = null;
      poruka(`Riječ ${k.rijec.toLocaleUpperCase("hr")} je obrisana. Vratiti se može u Aktivnosti.`, "info");
      indeks = null;
      prikazi();
    } catch (e) { poruka((e as Error).message); }
    zauzeto = false;
  }

  async function ponisti() {
    const k = povijest.pop();
    if (!k || zauzeto) return;
    zauzeto = true;
    try { await posalji(k.id, { akcija: "vrati" }); prosli.delete(k.id); red = [k, ...red.filter((x) => x.id !== k.id)]; prikazana = null; prikazi(); }
    catch (e) { poruka((e as Error).message); povijest.push(k); }
    zauzeto = false;
  }

  // Usklađivanje s bazom: tuđe odluke miču slike, novi kandidati idu na kraj reda.
  async function uskladi() {
    if (document.hidden || zauzeto) return;
    try {
      const r = await fetch(`/admin/api/kandidati${glas ? `?glas=${encodeURIComponent(glas)}` : ""}`, { credentials: "same-origin" });
      if (!r.ok) return;
      const { kandidati, odluke } = (await r.json()) as { kandidati: K[]; odluke: Odluka[] };
      if (zauzeto) return;
      const svjezi = new Map(kandidati.map((k) => [k.id, k]));
      const naEkranu = red[0];
      if (naEkranu && !svjezi.has(naEkranu.id)) {
        const o = odluke.find((x) => x.id === naEkranu.id);
        poruka(o ? opisOdluke(o) : "Ova slika više nije za pregled.", "info");
      }
      const poznati = new Set(red.map((k) => k.id));
      red = [
        ...red.filter((k) => svjezi.has(k.id)).map((k) => ({ ...k, odobrena_id: svjezi.get(k.id)!.odobrena_id })),
        ...kandidati.filter((k) => !poznati.has(k.id) && !prosli.has(k.id)),
      ];
      if (red[0]?.id !== naEkranu?.id) prikazana = null;
      prikazi(); brojac();
    } catch { /* mreža: probaj opet za 3 s */ }
  }
  setInterval(uskladi, 3000);
  document.addEventListener("visibilitychange", () => { if (!document.hidden) uskladi(); });

  // Indeks riječi za „Slika je za drugu riječ” (isti kao tražilica u bočnoj traci), učitava se kad zatreba.
  let indeks: Map<string, { o: number }> | null = null;
  async function ucitajIndeks() {
    if (indeks) return;
    const r = await fetch("/admin/api/trazi", { credentials: "same-origin" });
    const lista = (await r.json()) as { r: string; o: number }[];
    indeks = new Map(lista.map((x) => [x.r, x]));
    $("sve-rijeci").replaceChildren(...lista.map((x) => Object.assign(document.createElement("option"), { value: x.r })));
  }
  function infoCilja() {
    const c = v("cilj").trim().toLocaleLowerCase("hr").replace(/\s+/g, " "), p = $("cilj-info");
    p.hidden = !c || !indeks;
    if (p.hidden) return;
    const x = indeks!.get(c);
    if (c === red[0]?.rijec) { p.textContent = "To je ista riječ."; p.dataset.vrsta = "greska"; }
    else if (x) { p.textContent = x.o ? "Riječ postoji i već ima odobrenu sliku: ova će biti kandidat uz nju." : "Riječ postoji, slika će joj biti odobrena."; p.dataset.vrsta = "info"; }
    else { p.textContent = `Nove riječi „${c}” nema u katalogu: bit će dodana, a glasove potvrdi poslije na stranici riječi.`; p.dataset.vrsta = "nova"; }
  }

  const PANELI = ["razlog-okvir", "premjesti-okvir", "obrisi-okvir"];
  const otvoren = () => PANELI.some((id) => !$(id).hidden);
  function zatvoriPanele() {
    for (const id of PANELI) $(id).hidden = true;
    (document.activeElement as HTMLElement | null)?.blur();
  }
  function otvoriRazlog() {
    zatvoriPanele();
    for (const id of ["razlog", "dorada"]) $<HTMLInputElement>(id).value = "";
    $<HTMLInputElement>("trajno").checked = false;
    $("razlog-okvir").hidden = false; $("razlog").focus();
  }
  function otvoriPremjesti() {
    zatvoriPanele();
    for (const id of ["cilj", "dorada2"]) $<HTMLInputElement>(id).value = "";
    $<HTMLInputElement>("trajno2").checked = false;
    $("cilj-info").hidden = true;
    $("premjesti-okvir").hidden = false; $("cilj").focus();
    ucitajIndeks().then(infoCilja).catch(() => {});
  }

  function otvoriObrisi() {
    zatvoriPanele();
    const k = red[0];
    const n = red.filter((x) => x.slug === k.slug).length;
    $("obrisi-tekst").textContent = `${k.rijec.toLocaleUpperCase("hr")} nestaje iz kataloga, sve njene slike (${n} za pregled`
      + `${k.odobrena_id ? " i odobrena" : ""}) bit će odbijene, a nove se više neće crtati.`;
    $("obrisi-okvir").hidden = false;
    $<HTMLButtonElement>("obrisi-okvir").querySelector("button")!.focus();
  }

  $("odobri").onclick = () => odluci("odobri");
  $("obrisi").onclick = () => ($("obrisi-okvir").hidden ? otvoriObrisi() : zatvoriPanele());
  $("obrisi-okvir").addEventListener("submit", (e) => { e.preventDefault(); zatvoriPanele(); obrisi(); });
  $("odbij").onclick = () => ($("razlog-okvir").hidden ? otvoriRazlog() : zatvoriPanele());
  $("premjesti").onclick = () => ($("premjesti-okvir").hidden ? otvoriPremjesti() : zatvoriPanele());
  $("razlog-okvir").addEventListener("submit", (e) => { e.preventDefault(); odluci("odbij"); });
  $("premjesti-okvir").addEventListener("submit", (e) => { e.preventDefault(); premjesti(); });
  $("cilj").addEventListener("input", infoCilja);
  $("preskoci").onclick = dalje;
  $("ponisti").onclick = ponisti;
  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || !red.length) return;
    if (otvoren()) { if (e.key === "Escape") zatvoriPanele(); return; }
    const k = e.key.toLowerCase();
    if (k === "a") odluci("odobri");
    else if (k === "x") { e.preventDefault(); otvoriRazlog(); }
    else if (k === "p") { e.preventDefault(); otvoriPremjesti(); }
    else if (k === "d") { e.preventDefault(); otvoriObrisi(); }
    else if (k === "s" || e.key === "ArrowRight") dalje();
    else if (k === "z") ponisti();
  });
  prikazi();
</script>

<style>
  .pregled { display: grid; grid-template-columns: 1fr 380px; min-height: 100vh; }
  .pozornica { position: relative; display: grid; place-items: center; padding: 40px; background:
    radial-gradient(circle at 50% 40%, var(--povrsina) 0, var(--papir) 70%); }
  .pozornica > .list { width: min(72vh, 100%); aspect-ratio: 1; border-radius: 20px; background: var(--papir-slike); box-shadow: var(--sjena-3);
    display: grid; place-items: center; overflow: hidden; }
  .list img { width: 100%; height: 100%; object-fit: contain; }
  .usporedba { position: absolute; left: 24px; bottom: 24px; display: flex; flex-direction: column; gap: 6px; font-size: .74rem; color: var(--blijedo);
    font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .usporedba .list.mali { width: 120px; aspect-ratio: 1; border-radius: 10px; background: var(--papir-slike); border: 1px solid var(--rub); overflow: hidden; }
  .ploca { border-left: 1px solid var(--rub); background: var(--povrsina); padding: 32px 28px; display: flex; flex-direction: column; gap: 12px; }
  .napredak { display: flex; flex-direction: column; gap: 8px; font-size: .8rem; color: var(--blijedo); font-variant-numeric: tabular-nums; font-weight: 600; }
  .traka-napretka { height: 4px; border-radius: 999px; background: var(--povrsina-2); overflow: hidden; }
  .traka-napretka i { display: block; height: 100%; background: var(--med); transition: width .3s; }
  .rijec { margin: 18px 0 0; font-family: var(--font-slova); font-weight: 600; font-size: 2.6rem; letter-spacing: .02em; line-height: 1.05;
    font-variation-settings: "SOFT" 50, "opsz" 144; word-break: break-word; }
  .opis { margin: 0; padding: 8px 12px; border-radius: 10px; background: var(--info-blago); color: var(--info); font-size: .88rem; }
  .tipke { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .gumb.veliki { min-height: 52px; font-size: 1rem; justify-content: flex-start; }
  kbd { font: 600 .72rem var(--font); min-width: 22px; padding: 2px 6px; border-radius: 6px; border: 1px solid currentColor; opacity: .7; }
  .razlog { display: flex; flex-direction: column; gap: 10px; padding: 12px; border-radius: 12px; background: var(--povrsina-2); }
  .razlog > label:not(.kvacica) { display: flex; flex-direction: column; gap: 4px; margin: 0; font-size: .82rem; font-weight: 650; color: var(--tinta); }
  .red-gumba { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  #cilj-info { margin: 0; padding: 6px 10px; border-radius: 8px; background: var(--info-blago); color: var(--info); }
  #cilj-info[data-vrsta="nova"] { background: var(--med-blago, var(--info-blago)); color: var(--tinta); }
  #cilj-info[data-vrsta="greska"] { background: var(--greska-blago); color: var(--greska); }
  .kvacica { display: flex; align-items: center; gap: 8px; margin: 0; font-size: .86rem; color: var(--tinta); font-weight: 550; }
  .sitno { font-size: .8rem; }
