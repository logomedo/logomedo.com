---
import AdminOkvir from "../../../components/AdminOkvir.astro";
import Ikona from "../../../components/Ikona.astro";
import Aktivnost from "../../../components/Aktivnost.astro";
import PremjestiStil from "../../../components/PremjestiStil.astro";
import { kad, rijec as nadji, NAZIV_POZICIJE, stiloviAktivni } from "../../../lib/katalog";
import { safeNext } from "../../../lib/admin/sesija";
import { javniUrl } from "../../../lib/generiranje";
import { izvediRimu } from "../../../lib/zadaci/rima";

const r = await nadji(Astro.params.slug!);
if (!r) return new Response("Nema te riječi", { status: 404 });
const od = safeNext(Astro.url.searchParams.get("od"));
const ovdje = `/admin/rijec/${r.slug}?od=${encodeURIComponent(od)}`;
// Više odobrenih po stilu je dopušteno; velika je najnovija (slike su poredane odobrene, pa id silazno).
const odobrena = r.slike.find((s) => s.status === "odobrena");
const kandidati = r.slike.filter((s) => s.status === "kandidat");
const odbijene = r.slike.filter((s) => s.status === "odbijena");
const uRedu = r.red.filter((q) => q.status !== "greska");
const greske = r.red.filter((q) => q.status === "greska");
const dodano = Astro.url.searchParams.get("dodano");
const q = (k: string) => Astro.url.searchParams.get(k);
const spoji = q("spoji"); // naziv koji već postoji: traži potvrdu spajanja
const ucitano = Astro.url.searchParams.get("ucitano");
const greskaUploada = Astro.url.searchParams.get("greska");
const stilovi = await stiloviAktivni();
// Za generiranje ponudi prvo stil koji još nema ni odobrenu ni kandidata ni posao u redu (npr. bojanka uz gotovu ilustraciju).
const zauzet = (kod: string) => r.slike.some((s) => s.stil === kod && s.status !== "odbijena") || uRedu.some((q) => q.stil === kod);
const zadaniStil = stilovi.find((x) => !zauzet(x.kod))?.kod ?? stilovi[0]?.kod;
const odobrene = r.slike.filter((s) => s.status === "odobrena");
---
<AdminOkvir naslov={r.rijec.toLocaleUpperCase("hr")} aktivno="katalog">
  <a class="mrvice" href={od}><Ikona ime="natrag" velicina={16} /> Natrag</a>

  {Astro.url.searchParams.get("nova") && <div class="obavijest"><Ikona ime="kvacica" /> Riječ je dodana u katalog.</div>}
  {Astro.url.searchParams.get("postoji") && <div class="obavijest"><Ikona ime="upozorenje" /> Ta riječ je već u katalogu.</div>}
  {ucitano && <div class="obavijest"><Ikona ime="kvacica" /> Slika je učitana kao kandidat.</div>}
  {greskaUploada && <div class="obavijest upozorenje"><Ikona ime="upozorenje" /> Upload nije uspio: {greskaUploada}</div>}
  {q("preimenovano") && <div class="obavijest"><Ikona ime="kvacica" /> Naziv je promijenjen.</div>}
  {q("spojeno") !== null && (
    <div class="obavijest"><Ikona ime="kvacica" /> Slike su prebačene ovdje ({q("spojeno")}), a stara riječ je maknuta iz kataloga.
      {Number(q("zadataka")) > 0 && <> Pazi: {q("zadataka")} zadataka još koristi staru riječ, zamijeni je u njima.</>}</div>
  )}
  {q("greska_naziva") && <div class="obavijest upozorenje"><Ikona ime="upozorenje" /> {q("greska_naziva")}</div>}
  {spoji && (
    <form class="obavijest upozorenje spajanje" method="post" action={`/admin/api/rijec/${r.id}`}>
      <input type="hidden" name="akcija" value="preimenuj" /><input type="hidden" name="naziv" value={spoji} />
      <input type="hidden" name="spoji" value="1" /><input type="hidden" name="slug" value={r.slug} /><input type="hidden" name="od" value={od} />
      <span><Ikona ime="upozorenje" /> Riječ {spoji.toLocaleUpperCase("hr")} već postoji{Number(q("spoji_slika")) ? ` (ima ${q("spoji_slika")} slika)` : " (bez slika)"}.
        Prebaciti sve slike riječi {r.rijec.toLocaleUpperCase("hr")} na {spoji.toLocaleUpperCase("hr")} i maknuti {r.rijec.toLocaleUpperCase("hr")} iz kataloga?</span>
      <span class="red-gumba"><button class="gumb mali glavni" type="submit">Da, prebaci</button><a class="gumb mali tihi" href={ovdje}>Odustani</a></span>
    </form>
  )}
  {dodano !== null && <div class="obavijest"><Ikona ime="red" /> {Number(dodano) ? "Dodano u red za generiranje." : "Već je u redu."}</div>}

  <div class="raspored">
    <div class="glavna ploha">
      <div class="list veliki">
        {odobrena ? <img src={`/admin/slika/${odobrena.id}`} alt={r.rijec} /> : <span class="bez">{r.rijec}</span>}
      </div>
      <div class="potpis">
        <span class="rijec-tekst">{r.rijec}</span>
        {odobrena ? <span class="oznaka uspjeh"><Ikona ime="kvacica" velicina={12} /> {odobrena.stil_naziv}</span> : <span class="oznaka">nema odobrene</span>}
        {odobrena && <a href={javniUrl(odobrena.r2_kljuc)} target="_blank" rel="noopener">javni URL</a>}
      </div>
    </div>

    <div class="detalji">
      <h1 class="naslov-rijeci">{r.rijec.toLocaleUpperCase("hr")}</h1>
      <details class="preimenuj">
        <summary class="sitno">Promijeni naziv</summary>
        <form method="post" action={`/admin/api/rijec/${r.id}`}>
          <input type="hidden" name="akcija" value="preimenuj" /><input type="hidden" name="slug" value={r.slug} /><input type="hidden" name="od" value={od} />
          <input type="text" name="naziv" value={r.rijec} maxlength="40" required aria-label="Novi naziv" />
          <button class="gumb mali" type="submit">Spremi naziv</button>
        </form>
        <p class="sitno blijedo">Ako riječ s tim nazivom već postoji, slike se mogu prebaciti na nju.</p>
      </details>
      <p class="podnaslov">
        {r.izvor === "legacy" ? `Iz starog kataloga, na listićima ${r.legacy_koristeno}×` : "Dodana u adminu"}
      </p>

      <h2>Glasovi i pozicije</h2>
      <div class="pozicije">
        {r.pozicije.map((p) => (
          <div class:list={["pozicija", { izvedena: !p.potvrdeno }]}>
            <a href={`/admin/glas/${p.slug}?p=${p.pozicija}`} class="pg"><b>{p.oznaka}</b> {NAZIV_POZICIJE[p.pozicija].toLowerCase()}</a>
            {!p.potvrdeno && (
              <form method="post" action={`/admin/api/rijec/${r.id}`}>
                <input type="hidden" name="glas" value={p.slug} /><input type="hidden" name="pozicija" value={p.pozicija} />
                <input type="hidden" name="next" value={ovdje} />
                <button class="gumb mali tihi" name="akcija" value="potvrdi" title="Potvrdi poziciju"><Ikona ime="kvacica" velicina={14} /></button>
                <button class="gumb mali tihi" name="akcija" value="makni" title="Makni poziciju"><Ikona ime="x" velicina={14} /></button>
              </form>
            )}
          </div>
        ))}
      </div>
      {r.pozicije.some((p) => !p.potvrdeno) && <p class="sitno blijedo">Plave pozicije su izvedene iz pravopisa. Potvrdi ih ili makni.</p>}

      <form class="ploha uredi" method="post" action={`/admin/api/rijec/${r.id}`}>
        <input type="hidden" name="next" value={ovdje} />
        <div>
          <label for="opis">Opis za sliku (ide u prompt)</label>
          <input id="opis" type="text" name="opis_za_sliku" value={r.opis_za_sliku ?? ""} maxlength="300"
            placeholder="npr. luk kao povrće, ne oružje" />
        </div>
        <div>
          <label for="recenica">Primjer rečenice</label>
          <input id="recenica" type="text" name="recenica" value={r.recenica ?? ""} maxlength="300" />
        </div>
        <div>
          <label for="rima">Rima (prazno = iz pravopisa: <span class="mono">-{(izvediRimu(r.rijec) ?? "?").toLocaleLowerCase("hr")}</span>)</label>
          <input id="rima" type="text" name="rima" value={r.rima ?? ""} maxlength="12" placeholder={izvediRimu(r.rijec)?.toLocaleLowerCase("hr") ?? ""} />
        </div>
        <button class="gumb mali" type="submit">Spremi</button>
      </form>

      {odobrene.length > 1 && (
        <div class="odobrene">
          {odobrene.map((s) => (
            <figure><div class="list"><img src={`/admin/slika/${s.id}`} alt={`${r.rijec}, ${s.stil_naziv}`} loading="lazy" /></div><figcaption class="sitno blijedo">{s.stil_naziv}</figcaption></figure>
          ))}
        </div>
      )}

      <form class="generiraj" method="post" action="/admin/api/generiraj">
        <input type="hidden" name="rijec" value={r.id} /><input type="hidden" name="next" value={ovdje} />
        <select name="stil" aria-label="Stil" class="g-stil">
          {stilovi.map((x) => <option value={x.kod} selected={x.kod === zadaniStil}>{x.naziv}{uRedu.some((q) => q.stil === x.kod) ? " (u redu)" : ""}</option>)}
        </select>
        <input type="text" name="napomena" placeholder="Dodatna uputa za ovu sliku (neobavezno)" maxlength="300" />
        <button class="gumb glavni" type="submit">
          <Ikona ime="iskra" /> Generiraj novu
        </button>
      </form>
      {uRedu.length > 0 && <p class="sitno blijedo"><Ikona ime="red" velicina={14} /> U redu: {[...new Set(uRedu.map((q) => q.stil_naziv))].join(", ")}</p>}
      <details class="ploha upload" open={!!greskaUploada}>
        <summary><Ikona ime="slika" velicina={16} /> Dodaj sliku iz vanjskog alata</summary>
        <form method="post" action="/admin/api/upload" enctype="multipart/form-data">
          <input type="hidden" name="rijec" value={r.id} /><input type="hidden" name="next" value={ovdje} />
          <div class="upload-red">
            <label class="odabir">
              <input type="file" name="slika" accept="image/png,image/jpeg,image/webp" required />
              <img class="pretpregled" alt="" hidden />
              <span class="poziv">PNG, JPEG ili WebP, do 8 MB</span>
            </label>
            <span class="odabrano sitno blijedo" aria-live="polite"></span>
            <div class="upload-polja">
              <div class="dva">
                <div>
                  <label for="u-stil">Stil</label>
                  <select id="u-stil" name="stil">{stilovi.map((x) => <option value={x.kod} selected={x.kod === zadaniStil}>{x.naziv}</option>)}</select>
                </div>
                <div>
                  <label for="u-alat">Alat / model</label>
                  <input id="u-alat" type="text" name="alat" maxlength="100" placeholder="npr. Gemini web, Leonardo" list="alati" />
                  <datalist id="alati"><option value="Gemini web" /><option value="Leonardo" /><option value="ChatGPT" /><option value="Midjourney" /><option value="ručno nacrtano" /></datalist>
                </div>
              </div>
              <div>
                <label for="u-prompt">Prompt kako je slika nastala</label>
                <textarea id="u-prompt" name="prompt" rows="5" maxlength="4000" required placeholder="Zalijepi točan prompt iz alata"></textarea>
              </div>
              <button class="gumb glavni" type="submit"><Ikona ime="kvacica" /> Učitaj kao kandidata</button>
            </div>
          </div>
        </form>
      </details>
      {greske.length > 0 && <p class="sitno" style="color:var(--greska)"><Ikona ime="upozorenje" velicina={14} /> Zadnje generiranje ({greske[0].stil_naziv}) nije uspjelo: {greske[0].greska}</p>}
    </div>
  </div>

  <section>
    <h2 class="odjeljak">Kandidati <span>{kandidati.length}</span></h2>
    {kandidati.length ? (
      <div class="kandidati">
        {kandidati.map((s) => (
          <figure class="ploha kandidat">
            <div class="list"><img src={`/admin/slika/${s.id}`} alt={`Kandidat ${s.id}`} loading="lazy" /></div>
            <figcaption>
              <span class="blijedo sitno"><b>{s.stil_naziv}</b> · {kad(s.created_at)} · {s.izvor === "upload" ? `upload${s.model ? `: ${s.model}` : ""}` : s.model ?? s.izvor}</span>
              {s.prompt && <details class="prompt"><summary>Prompt</summary><p class="mono">{s.prompt}</p></details>}
              <form method="post" action={`/admin/api/slika/${s.id}`} class="odluka">
                <input type="hidden" name="next" value={ovdje} />
                <input type="text" name="razlog" placeholder="Razlog odbijanja" maxlength="300" />
                <button class="gumb mali" name="akcija" value="odbij"><Ikona ime="x" velicina={14} /> Odbij</button>
                <button class="gumb mali glavni" name="akcija" value="odobri"><Ikona ime="kvacica" velicina={14} /> Odobri</button>
              </form>
              <PremjestiStil slika={s} stilovi={stilovi} next={ovdje} />
            </figcaption>
          </figure>
        ))}
      </div>
    ) : <p class="blijedo">{uRedu.length ? "Slika se generira; pojavit će se ovdje." : "Nema kandidata."}</p>}
  </section>

  {(odbijene.length > 0 || odobrene.length > 0) && (
    <details class="povijest">
      <summary>Odobrene i odbijene ({odobrene.length} odobrenih, {odbijene.length} odbijenih)</summary>
      <div class="kandidati mali">
        {[...odobrene, ...odbijene].map((s) => (
          <figure class="ploha kandidat">
            <div class="list"><img src={`/admin/slika/${s.id}`} alt="" loading="lazy" /></div>
            <figcaption>
              <span class:list={["oznaka", { uspjeh: s.status === "odobrena", greska: s.status === "odbijena" }]}>{s.status} · {s.stil_naziv}</span>
              {s.razlog && <span class="sitno blijedo">„{s.razlog}”</span>}
              <form method="post" action={`/admin/api/slika/${s.id}`}><input type="hidden" name="next" value={ovdje} />
                <button class="gumb mali tihi" name="akcija" value="vrati">{s.status === "odobrena" ? "Makni iz odobrenih" : "Vrati u kandidate"}</button></form>
              <PremjestiStil slika={s} stilovi={stilovi} next={ovdje} />
              {s.prompt && <details class="prompt"><summary>Prompt</summary><p class="mono">{s.prompt}</p></details>}
            </figcaption>
          </figure>
        ))}
      </div>
    </details>
  )}

  <details class="povijest" open>
    <summary>Izmjene ove riječi i njenih slika · <a href={`/admin/aktivnost?rijec=${r.id}`}>cijeli dnevnik</a></summary>
    <Aktivnost rijec={r.id} limit={20} />
  </details>
</AdminOkvir>

<script>
  // Pregled odabrane slike. FileReader (data URL) umjesto blob URL-a, slušamo i change i input,
  // a ispod okvira uvijek piše ime i veličina: ako na mobitelu nema ni toga, događaj nije stigao.
  for (const ulaz of document.querySelectorAll<HTMLInputElement>(".upload input[type=file]")) {
    const okvir = ulaz.closest(".odabir")!;
    const img = okvir.querySelector<HTMLImageElement>(".pretpregled")!;
    const info = ulaz.closest("form")!.querySelector<HTMLElement>(".odabrano")!;
    const pokazi = () => {
      const f = ulaz.files?.[0];
      img.hidden = true;
      img.removeAttribute("src");
      if (!f) { info.textContent = ""; return; }
      info.textContent = `${f.name} · ${(f.size / 1024 / 1024).toFixed(1)} MB · ${f.type || "nepoznat tip"}`;
      const r = new FileReader();
      r.onload = () => { img.src = String(r.result); img.hidden = false; };
      r.onerror = () => { info.textContent += " · pregled nije moguć"; };
      r.readAsDataURL(f);
    };
    img.onerror = () => { img.hidden = true; info.textContent += " · pregled nije moguć"; };
    ulaz.addEventListener("change", pokazi);
    ulaz.addEventListener("input", pokazi);
  }
</script>

<style>
  .raspored { display: grid; grid-template-columns: minmax(260px, 380px) 1fr; gap: 36px; margin-bottom: 44px; align-items: start; }
  @media (max-width: 900px) { .raspored { grid-template-columns: 1fr; } }
  .glavna { padding: 14px; }
  .list { aspect-ratio: 1; border-radius: 12px; background: var(--papir-slike); display: grid; place-items: center; overflow: hidden; border: 1px solid var(--rub); }
  .list img { width: 100%; height: 100%; object-fit: contain; }
  .bez { font-family: var(--font-slova); font-size: 2rem; text-transform: uppercase; letter-spacing: .06em; color: #c9bfae; }
  .potpis { display: flex; align-items: center; justify-content: space-between; padding: 12px 4px 2px; }
  .naslov-rijeci { margin: 0; font-family: var(--font-slova); font-weight: 600; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: .02em; line-height: 1.05;
    font-variation-settings: "SOFT" 50, "opsz" 144; }
  .detalji h2, .odjeljak { font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; color: var(--blijedo); font-weight: 650; margin: 26px 0 10px; }
  .odjeljak span { color: var(--vrlo-blijedo); margin-left: 4px; }
  .pozicije { display: flex; flex-wrap: wrap; gap: 8px; }
  .pozicija { display: inline-flex; align-items: center; gap: 2px; padding: 3px 4px 3px 12px; border-radius: 999px; background: var(--povrsina);
    border: 1px solid var(--rub-jak); }
  .pozicija.izvedena { background: var(--info-blago); border-color: transparent; color: var(--info); }
  .pozicija form { display: inline-flex; margin: 0; }
  .pozicija .gumb.mali { min-height: 26px; padding: 0 6px; }
  .pg { text-decoration: none; font-size: .86rem; padding: 3px 8px 3px 0; }
  .pg b { font-family: var(--font-slova); font-size: 1rem; margin-right: 2px; }
  .sitno { font-size: .8rem; margin: 8px 0 0; display: inline-flex; gap: 6px; align-items: center; }
  .uredi { display: grid; gap: 14px; padding: 18px; margin-top: 26px; }
  .uredi .gumb { justify-self: start; }
  .generiraj { display: flex; gap: 10px; margin-top: 16px; }
  .generiraj { flex-wrap: wrap; }
  .generiraj input { flex: 1 1 200px; }
  .generiraj .g-stil { width: auto; flex: 0 0 auto; }
  .preimenuj { margin: -4px 0 12px; }
  .preimenuj summary { cursor: pointer; color: var(--blijedo, inherit); }
  .preimenuj form { display: flex; gap: 8px; margin-top: 8px; }
  .preimenuj input { flex: 1; min-width: 0; }
  .spajanje { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
  .spajanje .red-gumba { display: flex; gap: 8px; }
  .odobrene { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; margin-top: 16px; }
  .odobrene figure { margin: 0; text-align: center; }
  .kandidati { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .kandidati.mali { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); margin-top: 14px; }
  .kandidat { margin: 0; padding: 10px; }
  .kandidat figcaption { display: flex; flex-direction: column; gap: 8px; padding: 10px 2px 2px; }
  .odluka { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .odluka input { flex: 1 1 100%; padding: 6px 10px; font-size: .85rem; }
  .odluka .gumb { flex: 1; }
  .povijest { margin-top: 36px; }
  .obavijest.upozorenje { background: var(--greska-blago); color: var(--greska); }
  .upload { margin-top: 16px; padding: 0; }
  .upload summary { cursor: pointer; padding: 12px 16px; font-weight: 600; display: flex; gap: 8px; align-items: center; color: var(--blijedo); }
  .upload[open] summary { color: var(--tinta); border-bottom: 1px solid var(--rub); }
  .upload form { padding: 16px; margin: 0; }
  .upload-red { display: grid; grid-template-columns: 160px 1fr; gap: 16px; }
  .odabir { position: relative; aspect-ratio: 1; border: 2px dashed var(--rub-jak); border-radius: 12px; display: grid; place-items: center;
    text-align: center; cursor: pointer; overflow: hidden; background: var(--papir-slike); margin: 0; }
  .odabir input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .odabir .poziv { padding: 10px; font-size: .78rem; }
  .pretpregled { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; background: var(--papir-slike); }
  .odabrano { grid-column: 1; margin: -8px 0 0; word-break: break-all; display: block; }
  .odabrano:empty { display: none; }
  .upload-polja { grid-row: 1 / span 2; grid-column: 2; display: grid; gap: 12px; align-content: start; }
  .upload-polja .gumb { justify-self: start; }
  .dva { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  /* Mora biti iza osnovnih pravila: ista specifičnost, pa bi ga .upload-polja { grid-column: 2 } pregazio
     i na mobitelu stisnuo okvir za odabir u uski stupac. */
  @media (max-width: 600px) {
    .upload-red { grid-template-columns: 1fr; }
    .upload-polja { grid-row: auto; grid-column: auto; }
    .odabir { width: 100%; max-width: 260px; justify-self: center; }
    .odabir .poziv { font-size: .9rem; }
    .odabrano { grid-column: auto; margin: 0; text-align: center; }
    .dva { grid-template-columns: 1fr; }
  }
  select { width: 100%; font: inherit; padding: 9px 12px; border: 1px solid var(--rub-jak); border-radius: 10px; background: var(--povrsina); color: var(--tinta); }
  .povijest summary { cursor: pointer; color: var(--blijedo); font-weight: 600; }
  .prompt summary { font-size: .78rem; } .prompt p { margin: 6px 0 0; white-space: pre-wrap; color: var(--blijedo); }
</style>
