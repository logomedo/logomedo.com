---
import AdminOkvir from "../../../components/AdminOkvir.astro";
import { kad } from "../../../lib/katalog";
import { nazivPodrucja, obrisani as sviObrisani, obrisiVise, podrucja as svaPodrucja, popis, vrati } from "../../../lib/zadaci/baza";
import { VRSTE } from "../../../lib/zadaci/vrste";

// Meko brisanje s popisa (kvačice) i vraćanje obrisanih.
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  if (f.get("akcija") === "obrisi") await obrisiVise(f.getAll("id").map(Number).filter((n) => n > 0));
  if (f.get("akcija") === "vrati") await vrati(Number(f.get("id")));
  return Astro.redirect("/admin/zadaci", 303);
}

const [zadaci, podrucja, obrisani] = await Promise.all([popis(), svaPodrucja(), sviObrisani()]);
const skupine = [...new Set(zadaci.map((z) => z.podrucje_id))].map((id) => ({ id, naziv: nazivPodrucja(podrucja, id), zadaci: zadaci.filter((z) => z.podrucje_id === id) }));
---
<AdminOkvir naslov="Gotovi zadaci" aktivno="zadaci">
  <div class="naslov">
    <div>
      <h1>Gotovi zadaci</h1>
      <p class="podnaslov">Zadaci napravljeni iz predložaka, spremni za bilježnice. {zadaci.length} zadataka.</p>
    </div>
    <a class="gumb glavni mali" href="/admin/predlosci">Novi zadatak</a>
  </div>

  {skupine.length ? skupine.map((s) => (
    <section>
      <h2 class="odjeljak">{s.naziv} <span>{s.zadaci.length}</span></h2>
      <div class="ploha">
        <table>
          <thead><tr><th class="kv"><input type="checkbox" class="sve" aria-label="Odaberi sve u skupini" /></th><th>Naslov</th><th>Vrsta</th><th>Verzija</th><th>Rješavano</th><th>Autor</th><th>Izmijenjeno</th></tr></thead>
          <tbody>
            {s.zadaci.map((z) => (
              <tr>
                <td class="kv"><input type="checkbox" name="id" value={z.id} form="brisanje" aria-label="Odaberi zadatak" /></td>
                <td><a href={`/admin/zadaci/${z.id}`}><b>{z.naslov || VRSTE[z.vrsta].naziv}</b></a></td>
                <td><span class="oznaka">{VRSTE[z.vrsta].naziv}</span></td>
                <td class="mono">v{z.aktivna_verzija}</td>
                <td>{z.rjesavanja}×</td>
                <td class="blijedo">{z.autor}</td>
                <td class="blijedo">{kad(z.updated_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )) : (
    <div class="ploha prazno"><h2>Još nema zadataka</h2><p>Novi zadatak napraviš iz <a href="/admin/predlosci">predloška</a>.</p></div>
  )}

  {zadaci.length > 0 && (
    <form id="brisanje" class="brisanje" method="post">
      <button class="gumb mali tihi opasno" name="akcija" value="obrisi" type="submit">Obriši odabrane <span id="broj-odabranih"></span></button>
      <span class="blijedo">Obrisani se mogu vratiti dolje.</span>
    </form>
  )}

  {obrisani.length > 0 && (
    <details class="obrisani">
      <summary class="odjeljak">Obrisani <span>{obrisani.length}</span></summary>
      <div class="ploha">
        <table>
          <thead><tr><th>Naslov</th><th>Vrsta</th><th>Obrisano</th><th></th></tr></thead>
          <tbody>
            {obrisani.map((z) => (
              <tr>
                <td class="blijedo">{z.naslov || VRSTE[z.vrsta]?.naziv || z.vrsta}</td>
                <td><span class="oznaka">{VRSTE[z.vrsta]?.naziv ?? z.vrsta}</span></td>
                <td class="blijedo">{kad(z.obrisan_at)}</td>
                <td><form method="post"><input type="hidden" name="id" value={z.id} /><button class="gumb mali tihi" name="akcija" value="vrati" type="submit">Vrati</button></form></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</AdminOkvir>

<script>
  // „Odaberi sve” po skupini i broj odabranih na gumbu.
  const broj = document.getElementById("broj-odabranih");
  const osvjezi = () => {
    const n = document.querySelectorAll<HTMLInputElement>('input[name="id"][form="brisanje"]:checked').length;
    if (broj) broj.textContent = n ? `(${n})` : "";
  };
  for (const sve of document.querySelectorAll<HTMLInputElement>("input.sve")) {
    sve.addEventListener("change", () => {
      for (const k of sve.closest("table")!.querySelectorAll<HTMLInputElement>('input[name="id"]')) k.checked = sve.checked;
      osvjezi();
    });
  }
  document.addEventListener("change", osvjezi);
  document.getElementById("brisanje")?.addEventListener("submit", (e) => {
    if (!document.querySelector('input[name="id"][form="brisanje"]:checked')) e.preventDefault();
  });
</script>

<style>
  .odjeljak { font-size: .74rem; text-transform: uppercase; letter-spacing: .1em; color: var(--blijedo); font-weight: 650; margin: 30px 0 12px; }
  .odjeljak span { color: var(--vrlo-blijedo); margin-left: 4px; }
  .kv { width: 28px; }
  .brisanje { display: flex; align-items: center; gap: 12px; margin-top: 16px; font-size: .84rem; }
  .obrisani summary { cursor: pointer; }
  td a { text-decoration: none; } td a:hover { text-decoration: underline; }
</style>
