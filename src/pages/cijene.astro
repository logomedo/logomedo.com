---
// /cijene (odluke 813, 814, 816): cjenik vrijedi odmah; licenca je za jednu osobu. Kupnja zasad narudžbom kroz /pristup
// (račun, pa pristup bez odobravanja), kartično plaćanje uskoro. Za vrijeme bete može se zatražiti i besplatan pristup.
import Okvir from "../landing/Okvir.astro";
import Uvod from "../landing/Uvod.astro";
import Paketi from "../landing/cijene/Paketi.astro";
import Osobna from "../landing/cijene/Osobna.astro";
import ZaUstanove from "../landing/cijene/ZaUstanove.astro";
import Beta from "../landing/cijene/Beta.astro";

export const prerender = true;
---
<Okvir putanja="/cijene">
  <Uvod gumbi={[{ href: "#paketi", tekst: "Odaberi paket" }, { href: "/pristup?paket=beta", tekst: "Besplatno za vrijeme bete" }]}>
    <Fragment slot="naslov">Cijene</Fragment>
    Jedna licenca je za jednu osobu i uključuje sve: katalog, radne listiće, PDF za ispis i igre. Kupnjom dobivate pristup bez
    čekanja na odobrenje. Dok traje beta, možete zatražiti i besplatan pristup.
  </Uvod>
  <Paketi />
  <Osobna />
  <ZaUstanove />
  <Beta />
</Okvir>
