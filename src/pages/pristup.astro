---
// /pristup (S7 landinga): obrazac „Zatraži pristup” za privatnu betu. SSR, ne prerender: obrađuje POST i svaki
// prikaz nosi vremenski žig. CSP s nonceom i ostala zaglavlja daje middleware (zastiti); CSRF provjera iz
// middlewarea vrijedi samo za /admin, pa Origin provjerava ova stranica. Bez JavaScripta i bez inline skripte.
// Logika i zaštita od spama: src/lib/pristup.ts. Uspjeh: PRG, 303 na /pristup?poslano=1.
import Okvir from "../landing/Okvir.astro";
import { PAKETI_ZAHTJEVA, PRIJAVA, cijenaLicence, eura } from "../landing/konstante";
import {
  HONEYPOT, KUPON_MAX, LICENCI_MAX, MAX, ZIG, istiOrigin, posalji, prazanUnos, vremenskiZig, type Greske, type Polje, type Unos,
} from "../lib/pristup";
import { cjenikVidljiv } from "../lib/cjenik";

export const prerender = false;

Astro.response.headers.set("cache-control", "no-store");

const poslano = Astro.url.searchParams.get("poslano");
let stanje: "obrazac" | "hvala" | "odobreno" | "previse" = poslano === "1" ? "hvala" : poslano === "kupon" ? "odobreno" : "obrazac";
// Kupon iz linka (/pristup?kupon=KOD, docs/kuponi.md) je već upisan u polje.
let unos: Unos = prazanUnos(Astro.url.searchParams.get("paket") ?? "beta", Astro.url.searchParams.get("kupon") ?? "");
let greske: Greske = {};
// Bez cjenika (CJENIK_VIDLJIV) obrazac ne nudi plaćene pakete s cijenom, osim ako je paket već odabran linkom.
const cjenik = cjenikVidljiv();
const ponudeni = cjenik ? PAKETI_ZAHTJEVA : PAKETI_ZAHTJEVA.filter((p) => p.kod === "beta" || p.kod === "ustanova" || p.kod === unos.paket);
let zig: string | null = null;

if (Astro.request.method === "POST") {
  if (!istiOrigin(Astro.request, Astro.url.origin)) {
    return new Response("Zabranjeno: zahtjev nije poslan s ove stranice.", { status: 403, headers: { "content-type": "text/plain; charset=utf-8" } });
  }
  const ishod = await posalji(await Astro.request.formData(), Astro.request.headers.get("cf-connecting-ip"), new Date(), fetch, Astro.url.origin);
  if (ishod.vrsta === "hvala") return Astro.redirect("/pristup?poslano=1", 303);
  if (ishod.vrsta === "odobreno") return Astro.redirect("/pristup?poslano=kupon", 303);
  if (ishod.vrsta === "previse") {
    stanje = "previse";
    Astro.response.status = 429;
  } else {
    stanje = "obrazac";
    ({ unos, greske, zig } = ishod);
    Astro.response.status = 400;
  }
} else if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response(null, { status: 405, headers: { allow: "GET, HEAD, POST" } });
}
if (stanje === "obrazac") zig ??= await vremenskiZig();

const imaGresaka = Object.keys(greske).length > 0;
/** aria atributi polja: opis (ako postoji) i greška. */
const aria = (p: Polje, opis?: string) => {
  const ids = [opis, greske[p] ? `greska-${p}` : undefined].filter(Boolean).join(" ");
  return { "aria-invalid": greske[p] ? ("true" as const) : undefined, "aria-describedby": ids || undefined };
};
---
<Okvir putanja="/pristup">
  <section class="sekcija pristup" aria-labelledby="naslov">
    <div class="omot raspored">
      <div class="uvod">
        {stanje === "hvala" ? (
          <>
            <h1 class="landing-h1" id="naslov">Hvala, javit ćemo se.</h1>
            <p class="uvodni">Zahtjev je stigao. Javit ćemo vam se na e-mail koji ste upisali: s računom ili ponudom ako ste naručili paket, a s osobnim linkom za prijavu kad je pristup otvoren.</p>
            <p class="sitno"><a href="/">Natrag na naslovnu</a></p>
          </>
        ) : stanje === "odobreno" ? (
          <>
            <h1 class="landing-h1" id="naslov">Pristup je odobren.</h1>
            <p class="uvodni">Kupon vrijedi. Na e-mail koji ste upisali upravo smo poslali osobni link za prijavu. Link vrijedi 72 sata i
              može se iskoristiti jednom. Ako ga ne vidite za nekoliko minuta, pogledajte i mapu neželjene pošte.</p>
            <p class="sitno"><a href="/">Natrag na naslovnu</a></p>
          </>
        ) : (
          <>
            {unos.kupon && unos.paket === "beta" ? (
              <>
                <h1 class="landing-h1" id="naslov">Pristup s kuponom</h1>
                <p class="uvodni">S važećim kuponom pristup dobivate odmah, bez čekanja na odobrenje: pošaljite obrazac i link za prijavu
                  stiže na vaš e-mail.</p>
              </>
            ) : unos.paket === "beta" ? (
              <>
                <h1 class="landing-h1" id="naslov">Besplatno za vrijeme bete</h1>
                <p class="uvodni">Dok je LogoMedo u beti, možete zatražiti besplatan pristup. O svakom zahtjevu odlučujemo pojedinačno i
                  javljamo vam se s osobnim linkom za prijavu.{cjenik && <> Ako ne želite čekati, odaberite paket iz <a href="/cijene">cjenika</a>.</>}</p>
              </>
            ) : unos.paket === "ustanova" ? (
              <>
                <h1 class="landing-h1" id="naslov">Licence za ustanovu</h1>
                <p class="uvodni">Upišite koliko licenci trebate. Poslat ćemo ponudu s popustom za taj broj licenci; kad je uplata vidljiva,
                  svaka osoba dobiva svoj link za prijavu.{cjenik && <> <a href="/cijene#za-ustanove">Popusti po broju licenci</a></>}</p>
              </>
            ) : (
              <>
                <h1 class="landing-h1" id="naslov">Narudžba</h1>
                <p class="uvodni">Pošaljite narudžbu i poslat ćemo vam račun za uplatu. Pristup otvaramo čim je uplata vidljiva, bez
                  odobravanja. Plaćanje karticom uvodimo uskoro.</p>
              </>
            )}
            <p class="sitno">Već imate pozivnicu? <a href={PRIJAVA}>Prijava</a></p>
          </>
        )}
      </div>

      {stanje === "previse" && (
        <div class="kartica" role="alert">
          <h2 class="naslov-kartice">Previše zahtjeva</h2>
          <p>S ove mreže je u zadnjih sat vremena stiglo previše zahtjeva. Pokušajte ponovno za sat vremena.</p>
          <p><a href="/pristup">Natrag na obrazac</a></p>
        </div>
      )}

      {stanje === "obrazac" && (
        <form class="kartica" method="post" action="/pristup" aria-describedby={greske.obrazac ? "greska-obrazac" : undefined}>
          {imaGresaka && (
            <p class="greska-sazetak" id="greska-obrazac" role="alert">
              {greske.obrazac ?? "Provjerite označena polja."}
            </p>
          )}
          <input type="hidden" name={ZIG} value={zig ?? ""} />

          <div class="polje">
            <label for="paket">Što vas zanima</label>
            <select id="paket" name="paket" {...aria("paket")}>
              {ponudeni.map((p) => <option value={p.kod} selected={p.kod === unos.paket}>{p.tekst}</option>)}
            </select>
            {greske.paket && <p class="greska" id="greska-paket">{greske.paket}</p>}
          </div>

          <div class="polje">
            <label for="licenci">Broj licenci <span class="neobavezno">(samo za ustanovu)</span></label>
            <input id="licenci" name="licenci" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" value={unos.licenci}
              {...aria("licenci", "opis-licenci")} />
            <p class="opis" id="opis-licenci">Jedna licenca je za jednu osobu. {cjenik ? <>Npr. 5 licenci: {eura(cijenaLicence(5)!)} godišnje po osobi
              (do {LICENCI_MAX}).</> : <>Najviše {LICENCI_MAX} licenci.</>}</p>
            {greske.licenci && <p class="greska" id="greska-licenci">{greske.licenci}</p>}
          </div>

          <div class="polje">
            <label for="ime">Ime i prezime</label>
            <input id="ime" name="ime" type="text" autocomplete="name" required maxlength={MAX.ime} value={unos.ime} {...aria("ime")} />
            {greske.ime && <p class="greska" id="greska-ime">{greske.ime}</p>}
          </div>

          <div class="polje">
            <label for="email">E-mail</label>
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" value={unos.email}
              {...aria("email", "opis-email")} />
            <p class="opis" id="opis-email">Na njega stižu račun ili ponuda i link za prijavu.</p>
            {greske.email && <p class="greska" id="greska-email">{greske.email}</p>}
          </div>

          <div class="dva">
            <div class="polje">
              <label for="ustanova">Ustanova</label>
              <input id="ustanova" name="ustanova" type="text" autocomplete="organization" required maxlength={MAX.ustanova}
                value={unos.ustanova} {...aria("ustanova", "opis-ustanova")} />
              <p class="opis" id="opis-ustanova">Npr. vrtić, škola ili privatna praksa.</p>
              {greske.ustanova && <p class="greska" id="greska-ustanova">{greske.ustanova}</p>}
            </div>
            <div class="polje">
              <label for="grad">Grad</label>
              <input id="grad" name="grad" type="text" autocomplete="address-level2" required maxlength={MAX.grad} value={unos.grad}
                {...aria("grad")} />
              {greske.grad && <p class="greska" id="greska-grad">{greske.grad}</p>}
            </div>
          </div>

          <div class="polje">
            <label for="kupon">Kupon <span class="neobavezno">(nije obavezno)</span></label>
            <input id="kupon" name="kupon" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false"
              maxlength={KUPON_MAX} value={unos.kupon} {...aria("kupon", "opis-kupon")} />
            <p class="opis" id="opis-kupon">Ako ste dobili kod kupona, upišite ga. Kod koji ne vrijedi ne smeta: zahtjev tada obrađujemo
              kao i svaki drugi.</p>
            {greske.kupon && <p class="greska" id="greska-kupon">{greske.kupon}</p>}
          </div>

          <div class="polje">
            <label for="poruka">Kratka poruka <span class="neobavezno">(nije obavezno)</span></label>
            <textarea id="poruka" name="poruka" rows="4" maxlength={MAX.poruka} {...aria("poruka", "opis-poruka")}>{unos.poruka}</textarea>
            <p class="opis" id="opis-poruka">Npr. s kojom djecom radite ili što biste htjeli isprobati.</p>
            {greske.poruka && <p class="greska" id="greska-poruka">{greske.poruka}</p>}
          </div>

          <div class="hp" aria-hidden="true">
            <label for={HONEYPOT}>Web stranica (ostavite prazno)</label>
            <input id={HONEYPOT} name={HONEYPOT} type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="polje kvacica">
            <input id="privola" name="privola" type="checkbox" value="da" required checked={unos.privola} {...aria("privola")} />
            <label for="privola">Upoznat/a sam s tim kako LogoMedo koristi i čuva ove podatke
              (<a href="/privatnost#pristup">Privatnost</a>).</label>
            {greske.privola && <p class="greska" id="greska-privola">{greske.privola}</p>}
          </div>

          <button class="gumb" type="submit">{unos.paket === "beta" && unos.kupon ? "Pošalji i otvori pristup" : unos.paket === "beta" ? "Zatraži pristup" : unos.paket === "ustanova" ? "Zatraži ponudu" : "Pošalji narudžbu"}</button>
        </form>
      )}
    </div>
  </section>
</Okvir>
<style>
  .pristup { padding-top: 72px; }
  .raspored { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 56px; align-items: start; }
  .uvod { display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }
  .uvod .sitno a, .kartica a { color: var(--med-tamno); font-weight: 600; }
  .kartica { display: flex; flex-direction: column; gap: 18px; padding: 28px; border-radius: 22px; background: var(--povrsina);
    border: 1px solid var(--rub); box-shadow: var(--sjena-1); }
  .kartica p { margin: 0; }
  .naslov-kartice { margin: 0; font-family: var(--font-slova); font-weight: 600; font-size: 1.4rem; }
  .polje { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .dva { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 18px; }
  label { font-weight: 600; font-size: .95rem; color: var(--tinta); }
  .neobavezno { font-weight: 400; color: var(--blijedo); }
  input[type="text"], input[type="email"], select, textarea { width: 100%; box-sizing: border-box; min-height: 48px; padding: 11px 14px;
    font: inherit; font-size: 1rem; color: var(--tinta); background: var(--papir); border: 1px solid var(--rub-jak); border-radius: 12px; }
  textarea { min-height: 110px; resize: vertical; }
  input[type="text"]:focus, input[type="email"]:focus, select:focus, textarea:focus { border-color: var(--med); box-shadow: 0 0 0 3px var(--med-blago); }
  [aria-invalid="true"] { border-color: var(--greska) !important; }
  .opis { font-size: .85rem; color: var(--blijedo); }
  .greska { font-size: .88rem; font-weight: 600; color: var(--greska); }
  .greska-sazetak { padding: 12px 14px; border-radius: 12px; background: var(--greska-blago); color: var(--greska); font-weight: 600; }
  .kvacica { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; row-gap: 6px; align-items: start; }
  .kvacica input { width: 22px; height: 22px; margin: 2px 0 0; accent-color: var(--med); }
  .kvacica label { font-weight: 400; font-size: .95rem; color: var(--blijedo); line-height: 1.5; }
  .kvacica .greska { grid-column: 2; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .gumb { align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 28px;
    border: 0; border-radius: 999px; background: var(--med); color: var(--med-tekst); font: inherit; font-weight: 600; font-size: 1.02rem;
    box-shadow: var(--sjena-1); cursor: pointer; }
  .gumb:hover { filter: brightness(1.05); }
  @media (max-width: 879px) {
    .raspored { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
  @media (max-width: 559px) {
    .pristup { padding-top: 44px; }
    .kartica { padding: 20px 16px; border-radius: 18px; }
    .dva { grid-template-columns: minmax(0, 1fr); }
    .gumb { align-self: stretch; }
  }
</style>
