---
// /privatnost (sadrzaj.md 3.6): P-1…P-5, i od S6 politika privatnosti po GDPR-u (P-6…P-10, landing odluke 600–606).
// S7: P-11 zahtjev za pristup (obrazac /pristup), odmah iza P-4 (logopedi s računom).
// Inbox S2: dopisivanje e-poštom (odgovori na mailove iz aplikacije), iza zahtjeva za pristup.
// Prvo kratko i konkretno (što se gdje sprema), zatim voditelj obrade, osnove, obrađivači, kolačići, rokovi i prava.
import Okvir from "../landing/Okvir.astro";
import Uvod from "../landing/Uvod.astro";
import Stranice from "../landing/privatnost/Stranice.astro";
import Igra from "../landing/privatnost/Igra.astro";
import Logopedi from "../landing/privatnost/Logopedi.astro";
import Pristup from "../landing/privatnost/Pristup.astro";
import Dopisivanje from "../landing/privatnost/Dopisivanje.astro";
import Voditelj from "../landing/privatnost/Voditelj.astro";
import Osnove from "../landing/privatnost/Osnove.astro";
import Obradivaci from "../landing/privatnost/Obradivaci.astro";
import Kolacici from "../landing/privatnost/Kolacici.astro";
import Cuvanje from "../landing/privatnost/Cuvanje.astro";
import Prava from "../landing/privatnost/Prava.astro";
import { DATUM_OBJAVE } from "../landing/konstante";

export const prerender = true;
---
<Okvir putanja="/privatnost">
  <Uvod gumbi={["pristup"]} sitno={DATUM_OBJAVE ? `Stanje na dan ${DATUM_OBJAVE}` : undefined}>
    <Fragment slot="naslov">Privatnost</Fragment>
    Ukratko: ove stranice ne prikupljaju ništa, a o djetetu koje igra ne spremamo ništa. Ispod je točno što se gdje sprema.
  </Uvod>
  <Stranice />
  <Igra />
  <Logopedi />
  <Pristup />
  <Dopisivanje />
  <Voditelj />
  <Osnove />
  <Obradivaci />
  <Kolacici />
  <Cuvanje />
  <Prava />
</Okvir>
