{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logomedo",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // D.O.M. račun (kao omm.domovina.ai). logomedo.com je 31. 10. 2026. premješten s ITalka
  // (registracija i zona), pa vrijedi i Access tim domovina.cloudflareaccess.com.
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  // Samo vlastita domena: admin i API ne smiju biti i na *.workers.dev (drugi origin).
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logomedo",
      "database_id": "e67d3840-b2bc-4fde-8915-a0d0cddc61d4",
      "migrations_dir": "./migrations"
    }
  ],
  // Slike kataloga: <stil>/<slug riječi>/<id slike>.<ekstenzija>
  // SLIKE je privatan (kandidati, odbijene). JAVNO drži samo odobrene, isti ključ, a poslužuje ga
  // R2 custom domena cdn.logomedo.com (edge cache, bez Workera). Usklađuje ga odluci() u lib/generiranje.ts.
  "r2_buckets": [
    { "binding": "SLIKE", "bucket_name": "logomedo-slike" },
    { "binding": "JAVNO", "bucket_name": "logomedo-javno" }
  ],

  "vars": {
    // /admin (docs/admin.md): Cloudflare Access na /admin/sso ili passkey.
    // ADMIN_EMAILS se provjerava pri svakom zahtjevu; micanje iz popisa odmah gasi sesije.
    // Isti popis mora biti u Access politici „LogoMedo admini”. Deploy uvijek `npm run deploy`:
    // Astro kod builda kopira ovu datoteku u dist/server/wrangler.json, a sam `wrangler deploy` šalje staru.
    "ADMIN_EMAILS": "admin1@example.com,admin2@example.com,admin3@example.com",
    "ADMIN_HOST": "logomedo.com",
    // AUD Access aplikacije „LogoMedo admin (sso)” (politika „OMM admini”, OTP na e-mail),
    // koja štiti logomedo.com/admin/sso. Prazan AUD = /admin/sso vraća 503.
    "ACCESS_TEAM_DOMAIN": "domovina.cloudflareaccess.com",
    "ACCESS_AUD": "81d4dce3723d0cada52d1984319149f3a21a1e76d8f4affd04e1b7e0b4fe6e56",
    "CDN_URL": "https://cdn.logomedo.com",
    "ZONE_ID": "c12293517eb61e46975c4145f8e66a61"
  },
  // Secret RUNNER_TOKEN (wrangler secret put / .dev.vars): lokalni runner, /api/runner/*.
  // Secret CF_PURGE_TOKEN (opcionalan, Zone → Cache Purge za logomedo.com): čišćenje povučenih slika s cdn-a.

  // www se u middlewareu preusmjerava na apex. stage.logomedo.com ostaje stari Firebase stage.
  "routes": [
    { "pattern": "logomedo.com", "custom_domain": true },
    { "pattern": "www.logomedo.com", "custom_domain": true }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
