{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logomedo",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // D.O.M. račun (kao omm.domovina.ai). logomedo.com je 31. 10. 2026. premješten s ITalka
  // (registracija i zona), pa vrijedi i Access tim domovina.cloudflareaccess.com.
  "account_id": "7dc7167b7e2e00923bfa7cd697df14e4",
  // Samo vlastita domena: admin i API ne smiju biti i na *.workers.dev (drugi origin).
  // Vlastiti ulaz (Astro handler + Durable Object RunnerZvono); bez ovoga adapter koristi svoj.
  "main": "./src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logomedo",
      "database_id": "e67d3840-b2bc-4fde-8915-a0d0cddc61d4",
      "migrations_dir": "./migrations"
    }
  ],
  // Slike kataloga: <stil>/<slug riječi>/<id slike>.<ekstenzija>
  // SLIKE je privatan (kandidati, odbijene). JAVNO drži samo odobrene, isti ključ, a poslužuje ga
  // R2 custom domena cdn.logomedo.com (edge cache, bez Workera). Usklađuje ga odluci() u lib/generiranje.ts.
  "r2_buckets": [
    { "binding": "SLIKE", "bucket_name": "logomedo-slike" },
    { "binding": "JAVNO", "bucket_name": "logomedo-javno" }
  ],

  // Push za runner na Macu: WebSocket /api/runner/zvono (src/lib/runner-zvono.ts).
  // Red izgovora (docs/zvukovi.md): Worker sam zove ElevenLabs. Jedan posao = do 3 TTS + STT poziva.
  "queues": {
    "producers": [{ "binding": "ZVUKOVI_RED", "queue": "logomedo-zvukovi" }],
    "consumers": [{ "queue": "logomedo-zvukovi", "max_batch_size": 4, "max_batch_timeout": 2, "max_concurrency": 2, "max_retries": 6, "retry_delay": 60 }]
  },

  "durable_objects": { "bindings": [{ "name": "RUNNER_ZVONO", "class_name": "RunnerZvono" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerZvono"] }],

  "vars": {
    // /admin (docs/admin.md): Cloudflare Access na /admin/sso ili passkey.
    // ADMIN_EMAILS je secret (repo je javan, e-mailovi nisu u gitu; docs/admin.md). Provjerava se pri
    // svakom zahtjevu; micanje iz popisa odmah gasi sesije. Isti popis mora biti u Access politici
    // „LogoMedo admini”. Deploy uvijek `npm run deploy`: Astro kod builda kopira ovu datoteku u
    // dist/server/wrangler.json, a sam `wrangler deploy` šalje staru.
    "ADMIN_HOST": "logomedo.com",
    // AUD Access aplikacije „LogoMedo admin (sso)” (politika „OMM admini”, OTP na e-mail),
    // koja štiti logomedo.com/admin/sso. Prazan AUD = /admin/sso vraća 503.
    "ACCESS_TEAM_DOMAIN": "domovina.cloudflareaccess.com",
    "ACCESS_AUD": "81d4dce3723d0cada52d1984319149f3a21a1e76d8f4affd04e1b7e0b4fe6e56",
    "CDN_URL": "https://cdn.logomedo.com",
    "ZONE_ID": "c12293517eb61e46975c4145f8e66a61"
  },
  // Secret RUNNER_TOKEN (wrangler secret put / .dev.vars): lokalni runner, /api/runner/*.
  // Secret CF_PURGE_TOKEN (opcionalan, Zone → Cache Purge za logomedo.com): čišćenje povučenih slika s cdn-a.

  // www se u middlewareu preusmjerava na apex. stage.logomedo.com ostaje stari Firebase stage.
  "routes": [
    { "pattern": "logomedo.com", "custom_domain": true },
    { "pattern": "www.logomedo.com", "custom_domain": true }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // Staging (docs/staging.md, landing odluke 4–9): `npm run build:staging` / `deploy:staging`.
  // Bindingi se u okruženjima ne nasljeđuju, pa je sve navedeno; staging nikad ne binda
  // produkcijske resurse. OKRUZENJE=staging dodaje noindex (src/lib/staging.ts), i statičkim
  // datotekama (assets.run_worker_first). ACCESS_AUD prazan: /admin/sso vraća 503.
  "env": {
    "staging": {
      "name": "logomedo-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.logomedo.com", "custom_domain": true }],
      "assets": { "run_worker_first": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "logomedo-staging",
          "database_id": "7d5c46bf-2af6-43b4-8c71-46cea0b5cf53",
          "migrations_dir": "./migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "SLIKE", "bucket_name": "logomedo-staging-slike" },
        { "binding": "JAVNO", "bucket_name": "logomedo-staging-javno" }
      ],
      "queues": {
        "producers": [{ "binding": "ZVUKOVI_RED", "queue": "logomedo-staging-zvukovi" }],
        "consumers": [{ "queue": "logomedo-staging-zvukovi", "max_batch_size": 4, "max_batch_timeout": 2, "max_concurrency": 2, "max_retries": 6, "retry_delay": 60 }]
      },
      "durable_objects": { "bindings": [{ "name": "RUNNER_ZVONO", "class_name": "RunnerZvono" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunnerZvono"] }],
      "vars": {
        "ADMIN_HOST": "staging.logomedo.com",
        "ACCESS_TEAM_DOMAIN": "domovina.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "CDN_URL": "https://cdn.logomedo.com",
        "ZONE_ID": "c12293517eb61e46975c4145f8e66a61",
        "OKRUZENJE": "staging",
        // Limit istovremenih uređaja i za superadmina, za testiranje (docs/uredaji.md). Produkcija: bez vara = samo bilježi.
        "UREDAJI_PROVEDBA": "svi"
      },
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
    }
  }
}
