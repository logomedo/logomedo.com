{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logomedo",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // ITalk račun, na kojem je i zona logomedo.com.
  "account_id": "ea7d40d3073ef5286f4903d33eb0bf7e",
  // Samo vlastita domena: admin i API ne smiju biti i na *.workers.dev (drugi origin).
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logomedo",
      // TODO: `wrangler d1 create logomedo` pa upisati pravi ID. Lokalno radi i ovako.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // Slike kataloga: <stil>/<slug riječi>/<id slike>.<ekstenzija>
  "r2_buckets": [{ "binding": "SLIKE", "bucket_name": "logomedo-slike" }],

  "vars": {
    // /admin (docs/admin.md): Cloudflare Access na /admin/sso ili passkey.
    // ADMIN_EMAILS se provjerava pri svakom zahtjevu; micanje iz popisa odmah gasi sesije.
    "ADMIN_EMAILS": "admin1@example.com,admin2@example.com",
    "ADMIN_HOST": "logomedo.com",
    // TODO: Zero Trust organizacija na ITalk računu i Access aplikacija za logomedo.com/admin/sso.
    // Dok je ACCESS_AUD prazan, /admin/sso vraća 503 (prijava samo passkeyem).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // Secret RUNNER_TOKEN (wrangler secret put / .dev.vars): lokalni runner, /api/runner/*.

  "routes": [{ "pattern": "logomedo.com", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
